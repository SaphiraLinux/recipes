#!/sbin/openrc-run

description="A.L.F.R.E.D. mesh information distribution daemon"

command="/usr/sbin/alfred"
# Default: serve unix-socket clients, no mesh interface attached. Set
# ALFRED_IFACE (e.g. bat0) in /etc/conf.d/alfred to distribute data
# over the mesh via IPv6 link-local multicast.
: ${ALFRED_IFACE:=none}
command_args="-i $ALFRED_IFACE -u /var/run/alfred/alfred.sock"
command_user="alfred:alfred"
supervisor="supervise-daemon"

depend()
{
	use net logger
	after firewall
}

start_pre()
{
	checkpath -d -m 0755 -o alfred:alfred /var/run/alfred
	# Stale socket from an unclean shutdown blocks bind; start_pre
	# runs only when OpenRC is about to start the daemon.
	rm -f /var/run/alfred/alfred.sock
}
