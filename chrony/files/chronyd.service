[Unit]
Description=NTP client/server
After=network.target
Conflicts=systemd-timesyncd.service

[Service]
Type=simple
# 0700 root:root: chrony disables its command socket on world access
# (chrony.conf(5)), and this service runs as root (-u root).
ExecStartPre=/bin/install -d -m 0700 -o root -g root /var/run/chrony
ExecStart=/usr/sbin/chronyd -n -u root $OPTIONS
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
