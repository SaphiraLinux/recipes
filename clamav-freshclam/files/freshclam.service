[Unit]
Description=ClamAV virus signature updater (freshclam)
After=network.target

[Service]
Type=forking
User=clamav
Group=clamav
PIDFile=/var/run/clamav/freshclam.pid
ExecStartPre=/bin/rm -f /var/run/clamav/freshclam.pid
ExecStart=/usr/bin/freshclam --daemon --pid=/var/run/clamav/freshclam.pid
Restart=on-failure

[Install]
WantedBy=multi-user.target
