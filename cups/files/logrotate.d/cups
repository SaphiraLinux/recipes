# cupsd holds its log files open. Upstream ships no rotation
# fragment and a HUP-triggered log reopen is unverified, so rotate
# by copy rather than signalling a print daemon on a guess.
# Cupsd recreates what it needs; missing logs must never fail rotation.
/var/log/cups/*_log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
}
