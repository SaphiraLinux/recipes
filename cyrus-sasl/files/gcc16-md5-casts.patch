Saphira musl/gcc16 port: explicit pointer casts for MD5_memset calls
in saslauthd/md5.c.

Adapted from Alpine aports main/cyrus-sasl/gcc15.patch (itself from
upstream PR cyrusimap/cyrus-sasl#873, mark.yang + Rob Crittenden):
gcc 15/16 promote -Wincompatible-pointer-types to errors, and passing
`&array` (pointer-to-array) or a struct pointer where POINTER
(unsigned char *) is expected no longer compiles. The Alpine patch did
not apply to the 2.1.28 release tarball (made against git master), so
the five call sites are fixed here against actual 2.1.28 context.

Companion change (not a patch): CPPFLAGS -DPROTOTYPES=1 in recipe.sh.
md5global.h documents PROTOTYPES as settable "with C compiler flags";
without it PROTO_LIST expands empty and lib/md5.c fails with arity
errors under gcc 16. This avoids running autoreconf for the one-line
configure.ac change in the Alpine patch (no autotools drift).

--- a/saslauthd/md5.c
+++ b/saslauthd/md5.c
@@ -397,9 +397,9 @@
   _saslauthd_MD5Update(&hmac->octx, k_opad, 64);     /* apply outer pad */
 
   /* scrub the pads and key context (if used) */
-  MD5_memset(&k_ipad, 0, sizeof(k_ipad));
-  MD5_memset(&k_opad, 0, sizeof(k_opad));
-  MD5_memset(&tk, 0, sizeof(tk));
+  MD5_memset(k_ipad, 0, sizeof(k_ipad));
+  MD5_memset(k_opad, 0, sizeof(k_opad));
+  MD5_memset(tk, 0, sizeof(tk));
 
   /* and we're done. */
 }
@@ -424,7 +424,7 @@
     state->istate[lupe] = htonl(hmac.ictx.state[lupe]);
     state->ostate[lupe] = htonl(hmac.octx.state[lupe]);
   }
-  MD5_memset(&hmac, 0, sizeof(hmac));
+  MD5_memset((POINTER)&hmac, 0, sizeof(hmac));
 }
 
 
@@ -432,7 +432,7 @@
 				HMAC_MD5_STATE *state)
 {
   unsigned lupe;
-  MD5_memset(hmac, 0, sizeof(HMAC_MD5_CTX));
+  MD5_memset((POINTER)hmac, 0, sizeof(HMAC_MD5_CTX));
   for (lupe = 0; lupe < 4; lupe++) {
     hmac->ictx.state[lupe] = ntohl(state->istate[lupe]);
     hmac->octx.state[lupe] = ntohl(state->ostate[lupe]);
