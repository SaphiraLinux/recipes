#!/sbin/openrc-run

description="D-Bus system message bus daemon"

# Foreground bus daemon under supervise-daemon (--nofork/--nopidfile);
# the equivalent systemd unit ships in the same package.  Neither init
# wraps the other; nothing is auto-enabled at install.
command="/usr/bin/dbus-daemon"
command_args="--system --nofork --nopidfile"
supervisor="supervise-daemon"

depend()
{
	need localmount
	after bootmisc
}

start_pre()
{
	# /var/run is persistent by design: the runtime dir is created
	# here, and a stale socket from an unclean shutdown must be
	# cleared or bind fails. start_pre runs only when OpenRC is
	# about to start the daemon, so no tracked-live bus loses its
	# socket here. (Under systemd the socket unit owns this: PID 1
	# binds -- and reclaims -- the socket file itself.)
	checkpath -d -m 0755 /var/run/dbus
	rm -f /var/run/dbus/system_bus_socket
}
