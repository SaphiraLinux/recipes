#!/sbin/openrc-run

description="FRRouting BGP daemon"

# Every FRR protocol daemon talks to zebra over the zserv API socket in
# /var/run/frr, so zebra must be up first.
command="/usr/sbin/bgpd"
command_args="-d -f /etc/frr/bgpd.conf -i /var/run/frr/bgpd.pid -z /var/run/frr/zserv.api"
supervisor="supervise-daemon"
pidfile="/var/run/frr/bgpd.pid"

depend()
{
	need localmount
	use net
	need zebra
	after firewall
}
