#!/sbin/openrc-run
# OpenRC init for glustereventsd (Saphira)

description="GlusterFS events daemon"
command="/usr/sbin/glustereventsd"
command_args="${GLUSTEREVENTSD_ARGS:---pid-file /var/run/glustereventsd.pid}"
pidfile="/var/run/glustereventsd.pid"
command_background="yes"

depend() {
	need glusterd
	after bootmisc
}
