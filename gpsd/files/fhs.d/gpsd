# gpsd FHS migration: control socket /run/gpsd.sock -> /var/run/gpsd/gpsd.sock.
#
# The socket path is compiled as RUNDIR + "/gpsd.sock" (gpsd.h), so
# scons rundir=/var/run/gpsd moves it (per the census veto: gpsd is
# a normal service, not base runtime; flat socket paths need a
# concrete reason, and none exists). Both init definitions use the same
# path: the OpenRC start_pre and the systemd ExecStartPre converge the
# dir and clear a stale socket there.
#
# Stale-state policy (/var/run is persistent by design, never wiped):
# the stale socket is cleared at (re)start; the daemon recreates it on
# start for gpsdctl/hotplug clients. The old flat /run/gpsd.sock was a
# tmpfs orphan needing no migration (reboot-cleared, unread post-move).

dir /var/run/gpsd 0755 gpsd gpsd
