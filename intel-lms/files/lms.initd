#!/sbin/openrc-run
# Intel Local Manageability Service: local AMT access over MEI.
# Never enabled by default (dual-init policy); start deliberately on
# AMT-provisioned hosts with /dev/mei* present.

description="Intel Local Manageability Service"

command="/usr/bin/lms"
command_args=""

supervisor="supervise-daemon"

depend()
{
	need localmount
	use net logger dns dbus
	after dbus
}
