--- a/UNS/PortForwardingService/AdapterListInfoLinux.cpp
+++ b/UNS/PortForwardingService/AdapterListInfoLinux.cpp
@@ -165,7 +165,16 @@
 	std::vector<std::string> domains;
 	std::vector<std::string>::const_iterator domain;
 	struct __res_state dns_state;
+#ifdef __GLIBC__
 	res_ninit(&dns_state);
+#else
+	/* musl provides no reentrant res_ninit(); snapshot the global
+	 * resolver state instead. This call site only reads dnsrch, so
+	 * sharing the backing strings is safe. */
+	memset(&dns_state, 0, sizeof(dns_state));
+	res_init();
+	dns_state = _res;
+#endif
 	for (int i = 0; i < MAXDNSRCH && dns_state.dnsrch[i]; i++)
 		domains.push_back(dns_state.dnsrch[i]);
 	domain = domains.cbegin();
