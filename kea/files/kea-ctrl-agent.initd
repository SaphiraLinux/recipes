#!/sbin/openrc-run

description="Kea Control Agent (REST API)"

command="/usr/sbin/kea-ctrl-agent"
command_args="-c /etc/kea/kea-ctrl-agent.conf"
command_background="yes"
pidfile="/var/run/kea/kea-ctrl-agent.pid"

depend()
{
	use net logger dns
}

start_pre()
{
	checkpath -d -m 0755 /var/run/kea
	# Stale pid from an unclean shutdown blocks restart; start_pre
	# runs only when OpenRC is about to start the daemon.
	rm -f /var/run/kea/kea-ctrl-agent.pid
}
