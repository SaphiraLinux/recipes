#!/sbin/openrc-run

description="Kea DHCPv6 server"

command="/usr/sbin/kea-dhcp6"
command_args="-c /etc/kea/kea-dhcp6.conf"
command_background="yes"
pidfile="/var/run/kea/kea-dhcp6.pid"

depend()
{
	use net logger dns
}

start_pre()
{
	checkpath -d -m 0755 /var/run/kea
	# Stale pid from an unclean shutdown blocks restart; start_pre
	# runs only when OpenRC is about to start the daemon.
	rm -f /var/run/kea/kea-dhcp6.pid
}
