musl libc compatibility (Saphira port).

- nvc.c: gnu/lib-names.h is glibc-only; guard it and define LD_SO as the
  musl loader (marker string only, no logic change; x86-64 generation).
- nvc_info.c: libgen.h for basename (mutable buffers only here).
- utils.c, nvc_mount.c: basename() sites taking string literals
  (__FILE__, "params"/"version"/"registry") use the strrchr idiom:
  POSIX basename may modify its argument. Safe under GNU too.
- nvc.c, nvc_info.c, nvc_ldcache.c: secure_getenv shim (never setuid).
- rpc.h: include <signal.h> for struct sigaction/SIG_IGN/sigaction()
  used by call_rpc (arrived transitively on glibc).

diff -Naur a/src/nvc.c b/src/nvc.c
--- a/src/nvc.c	2026-07-21 00:31:40.000000000 +0000
+++ b/src/nvc.c	2026-10-21 04:07:10.814125371 +0000
@@ -2,7 +2,12 @@
  * Copyright (c) 2017-2018, NVIDIA CORPORATION. All rights reserved.
  */
 
+#ifdef __GLIBC__
 #include <gnu/lib-names.h>
+#else
+/* musl libc has no gnu/lib-names.h; LD_SO feeds only the .interp marker. */
+#define LD_SO "ld-musl-x86_64.so.1"
+#endif
 
 #include <sys/types.h>
 #include <sys/wait.h>
@@ -18,6 +23,11 @@
 #include <pci-enum.h>
 #include <nvidia-modprobe-utils.h>
 
+#ifndef __GLIBC__
+/* musl omits secure_getenv; equivalent here (never setuid). */
+#define secure_getenv getenv
+#endif
+
 #include "nvc_internal.h"
 
 #include "common.h"
