[Unit]
Description=libvirt virtualization network filter driver (virtnwfilterd)
Documentation=man:virtnwfilterd(8)
After=network-online.target nftables.service
Wants=network-online.target
# Umbrella membership: stop/restart of libvirtd.service propagates here.
PartOf=libvirtd.service
# virtlogd and virtlockd hold state consumers depend on: when the stack
# starts together they must be available first.
After=virtlogd.service virtlockd.service

[Service]
# Saphira is not usrmerged: daemons spawn helpers from /sbin and
# /bin (tc, ip, ...), which this systemd build omits from the
# default PATH. Set it explicitly (packaged paths, never aliases).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Mirrors files/virtnwfilterd.initd.
#
# Type=notify: libvirt's modular daemons are sd_notify-native, so this is
# the knowable-correct answer and systemd tracks the real readiness point
# rather than guessing from process start.
#
# Deliberately NOT set: User=. This package configures
# -Dqemu_user=root -Dqemu_group=root.
Type=notify
NotifyAccess=main
ExecStartPre=+/bin/install -d -o root -g root -m 0755 /var/run/libvirt
ExecStart=/usr/sbin/virtnwfilterd
# /var/run/libvirt holds one socket per driver plus the sandbox and qemu
# directories (Saphira: ordinary-daemon sockets live under /var/run, and
# /var/run is a real directory, never a /run alias).
# Deliberately NOT set: RuntimeDirectory= (systemd always creates that
# under /run, the wrong tree here) -- ExecStartPre above owns the
# /var/run/libvirt directory instead.
Restart=on-failure
	RestartSec=5

# Deliberately NOT set: NoNewPrivileges (QEMU cgroup delegation),
# ProtectSystem=strict (virtqemud mounts images), or ProtectHome
# (read-only, and the storage pool can be anywhere the operator chooses).
#
# This build configures -Dpolkit=disabled with -Dselinux=enabled
# and -Dapparmor=enabled: both security drivers compile in, and each
# self-disables where its kernel support is absent (SELinux is built
# into Saphira kernels; AppArmor is not compiled in). No enforcement
# is claimed without runtime policy and testing. That is a separate
# concern from dual-init and is recorded in daemon-inventory.map rather
# than silently hardened here.
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/run/libvirt /var/lib/libvirt
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
