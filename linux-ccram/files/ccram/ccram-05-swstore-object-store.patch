 include/linux/ccram_store.h |  62 +++
 mm/Makefile                 |   1 +
 mm/ccram_store.c            | 976 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1039 insertions(+)
 create mode 100644 include/linux/ccram_store.h
 create mode 100644 mm/ccram_store.c

diff --git a/include/linux/ccram_store.h b/include/linux/ccram_store.h
new file mode 100644
index 000000000..ede00e28a
--- /dev/null
+++ b/include/linux/ccram_store.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* CCRAM — AKADATA LIMITED adaptation of Meta CRAM (Saphira-original
+ * integration; Meta's CRAM mechanism used as-is).  Licence: GPL-2.0-only.
+ *
+ * Software-compressed object store (Phase 2A): 4096-byte pages go in,
+ * variable-sized LZ4 objects come out, packed into 512-byte backing
+ * units.  See mm/ccram_store.c for the reuse audit, the recursion and
+ * locking discipline, and the exact-once release protocol.
+ */
+#ifndef _LINUX_CCRAM_STORE_H
+#define _LINUX_CCRAM_STORE_H
+
+#include <linux/types.h>
+
+/* compress= modes for ccram.compress (default off). */
+#define CCRAM_COMPRESS_OFF	0
+#define CCRAM_COMPRESS_LZ4	1
+
+/* Object flags. */
+#define CCRAM_OBJ_RAW		0x00000001U	/* stored uncompressed */
+#define CCRAM_OBJ_ALGO_LZ4	0x00000100U	/* LZ4 content (only algo now) */
+
+struct ccram_store;
+struct ccram_obj;
+struct page;
+
+struct ccram_store_stats {
+	__u64 phys_bytes;	/* chunk pages held x 4096 */
+	__u64 logical_bytes;	/* live objects x 4096 */
+	__u64 stored_bytes;	/* sum of len_stored */
+	__u64 waste_bytes;	/* sum of (nunits*512 - len_stored) */
+	__u64 nobjs;
+	__u64 nchunks;
+	__u64 ncomp;
+	__u64 nraw;
+	__u64 ncompress_ops;
+	__u64 ndecompress_ops;
+	__u64 nfail;
+};
+
+#ifdef CONFIG_CCRAM_SYSRAM
+struct ccram_store *ccram_store_create(int nid);
+int ccram_store_destroy(struct ccram_store *s);
+int ccram_store_page(struct ccram_store *s, struct page *src, gfp_t gfp,
+		     u32 *id_out);
+int ccram_store_load(struct ccram_store *s, u32 id, struct page *dst);
+int ccram_store_free(struct ccram_store *s, u32 id);
+struct ccram_obj *ccram_obj_get(struct ccram_store *s, u32 id);
+void ccram_obj_put(struct ccram_store *s, struct ccram_obj *o);
+void ccram_store_stats(struct ccram_store *s, struct ccram_store_stats *out);
+int ccram_store_selftest(int nid);
+int ccram_compress_mode_now(void);
+struct ccram_store *ccram_live_store_now(void);
+#else
+static inline struct ccram_store *ccram_store_create(int nid) { return NULL; }
+static inline int ccram_store_destroy(struct ccram_store *s) { return 0; }
+static inline int ccram_store_selftest(int nid) { return 0; }
+static inline int ccram_compress_mode_now(void) { return CCRAM_COMPRESS_OFF; }
+static inline struct ccram_store *ccram_live_store_now(void) { return NULL; }
+#endif
+
+#endif /* _LINUX_CCRAM_STORE_H */
