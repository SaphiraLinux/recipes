 include/linux/leafops.h     |  18 ++++
 include/linux/swapops.h     |  10 +-
 mm/Makefile                 |   1 +
 mm/ccram_residency.c        | 201 ++++++++++++++++++++++++++++++++++++
 mm/ccram_store.c            |  24 +++++
 mm/memory.c                 |  24 +++++
 7 files changed, 364 insertions(+), 1 deletion(-)
 create mode 100644 mm/ccram_residency.c

diff --git a/include/linux/ccram_store.h b/include/linux/ccram_store.h
index ede00e28a..7fc5ab40d 100644
--- a/include/linux/ccram_store.h
+++ b/include/linux/ccram_store.h
@@ -11,6 +11,12 @@
 #define _LINUX_CCRAM_STORE_H
 
 #include <linux/types.h>
+#include <linux/bits.h>
+#include <linux/list.h>
+#include <linux/mm_types.h>
+#include <linux/swap.h>
+#include <linux/swapops.h>
+#include <linux/leafops.h>
 
 /* compress= modes for ccram.compress (default off). */
 #define CCRAM_COMPRESS_OFF	0
@@ -20,9 +26,27 @@
 #define CCRAM_OBJ_RAW		0x00000001U	/* stored uncompressed */
 #define CCRAM_OBJ_ALGO_LZ4	0x00000100U	/* LZ4 content (only algo now) */
 
+/*
+ * Non-present marker encoding (Phase 2B residency).  The offset payload
+ * of a SWP_PTE_MARKER entry carries:
+ *   bit 3:		PTE_MARKER_CCRAM (see swapops.h)
+ *   bit 4:		original PTE was young
+ *   bit 5:		original PTE was dirty
+ *   bits 6..37:	u32 object id (ids from 1; 0 invalid)
+ * x86-64 carries 58 offset bits; ids stay far below bit 60+, so no
+ * arch page-flag bit (e.g. uffd-wp) can ever alias.  store_page()
+ * WARNs and refuses rather than encode an oversized id.
+ */
+#define CCRAM_MARKER_ID_SHIFT	6U
+#define CCRAM_MARKER_YOUNG	BIT(4)
+#define CCRAM_MARKER_DIRTY	BIT(5)
+#define CCRAM_MARKER_ID_MAX	((1U << 26))
+
 struct ccram_store;
 struct ccram_obj;
 struct page;
+struct vm_fault;
+struct mm_struct;
 
 struct ccram_store_stats {
 	__u64 phys_bytes;	/* chunk pages held x 4096 */
@@ -36,8 +60,45 @@ struct ccram_store_stats {
 	__u64 ncompress_ops;
 	__u64 ndecompress_ops;
 	__u64 nfail;
+	__u64 ndemote;		/* residency: objects admitted by demote */
+	__u64 npromote;		/* residency: objects materialized by fault */
 };
 
+/* Marker construction and inspection.  Unconditional: harmless without
+ * CONFIG_CCRAM_SYSRAM since such PTEs can never exist then. */
+static inline swp_entry_t ccram_marker_entry(u32 id, bool young, bool dirty)
+{
+	unsigned long v = PTE_MARKER_CCRAM | ((unsigned long)id << CCRAM_MARKER_ID_SHIFT);
+
+	if (young)
+		v |= CCRAM_MARKER_YOUNG;
+	if (dirty)
+		v |= CCRAM_MARKER_DIRTY;
+	return swp_entry(SWP_PTE_MARKER, v);
+}
+
+static inline bool ccram_marker_test_pte(pte_t pte)
+{
+	softleaf_t e = softleaf_from_pte(pte);
+
+	return softleaf_is_ccram_marker(e);
+}
+
+static inline u32 ccram_marker_id_pte(pte_t pte)
+{
+	return (u32)(swp_offset(softleaf_from_pte(pte)) >> CCRAM_MARKER_ID_SHIFT);
+}
+
+static inline bool ccram_marker_young_pte(pte_t pte)
+{
+	return swp_offset(softleaf_from_pte(pte)) & CCRAM_MARKER_YOUNG;
+}
+
+static inline bool ccram_marker_dirty_pte(pte_t pte)
+{
+	return swp_offset(softleaf_from_pte(pte)) & CCRAM_MARKER_DIRTY;
+}
+
 #ifdef CONFIG_CCRAM_SYSRAM
 struct ccram_store *ccram_store_create(int nid);
 int ccram_store_destroy(struct ccram_store *s);
@@ -47,16 +108,42 @@ int ccram_store_load(struct ccram_store *s, u32 id, struct page *dst);
 int ccram_store_free(struct ccram_store *s, u32 id);
 struct ccram_obj *ccram_obj_get(struct ccram_store *s, u32 id);
 void ccram_obj_put(struct ccram_store *s, struct ccram_obj *o);
+void ccram_obj_ref(struct ccram_obj *o);
 void ccram_store_stats(struct ccram_store *s, struct ccram_store_stats *out);
+void ccram_store_note_demote(struct ccram_store *s);
+void ccram_store_note_promote(struct ccram_store *s);
 int ccram_store_selftest(int nid);
 int ccram_compress_mode_now(void);
 struct ccram_store *ccram_live_store_now(void);
+/* Residency (Phase 2B): fault a marker back into a private page. */
+vm_fault_t ccram_marker_fault(struct vm_fault *vmf);
+/* Residency: drop one marker reference (zap path). */
+void ccram_marker_zap(softleaf_t entry);
+/* Residency: fork-copy a marker (preserve + bump ref). True if handled. */
+bool ccram_marker_fork(pte_t orig_pte, struct mm_struct *dst_mm,
+		       unsigned long addr, pte_t *dst_pte);
+/* Residency: demote caller selection (anon order-0 mapped non-KSM). */
+unsigned int ccram_demote_store(struct list_head *list);
 #else
 static inline struct ccram_store *ccram_store_create(int nid) { return NULL; }
 static inline int ccram_store_destroy(struct ccram_store *s) { return 0; }
 static inline int ccram_store_selftest(int nid) { return 0; }
 static inline int ccram_compress_mode_now(void) { return CCRAM_COMPRESS_OFF; }
 static inline struct ccram_store *ccram_live_store_now(void) { return NULL; }
+static inline vm_fault_t ccram_marker_fault(struct vm_fault *vmf)
+{
+	return VM_FAULT_SIGBUS;
+}
+static inline void ccram_marker_zap(pte_t pte) { }
+static inline bool ccram_marker_fork(pte_t orig_pte, struct mm_struct *dst_mm,
+				     unsigned long addr, pte_t *dst_pte)
+{
+	return false;
+}
+static inline unsigned int ccram_demote_store(struct list_head *list)
+{
+	return 0;
+}
 #endif
 
 #endif /* _LINUX_CCRAM_STORE_H */
diff --git a/include/linux/leafops.h b/include/linux/leafops.h
index 992cd8bd8..ef5387bea 100644
--- a/include/linux/leafops.h
+++ b/include/linux/leafops.h
@@ -444,6 +444,24 @@ static inline bool softleaf_is_guard_marker(softleaf_t entry)
 	return softleaf_to_marker(entry) & PTE_MARKER_GUARD;
 }
 
+/**
+ * softleaf_is_ccram_marker() - Is this leaf entry a CCRAM object marker?
+ * @entry: Leaf entry.
+ *
+ * CCRAM-specific (AKADATA Phase 2B): upper offset bits carry the object
+ * id and are intentionally NOT part of this test, mirroring the other
+ * marker predicates.
+ *
+ * Returns: true if the leaf entry carries the CCRAM marker bit.
+ */
+static inline bool softleaf_is_ccram_marker(softleaf_t entry)
+{
+	if (!softleaf_is_marker(entry))
+		return false;
+
+	return softleaf_to_marker(entry) & PTE_MARKER_CCRAM;
+}
+
 /**
  * softleaf_is_uffd_wp_marker() - Is this leaf entry a userfautlfd write protect
  * marker?
diff --git a/include/linux/swapops.h b/include/linux/swapops.h
index 8cfc966ea..854a9e6db 100644
--- a/include/linux/swapops.h
+++ b/include/linux/swapops.h
@@ -297,7 +297,15 @@ typedef unsigned long pte_marker;
  * PROT_NONE, rather than if they were a memory hole or equivalent.
  */
 #define  PTE_MARKER_GUARD			BIT(2)
-#define  PTE_MARKER_MASK			(BIT(3) - 1)
+/*
+ * CCRAM compressed-object marker (AKADATA CCRAM Phase 2B): a non-present
+ * PTE identifying a software-compressed page held in the CCRAM object
+ * store.  Upper offset bits carry the u32 object id; see
+ * include/linux/ccram_store.h.  Like the other markers this is an
+ * explicitly allocated bit, not a reused encoding.
+ */
+#define  PTE_MARKER_CCRAM			BIT(3)
+#define  PTE_MARKER_MASK			(BIT(4) - 1)
 
 static inline swp_entry_t make_pte_marker_entry(pte_marker marker)
 {
