From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Saphira forward-port <builder@saphira.vm2.uk>
Date: Thu, 9 Oct 2026 12:00:00 +0000
Subject: [FWD 7.2.9] mm: define alloc selection flags before use

Follow-up to fwd-018, required to build: ALLOC_DEFAULT and
ALLOC_ZONELIST_PRIVATE were placed next to the other ALLOC_* macros
(~line 1610) but select_zonelist() and struct alloc_context consume
them ~800 lines earlier, breaking every TU that includes mm/internal.h
(observed: mm/filemap.c, kernel/fork.c failing the 7.2.9-r1 build).
This moves both defines directly above struct alloc_context. No
semantic change.

Verifies with git apply --check (no fuzz).

Signed-off-by: Saphira builder <builder@saphira.vm2.uk>
---
diff --git a/mm/internal.h b/mm/internal.h
index 0555f1ea4..87130b642 100644
--- a/mm/internal.h
+++ b/mm/internal.h
@@ -756,6 +756,12 @@ void page_alloc_sysctl_init(void);
  * in __alloc_pages_slowpath(). All other functions pass the whole structure
  * by a const pointer.
  */
+#define ALLOC_DEFAULT		0x0 /* no explicit selection: historical gfp-based path */
+/* Select the N_MEMORY_PRIVATE zonelist family (see select_zonelist()).
+ * 0x1000 is left free for upstream's code-tagging flag to ease rebases.
+ * Defined here (not next to the other ALLOC_* below) because
+ * select_zonelist() and struct alloc_context use it above. */
+#define ALLOC_ZONELIST_PRIVATE	0x2000
 struct alloc_context {
 	struct zonelist *zonelist;
 	const nodemask_t *nodemask;
@@ -1610,10 +1616,6 @@ unsigned int reclaim_clean_pages_from_list(struct zone *zone,
 #define ALLOC_HIGHATOMIC	0x200 /* Allows access to MIGRATE_HIGHATOMIC */
 #define ALLOC_TRYLOCK		0x400 /* Only use spin_trylock in allocation path */
 #define ALLOC_KSWAPD		0x800 /* allow waking of kswapd, __GFP_KSWAPD_RECLAIM set */
-#define ALLOC_DEFAULT		0x0 /* no explicit selection: historical gfp-based path */
-/* Select the N_MEMORY_PRIVATE zonelist family (see select_zonelist()).
- * 0x1000 is left free for upstream's code-tagging flag to ease rebases. */
-#define ALLOC_ZONELIST_PRIVATE	0x2000
 
 /* Flags that allow allocations below the min watermark. */
 #define ALLOC_RESERVES (ALLOC_NON_BLOCK|ALLOC_MIN_RESERVE|ALLOC_HIGHATOMIC|ALLOC_OOM)
