From 34a94f6797cff541e977dceeeed84f83a179f14e Mon Sep 17 00:00:00 2001
From: Gregory Price <gourry@gourry.net>
Date: Mon, 22 Jun 2026 18:10:02 -0700
Subject: [PATCH] selftests/dax: add dax/adistance tests

Add private_node_adistance.sh, covering the "adistance" sysfs knob:
  - read/write while unplugged
  - rejection of invalid values
  - "private" toggling reset-to-default
  - -EBUSY refusal while the device holds memory.

Add tiering test:
  - placing a second private node above DRAM (adistance),
    exercise demotion to DRAM from a private node w/ CAP_KERNEL_NUMA

Signed-off-by: Gregory Price <gourry@gourry.net>
---
 tools/testing/selftests/dax/Makefile          |   1 +
 .../selftests/dax/private_node_adistance.sh   |  85 +++++++++++++++
 .../selftests/dax/private_node_demotion.sh    | 101 +++++++++++++-----
 3 files changed, 161 insertions(+), 26 deletions(-)
 create mode 100755 tools/testing/selftests/dax/private_node_adistance.sh

diff --git a/tools/testing/selftests/dax/Makefile b/tools/testing/selftests/dax/Makefile
index 546d608343f..527c4ed93c1 100644
--- a/tools/testing/selftests/dax/Makefile
+++ b/tools/testing/selftests/dax/Makefile
@@ -24,5 +24,6 @@ TEST_PROGS += private_node_hotplug_transitions.sh
 TEST_PROGS += private_node_observability.sh
 TEST_PROGS += private_node_thp.sh
 TEST_PROGS += private_node_pagetables.sh
+TEST_PROGS += private_node_adistance.sh
 
 include ../lib.mk
diff --git a/tools/testing/selftests/dax/private_node_adistance.sh b/tools/testing/selftests/dax/private_node_adistance.sh
new file mode 100755
index 00000000000..50e5e82a06a
--- /dev/null
+++ b/tools/testing/selftests/dax/private_node_adistance.sh
@@ -0,0 +1,85 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+#
+# dax/kmem "adistance" knob: retune a private node's abstract distance
+# (memory-tier placement) while the device is unplugged.  The attribute is
+# exposed only in private mode, alongside the per-service opt-ins.
+#
+#   1. adistance is visible only while private=1
+#   2. read/write adistance while unplugged
+#   3. invalid values (<= 0, non-numeric) are rejected
+#   4. toggling "private" resets adistance to the probe-time default
+#   5. adistance is read-only (-EBUSY) while the device holds memory
+
+# shellcheck disable=SC1091
+DIR="$(dirname "$(readlink -f "$0")")"
+. "$DIR"/../kselftest/ktap_helpers.sh
+. "$DIR"/private_node_common.sh
+
+pn_begin
+pn_provision			# leaves the device in private mode
+echo unplugged > "$D/state" 2>/dev/null
+
+[ -e "$D/adistance" ] || { ktap_skip_all "no adistance attr (private mode)"; exit "$KSFT_SKIP"; }
+ktap_set_plan 5
+
+DEF=$(cat "$D/adistance")
+CUSTOM=$((DEF + 100))		# a distinct, valid (>0) distance
+
+# 1. visible only while private=1 ----------------------------------------------
+echo 0 > "$D/private" 2>/dev/null
+gone=$([ -e "$D/adistance" ] && echo no || echo yes)
+echo 1 > "$D/private" 2>/dev/null
+back=$([ -e "$D/adistance" ] && echo yes || echo no)
+if [ "$gone" = yes ] && [ "$back" = yes ]; then
+	ktap_test_pass "adistance present only in private mode (private=0 hides it)"
+else
+	ktap_test_fail "adistance visibility wrong (hidden@priv0=$gone shown@priv1=$back)"
+fi
+
+# 2. read/write while unplugged ------------------------------------------------
+echo "$CUSTOM" > "$D/adistance" 2>/dev/null
+got=$(cat "$D/adistance")
+if [ "$got" = "$CUSTOM" ]; then
+	ktap_test_pass "adistance write/read while unplugged (def=$DEF set=$CUSTOM)"
+else
+	ktap_test_fail "adistance readback $got != $CUSTOM (def=$DEF)"
+fi
+
+# 3. invalid values rejected ---------------------------------------------------
+bad=0
+echo 0    > "$D/adistance" 2>/dev/null && bad=1
+echo -5   > "$D/adistance" 2>/dev/null && bad=1
+echo junk > "$D/adistance" 2>/dev/null && bad=1
+now=$(cat "$D/adistance")
+if [ "$bad" = 0 ] && [ "$now" = "$CUSTOM" ]; then
+	ktap_test_pass "adistance rejects <=0 / non-numeric and is unchanged ($now)"
+else
+	ktap_test_fail "adistance accepted an invalid value (bad=$bad now=$now)"
+fi
+
+# 4. toggling private resets adistance to the default --------------------------
+echo "$CUSTOM" > "$D/adistance" 2>/dev/null
+echo 0 > "$D/private" 2>/dev/null		# leave private: reset to default
+echo 1 > "$D/private" 2>/dev/null		# re-enter private: attr reappears
+r=$(cat "$D/adistance")
+if [ "$r" = "$DEF" ]; then
+	ktap_test_pass "toggling private resets adistance to default ($DEF)"
+else
+	ktap_test_fail "toggling private left adistance=$r (want $DEF)"
+fi
+
+# 5. -EBUSY while the device is online -----------------------------------------
+echo "$CUSTOM" > "$D/adistance" 2>/dev/null
+if echo online_movable > "$D/state" 2>/dev/null; then
+	if echo "$((CUSTOM + 1))" > "$D/adistance" 2>/dev/null; then
+		ktap_test_fail "adistance writable while online (expected -EBUSY)"
+	else
+		ktap_test_pass "adistance write refused while online (-EBUSY)"
+	fi
+	echo unplugged > "$D/state" 2>/dev/null
+else
+	ktap_test_skip "could not online device to test -EBUSY"
+fi
+
+ktap_finished
diff --git a/tools/testing/selftests/dax/private_node_demotion.sh b/tools/testing/selftests/dax/private_node_demotion.sh
index 3f4a736e25b..e59c6b91cdc 100755
--- a/tools/testing/selftests/dax/private_node_demotion.sh
+++ b/tools/testing/selftests/dax/private_node_demotion.sh
@@ -4,67 +4,69 @@
 # Private-node demotion: opted-in private nodes participate in the
 # memory-tier demotion/promotion machinery via ALLOC_ZONELIST_PRIVATE.
 #
-#   1. Demote TO private: a private node defaults below DRAM in the tier order,
-#      so it is a demotion target; node-0 pressure demotes its cold tail onto
-#      the private node.
-#   2. Promote OFF private: with NUMA balancing (mode 2), re-touching demoted
-#      pages promotes them back to DRAM (pgpromote_success grows).
+#   1. Demote TO private: node-0 pressure demotes its cold tail onto a private
+#      node placed below DRAM.
+#   2. Promote OFF private: NUMA balancing mode 2 re-promotes demoted pages back
+#      to DRAM (pgpromote_success grows).
+#   3. Demote FROM private: a 2nd private node placed ABOVE DRAM demotes its
+#      overflow into DRAM.
 #
-# Caps are configured once at hotplug (re-plugging a node with resident memory
-# is not possible).  This SKIPs unless booted with the documented --numa/memmap
-# layout and CONFIG_NUMA_BALANCING.
+# Tiers are fixed at hotplug, so node1 onlines below DRAM and node2 above it.
+# SKIPs unless booted with the documented --numa/memmap layout and CONFIG_NUMA_BALANCING.
 
+# shellcheck disable=SC1091
 DIR="$(dirname "$(readlink -f "$0")")"
 . "$DIR"/../kselftest/ktap_helpers.sh
 . "$DIR"/private_node_common.sh
 
-TOOL="$DIR"/private_node_tool
-
 nanon() { awk '/nr_inactive_anon|nr_active_anon/{s+=$2} END{print s+0}' "$NODE_BASE/node$1/vmstat" 2>/dev/null; }
+pgd()   { awk '/^pgdemote_kswapd|^pgdemote_direct/{s+=$2} END{print s+0}' "$NODE_BASE/node$1/vmstat" 2>/dev/null; }
 vstat() { awk -v k="$1" '$1==k{print $2}' /proc/vmstat; }
 dram_mb() { awk '/MemTotal:/{print int($4/1024)}' "$NODE_BASE/node$1/meminfo"; }
 tier_id() { local f; for f in /sys/devices/virtual/memory_tiering/*/nodelist; do
 		nodelist_has "$(cat "$f")" "$1" && { b=$(basename "$(dirname "$f")"); echo "${b##*tier}"; return; }; done; }
 
-ktap_print_header
-pn_require_root
-[ -x "$TOOL" ] || { ktap_skip_all "private_node_tool not built"; exit "$KSFT_SKIP"; }
+pn_begin
+pn_require_tool
 [ -e /sys/kernel/mm/numa/demotion_enabled ] || { ktap_skip_all "demotion unsupported (CONFIG_NUMA_BALANCING?)"; exit "$KSFT_SKIP"; }
 pn_provision_all
 set -- $PN_NODES
 nprivate=$#
 [ "$nprivate" -ge 1 ] || { ktap_skip_all "no private node provisioned"; exit "$KSFT_SKIP"; }
-pn_swap_setup
+pn_snapshot_swaps
+trap pn_restore_globals EXIT INT TERM
+pn_swap_setup					# backstop so churn overflow swaps, not OOM
 DRAM0=$(awk -F, '{print $1}' "$NODE_BASE/has_memory"); DRAM0=${DRAM0%%-*}
 
 dax_for_node() { local d n; for d in $PN_DAXES; do
 		n=$(cat "$DAX_BASE/$d/target_node" 2>/dev/null); [ "$n" = "$1" ] && { echo "$d"; return; }; done; }
 
 P1=$(echo $PN_NODES | awk '{print $1}'); D1=$(dax_for_node "$P1")
+P2=$(echo $PN_NODES | awk '{print $2}'); [ -n "$P2" ] && D2=$(dax_for_node "$P2")
 
-# Configure once.  CAP_KERNEL_NUMA enables the whole demotion set (demotion
-# target + NUMA balancing + DAMON migrate) in one toggle.  A private node
-# defaults below DRAM in the tier order, so no tier placement is needed.
-cfg() {	# cfg DAX
+# Configure once: node1 below DRAM, node2 above (via adistance).  CAP_DEMOTION
+# opts the private node into the tier demotion machinery and requires reclaim.
+cfg() {	# cfg DAX ADIST
 	echo unplugged > "$DAX_BASE/$1/state" 2>/dev/null
 	echo 1 > "$DAX_BASE/$1/reclaim"
+	echo "$2" > "$DAX_BASE/$1/adistance"
 	echo 1 > "$DAX_BASE/$1/demotion"
 	echo 1 > "$DAX_BASE/$1/numa_balancing"
 	echo 1 > "$DAX_BASE/$1/hotunplug"
 	echo online_movable > "$DAX_BASE/$1/state" 2>/dev/null
 }
-cfg "$D1"
+cfg "$D1" 2880			# below DRAM
+[ -n "$D2" ] && cfg "$D2" 256		# above DRAM
+pn_save_global /sys/kernel/mm/numa/demotion_enabled
 echo 1 > /sys/kernel/mm/numa/demotion_enabled 2>/dev/null
 node_in_mask "$P1" has_private_memory || { ktap_skip_all "node $P1 did not online as private"; exit "$KSFT_SKIP"; }
-ktap_print_msg "private={$PN_NODES} dram0=$DRAM0 tiers: $P1=tier$(tier_id "$P1") DRAM=tier$(tier_id "$DRAM0")"
-ktap_set_plan 2
+ktap_print_msg "private={$PN_NODES} dram0=$DRAM0 tiers: $P1=tier$(tier_id "$P1") DRAM=tier$(tier_id "$DRAM0") ${P2:+$P2=tier$(tier_id "$P2")}"
+ktap_set_plan 4
 
 # 1. demote TO private (node1, below DRAM) ------------------------------------
-# Lay a COLD anon tail on DRAM (populated once then held, so it ages onto the
-# inactive LRU and becomes a demotion candidate), then drive pressure past the
-# TOTAL public DRAM so reclaim demotes the cold tail onto the private node
-# rather than only swapping.  A churn sized to a single DRAM node is not enough
-# when more than one DRAM node can absorb it, and churn keeps its own pages hot.
+# Cold anon tail (held, ages onto inactive LRU) + churn past TOTAL public DRAM:
+# sizing to a single DRAM node would let another DRAM node absorb it instead of
+# demoting, and churn keeps its own pages hot.
 a0=$(nanon "$P1")
 pubmb=0; for n in $(pn_dram_list); do pubmb=$(( pubmb + $(dram_mb "$n") )); done
 coldmb=$(( $(dram_mb "$P1") * 3 / 4 ))		# fits under the private node
@@ -84,6 +86,7 @@ fi
 if [ "$(cat "$DAX_BASE/$D1/numa_balancing" 2>/dev/null)" != 1 ]; then
 	ktap_test_skip "node $P1 has no numa_balancing cap"
 else
+	pn_save_global /proc/sys/kernel/numa_balancing
 	echo 2 > /proc/sys/kernel/numa_balancing 2>/dev/null
 	if [ "$(cat /proc/sys/kernel/numa_balancing 2>/dev/null)" != 2 ]; then
 		ktap_test_skip "NUMA balancing mode 2 (promotion) unavailable"
@@ -101,4 +104,50 @@ else
 	fi
 fi
 
+# 3. demote FROM private (node2, above DRAM) ----------------------------------
+if [ -z "$P2" ]; then
+	ktap_test_skip "demote-from-private needs a 2nd private node above DRAM"
+elif [ "$(tier_id "$P2")" -ge "$(tier_id "$DRAM0")" ] 2>/dev/null; then
+	ktap_test_skip "inverted tier did not form (P2=tier$(tier_id "$P2") vs DRAM=tier$(tier_id "$DRAM0"))"
+else
+	d0=$(pgd "$P2")
+	"$TOOL" daxchurn "/dev/$D2" 2000 55 >/dev/null 2>&1 & fp=$!	# fill node2 (top tier)
+	sleep 10
+	"$TOOL" churn $(( $(dram_mb "$DRAM0") + 512 )) 40 >/dev/null 2>&1 & cp=$!	# pressure DRAM onward
+	out=0
+	for _ in $(seq 1 9); do sleep 5; [ "$(pgd "$P2")" -gt $(( d0 + 1024 )) ] 2>/dev/null && { out=1; break; }; done
+	kill "$fp" "$cp" 2>/dev/null; wait "$fp" "$cp" 2>/dev/null
+	if [ "$out" = 1 ]; then
+		ktap_test_pass "private node $P2 above DRAM demoted *into* DRAM (pgdemote grew)"
+	else
+		ktap_test_fail "no demotion out of private node $P2 (pgdemote flat)"
+	fi
+fi
+
+# 4. NEGATIVE: demotion cleared -> private node is NOT a demotion target ----
+# Re-plug node1 below DRAM with reclaim on but demotion OFF; node-0 pressure
+# must not demote its cold tail onto the non-opted private node.
+echo unplugged    > "$DAX_BASE/$D1/state" 2>/dev/null
+echo 1            > "$DAX_BASE/$D1/reclaim"
+echo 2880         > "$DAX_BASE/$D1/adistance"
+echo 0            > "$DAX_BASE/$D1/demotion"
+echo 1            > "$DAX_BASE/$D1/hotunplug"
+echo online_movable > "$DAX_BASE/$D1/state" 2>/dev/null
+if ! node_in_mask "$P1" has_private_memory; then
+	ktap_test_skip "node $P1 did not re-online private for the demotion=0 check"
+else
+	a0=$(nanon "$P1")
+	"$TOOL" anon "$coldmb" 999 >/dev/null 2>&1 & cold=$!
+	sleep 8
+	"$TOOL" churn $(( pubmb + 256 )) 40 >/dev/null 2>&1 & cp=$!
+	grew=0
+	for _ in $(seq 1 9); do sleep 4; [ "$(nanon "$P1")" -gt $(( a0 + 16384 )) ] 2>/dev/null && { grew=1; break; }; done
+	kill "$cp" "$cold" 2>/dev/null; wait "$cp" "$cold" 2>/dev/null
+	if [ "$grew" = 0 ]; then
+		ktap_test_pass "demotion cleared: no demotion onto private node $P1 (nr_anon flat)"
+	else
+		ktap_test_fail "demotion landed on non-opted private node $P1 (nr_anon grew)"
+	fi
+fi
+
 ktap_finished
-- 
2.55.0

