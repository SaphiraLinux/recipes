From b7631e7bb09e3486243bd10d512dd962c3cc6a3c Mon Sep 17 00:00:00 2001
From: Gregory Price <gourry@gourry.net>
Date: Thu, 9 Jul 2026 00:13:18 -0700
Subject: [PATCH] mm/mprotect: keep write-fenced folios read-only across
 mprotect

mprotect() can hand a mapping back writable -- pte_modify()/pmd_modify() for a
shared writable mapping without write-notify -- which would bypass the fault-time
read-only fence.  Keep a folio on a write-fenced node read-only across mprotect
so a later write still faults and promotes it off-node.

can_change_private/shared_pte_writable() and change_present_ptes() (PTEs), and
can_change_pmd_writable() and change_huge_pmd() (PMDs), refuse to re-add write
for a write-fenced folio.  Anon is already covered by the non-exclusive install;
this closes the shared-file mapping case.

Inert until file folios are placed on such a node.

Signed-off-by: Gregory Price <gourry@gourry.net>
Assisted-by: Claude:claude-opus-4-8
---
 mm/huge_memory.c | 24 +++++++++++++++++++++---
 mm/mprotect.c    | 40 ++++++++++++++++++++++++++++++----------
 2 files changed, 51 insertions(+), 13 deletions(-)

diff --git a/mm/huge_memory.c b/mm/huge_memory.c
index 2754d1f98f4..209763550c1 100644
--- a/mm/huge_memory.c
+++ b/mm/huge_memory.c
@@ -2205,11 +2205,18 @@ static inline bool can_change_pmd_writable(struct vm_area_struct *vma,
 	if (userfaultfd_huge_pmd_wp(vma, pmd))
 		return false;
 
-	if (!(vma->vm_flags & VM_SHARED)) {
+	page = vm_normal_page_pmd(vma, addr, pmd);
+
+	/*
+	 * Write-fenced node folios stay read-only so a write promotes.  See
+	 * can_change_pte_writable().
+	 */
+	if (page && node_write_fenced(page_to_nid(page)))
+		return false;
+
+	if (!(vma->vm_flags & VM_SHARED))
 		/* See can_change_pte_writable(). */
-		page = vm_normal_page_pmd(vma, addr, pmd);
 		return page && PageAnon(page) && PageAnonExclusive(page);
-	}
 
 	/* See can_change_pte_writable(). */
 	return pmd_dirty(pmd);
@@ -2667,6 +2674,7 @@ int change_huge_pmd(struct mmu_gather *tlb, struct vm_area_struct *vma,
 	struct mm_struct *mm = vma->vm_mm;
 	spinlock_t *ptl;
 	pmd_t oldpmd, entry;
+	struct page *page;
 	bool prot_numa = cp_flags & MM_CP_PROT_NUMA;
 	bool uffd_prot = cp_flags & (MM_CP_UFFD_WP | MM_CP_UFFD_RWP);
 	bool uffd_prot_resolve = cp_flags &
@@ -2746,6 +2754,16 @@ int change_huge_pmd(struct mmu_gather *tlb, struct vm_area_struct *vma,
 	if (userfaultfd_rwp(vma) && pmd_uffd(entry))
 		entry = pmd_modify(entry, PAGE_NONE);
 
+	/*
+	 * Write-fenced node: pmd_modify() can hand back a writable entry for a
+	 * shared writable mapping with write-notify off.  Keep the folio
+	 * read-only so a write promotes off-node.  Mirrors change_present_ptes().
+	 * oldpmd holds the pfn because *pmd was invalidated above.
+	 */
+	page = vm_normal_page_pmd(vma, addr, oldpmd);
+	if (page && node_write_fenced(page_to_nid(page)))
+		entry = pmd_wrprotect(entry);
+
 	/* See change_pte_range(). */
 	if ((cp_flags & MM_CP_TRY_CHANGE_WRITABLE) && !pmd_write(entry) &&
 	    can_change_pmd_writable(vma, addr, entry))
diff --git a/mm/mprotect.c b/mm/mprotect.c
index 2888ee638d8..badd8c648b6 100644
--- a/mm/mprotect.c
+++ b/mm/mprotect.c
@@ -59,10 +59,8 @@ static bool maybe_change_pte_writable(struct vm_area_struct *vma, pte_t pte)
 }
 
 static bool can_change_private_pte_writable(struct vm_area_struct *vma,
-					    unsigned long addr, pte_t pte)
+					    struct page *page, pte_t pte)
 {
-	struct page *page;
-
 	if (!maybe_change_pte_writable(vma, pte))
 		return false;
 
@@ -71,13 +69,16 @@ static bool can_change_private_pte_writable(struct vm_area_struct *vma,
 	 * exclusive anonymous pages, because we know that our
 	 * write-fault handler similarly would map them writable without
 	 * any additional checks while holding the PT lock.
+	 *
+	 * A folio on a write-fenced node stays read-only.  A write promotes it
+	 * off-node.  Such a folio is never AnonExclusive; guard it explicitly.
 	 */
-	page = vm_normal_page(vma, addr, pte);
-	return page && PageAnon(page) && PageAnonExclusive(page);
+	return page && PageAnon(page) && PageAnonExclusive(page) &&
+	       !node_write_fenced(page_to_nid(page));
 }
 
 static bool can_change_shared_pte_writable(struct vm_area_struct *vma,
-					   pte_t pte)
+					   struct page *page, pte_t pte)
 {
 	if (!maybe_change_pte_writable(vma, pte))
 		return false;
@@ -91,16 +92,25 @@ static bool can_change_shared_pte_writable(struct vm_area_struct *vma,
 	 * FS was already notified and we can simply mark the PTE writable
 	 * just like the write-fault handler would do.
 	 */
-	return pte_dirty(pte);
+	if (!pte_dirty(pte))
+		return false;
+
+	/*
+	 * A folio on a write-fenced node stays read-only.  The dirty-means-notified
+	 * assumption above does not hold for it.  A write must fault and promote.
+	 */
+	return !(page && node_write_fenced(page_to_nid(page)));
 }
 
 bool can_change_pte_writable(struct vm_area_struct *vma, unsigned long addr,
 			     pte_t pte)
 {
+	struct page *page = vm_normal_page(vma, addr, pte);
+
 	if (!vma_test(vma, VMA_SHARED_BIT))
-		return can_change_private_pte_writable(vma, addr, pte);
+		return can_change_private_pte_writable(vma, page, pte);
 
-	return can_change_shared_pte_writable(vma, pte);
+	return can_change_shared_pte_writable(vma, page, pte);
 }
 
 static int mprotect_folio_pte_batch(struct folio *folio, pte_t *ptep,
@@ -195,7 +205,7 @@ static __always_inline void set_write_prot_commit_flush_ptes(struct vm_area_stru
 	bool set_write;
 
 	if (vma_test(vma, VMA_SHARED_BIT)) {
-		set_write = can_change_shared_pte_writable(vma, ptent);
+		set_write = can_change_shared_pte_writable(vma, page, ptent);
 		prot_commit_flush_ptes(vma, addr, ptep, oldpte, ptent, nr_ptes,
 				       /* idx = */ 0, set_write, tlb);
 		return;
@@ -306,6 +316,16 @@ static __always_inline void change_present_ptes(struct mmu_gather *tlb,
 	if (userfaultfd_rwp(vma) && pte_uffd(ptent))
 		ptent = pte_modify(ptent, PAGE_NONE);
 
+	/*
+	 * Keep a write-fenced-node folio read-only.  For a shared mapping without
+	 * writenotify, newprot carries write and pte_modify() hands it back
+	 * directly; the can_change_*_pte_writable() gates above are not consulted
+	 * on this path.  A write then faults and promotes off-node.  This mirrors
+	 * set_pte_range().
+	 */
+	if (folio && node_write_fenced(folio_nid(folio)))
+		ptent = pte_wrprotect(ptent);
+
 	/*
 	 * In some writable, shared mappings, we might want
 	 * to catch actual write access -- see
-- 
2.55.0

