 .../testing/selftests/dax/dcperf_taobench.sh  |  67 ++++++
 tools/testing/selftests/dax/tier_latency.sh   |  67 ++++++
 .../testing/selftests/dax/tier_latency_tool.c | 134 +++++++++++
 7 files changed, 717 insertions(+)
