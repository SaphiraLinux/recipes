@@ -308,6 +308,14 @@
 	debug ("trying encoding %s -> %s\n", try_from_code, try_to_code);
 
 	cd_utf8 = iconv_open (utf8_target, try_from_code);
+	if (cd_utf8 == (iconv_t) -1 && last && errno == EINVAL) {
+		/* musl libc rejects //IGNORE suffixes with EINVAL: it has
