+		 * surface below through the normal error path.
+		 */
+		cd_utf8 = iconv_open ("UTF-8", try_from_code);
+	}
 	if (cd_utf8 == (iconv_t) -1) {
 		error (0, errno, "iconv_open (\"%s\", \"%s\")", utf8_target,
 		       try_from_code);
