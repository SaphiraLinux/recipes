#!/sbin/openrc-run

description="MariaDB database server"
command=/usr/sbin/mariadbd
command_args="--defaults-file=/etc/my.cnf --datadir=/var/lib/mysql --pid-file=/var/run/mysqld/mariadbd.pid"
command_user="mysql:mysql"
command_background=true
pidfile=/var/run/mysqld/openrc-mariadb.pid
rc_ulimit="-n 65536"

depend()
{
	need localmount
	use net
}

start_pre()
{
	checkpath -d -m 0750 -o mysql:mysql /var/run/mysqld
	checkpath -d -m 0750 -o mysql:mysql /var/lib/mysql
	checkpath -d -m 0750 -o mysql:mysql /var/log/mysql
	# Stale pid/socket from an unclean shutdown block restart
	# (pid confusion, socket bind fails on an existing path).
	# start_pre runs only when OpenRC is about to start the server.
	rm -f /var/run/mysqld/mariadbd.pid /var/run/mysqld/openrc-mariadb.pid /var/run/mysqld/mysqld.sock
	if test ! -d /var/lib/mysql/mysql; then
		/usr/bin/mariadb-install-db --user=mysql \
			--basedir=/usr --datadir=/var/lib/mysql
	fi
}
