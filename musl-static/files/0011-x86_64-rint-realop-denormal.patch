diff --git a/src/math/x86_64/rint.c b/src/math/x86_64/rint.c
index fcb1989..5a6923b 100644
--- a/src/math/x86_64/rint.c
+++ b/src/math/x86_64/rint.c
@@ -1,3 +1,13 @@
+/* F3 candidate: rint with real-op flag restoration on subnormals.
+ * Base technique from 0004 (arch roundsd following the MXCSR mode).
+ * The F2b finding (combo silent on DE) and the F3 trap policy require
+ * the denormal-operand status bit to be preserved exactly as the
+ * generic C implementation raises it — including trapping when DM is
+ * unmasked. ldmxcsr cannot do that (it never traps), so the cold path
+ * executes one real, value-discarded operation on the original input:
+ * subnormal+1.0 raises PE|DE (DAZ=0) and stays silent under DAZ=1,
+ * exactly matching generic in both modes, masked and trapped.
+ * No MXCSR access at all; hot path is roundsd + bit test only. */
 #include <math.h>
 #include <stdint.h>

@@ -7,17 +17,10 @@ double rint(double x)
 	uint64_t a = u.i & 0x7fffffffffffffff;
 	double y;

-	/* Round according to the current rounding mode.  Unlike the
-	 * directed modes below, roundsd with the MXCSR mode raises the
-	 * inexact exception exactly as rint must.  It does not set the
-	 * denormal-operand status bit that the C implementation raised
-	 * for subnormal inputs, so that bit is preserved explicitly. */
 	__asm__ ("roundsd $4, %1, %0" : "=x" (y) : "x" (x));
 	if (a != 0 && a < 0x0010000000000000) {
-		unsigned mxcsr;
-		__asm__ volatile ("stmxcsr %0" : "=m" (mxcsr));
-		mxcsr |= 0x2;
-		__asm__ volatile ("ldmxcsr %0" :: "m" (mxcsr));
+		volatile double t = x + 1.0;	/* sacrificial: flags only */
+		(void)t;
 	}
 	return y;
 }
diff --git a/src/math/x86_64/rintf.c b/src/math/x86_64/rintf.c
index cf89315..1c036a9 100644
--- a/src/math/x86_64/rintf.c
+++ b/src/math/x86_64/rintf.c
@@ -1,3 +1,4 @@
+/* F3 candidate: rintf with real-op flag restoration (see rint-gated.c). */
 #include <math.h>
 #include <stdint.h>

@@ -7,15 +8,10 @@ float rintf(float x)
 	uint32_t a = u.i & 0x7fffffff;
 	float y;

-	/* As rint, but for float: roundss with the MXCSR mode raises
-	 * inexact exactly as required; the denormal-operand status
-	 * bit is preserved explicitly for subnormal inputs. */
 	__asm__ ("roundss $4, %1, %0" : "=x" (y) : "x" (x));
 	if (a != 0 && a < 0x00800000) {
-		unsigned mxcsr;
-		__asm__ volatile ("stmxcsr %0" : "=m" (mxcsr));
-		mxcsr |= 0x2;
-		__asm__ volatile ("ldmxcsr %0" :: "m" (mxcsr));
+		volatile float t = x + 1.0f;	/* sacrificial: flags only */
+		(void)t;
 	}
 	return y;
 }
