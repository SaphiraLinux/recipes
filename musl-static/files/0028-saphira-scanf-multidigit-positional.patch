--- a/src/stdio/vfscanf.c
+++ b/src/stdio/vfscanf.c
@@ -111,8 +111,15 @@
 		p++;
 		if (*p=='*') {
 			dest = 0; p++;
-		} else if (isdigit(*p) && p[1]=='$') {
