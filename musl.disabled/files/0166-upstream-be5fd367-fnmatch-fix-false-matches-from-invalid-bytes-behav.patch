From be5fd367cff8d5263b5f904067aeb401f93459b9 Mon Sep 17 00:00:00 2001
From: Rich Felker <dalias@aerifal.cx>
Date: Tue, 6 Oct 2026 13:20:05 -0400
Subject: [PATCH] fnmatch: fix false matches from invalid bytes behaving as
 end-of-string

when an invalid byte appeared next in the string immediately following
a character that matched the last character of the pattern, it was
mistakenly treated the same as end-of-string, causing fnmatch to
report the string as matching.
---
 src/regex/fnmatch.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/regex/fnmatch.c b/src/regex/fnmatch.c
index 8d73714b..afa46db5 100644
--- a/src/regex/fnmatch.c
+++ b/src/regex/fnmatch.c
@@ -183,7 +183,7 @@ static int fnmatch_internal(const char *pat, size_t m, const char *str, size_t n
 		default:
 			k = str_next(str, n, &sinc);
 			if (k <= 0)
-				return (c==END) ? 0 : FNM_NOMATCH;
+				return (c==END && !k) ? 0 : FNM_NOMATCH;
 			str += sinc;
 			n -= sinc;
 			kfold = flags & FNM_CASEFOLD ? casefold(k) : k;
@@ -243,7 +243,7 @@ static int fnmatch_internal(const char *pat, size_t m, const char *str, size_t n
 		c = pat_next(p, endpat-p, &pinc, flags);
 		p += pinc;
 		if ((k = str_next(s, endstr-s, &sinc)) <= 0) {
-			if (c != END) return FNM_NOMATCH;
+			if (c != END || k < 0) return FNM_NOMATCH;
 			break;
 		}
 		s += sinc;
-- 
