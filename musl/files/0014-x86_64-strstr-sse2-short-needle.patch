+	movzbq 1(%rsi),%r9	# n1
+	movzbq 2(%rsi),%r10	# n2
+	mov %r8,%rax
+	mov %r9,%rcx
+	mov %r10,%rdx
+	imul $0x01010101,%eax
+	imul $0x01010101,%ecx
+	imul $0x01010101,%edx
+	movd %eax,%xmm1
+	movd %ecx,%xmm2
+	movd %edx,%xmm3
+	pshufd $0,%xmm1,%xmm1
+	pshufd $0,%xmm2,%xmm2
+	pshufd $0,%xmm3,%xmm3
+	pxor %xmm7,%xmm7
+	mov %rdi,%rsi		# rsi = cursor
