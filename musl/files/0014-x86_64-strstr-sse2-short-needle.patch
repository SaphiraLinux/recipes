+	neg %rax
+	add $4096,%rax
+	cmp $16,%rax
+	jb .Ls3_tail
+	movdqu (%rsi),%xmm0
+	movdqa %xmm0,%xmm5
+	movdqa %xmm0,%xmm6
+	pcmpeqb %xmm1,%xmm5	# eq(n0)
+	pcmpeqb %xmm2,%xmm6	# eq(n1)
+	pmovmskb %xmm5,%eax
+	pmovmskb %xmm6,%ecx
+	shr $1,%ecx
+	and %ecx,%eax
+	movdqa %xmm0,%xmm5
+	pcmpeqb %xmm3,%xmm5	# eq(n2)
+	pmovmskb %xmm5,%ecx
+	shr $2,%ecx
+	and %ecx,%eax
+	and $0x3fff,%eax	# starts j <= 13 only
+	jnz .Ls3_hit
+	pcmpeqb %xmm7,%xmm0
+	pmovmskb %xmm0,%edx
+	test $0x3fff,%edx
+	jnz .Ls3_null
+	add $14,%rsi		# overlap step
+	jmp .Ls3_page
+.Ls3_tail:
+	movzbq (%rsi),%rcx
+	test %rcx,%rcx
+	jz .Ls3_null
+	cmp %r8b,%cl
+	jne .Ls3_adv
+	movzbq 1(%rsi),%rdx
+	cmp %r9b,%dl
+	jne .Ls3_adv
