diff -Naur old/src/string/strstr.c new/src/string/strstr.c
--- old/src/string/strstr.c	2026-11-10 12:02:52.183777221 +0000
+++ new/src/string/strstr.c	2026-11-10 12:02:52.215930740 +0000
@@ -1,6 +1,18 @@
 #include <string.h>
 #include <stdint.h>
 
+#ifdef __x86_64__
+/* F8: arch SSE2 short-needle helpers (src/string/x86_64/*byte_strstr.s).
+ * Same contract as the generic static functions below, which are kept
+ * verbatim for all other architectures. Hidden visibility: direct calls,
+ * no PLT, no new dynamic exports. */
+hidden char *__twobyte_strstr(const unsigned char *, const unsigned char *);
+hidden char *__threebyte_strstr(const unsigned char *, const unsigned char *);
+hidden char *__fourbyte_strstr(const unsigned char *, const unsigned char *);
+#define twobyte_strstr __twobyte_strstr
+#define threebyte_strstr __threebyte_strstr
+#define fourbyte_strstr __fourbyte_strstr
+#else
 static char *twobyte_strstr(const unsigned char *h, const unsigned char *n)
 {
 	uint16_t nw = n[0]<<8 | n[1], hw = h[0]<<8 | h[1];
@@ -23,6 +35,7 @@
 	for (h+=3; *h && hw != nw; hw = hw<<8 | *++h);
 	return *h ? (char *)h-3 : 0;
 }
+#endif
 
 #define MAX(a,b) ((a)>(b)?(a):(b))
 #define MIN(a,b) ((a)<(b)?(a):(b))
diff -Naur old/src/string/x86_64/fourbyte_strstr.s new/src/string/x86_64/fourbyte_strstr.s
--- old/src/string/x86_64/fourbyte_strstr.s	1970-01-01 00:00:00.000000000 +0000
+++ new/src/string/x86_64/fourbyte_strstr.s	2026-11-10 12:02:52.216217993 +0000
@@ -0,0 +1,107 @@
+	.text
+	.globl __fourbyte_strstr
+	.hidden __fourbyte_strstr
+	.type __fourbyte_strstr,@function
+# char *__fourbyte_strstr(const unsigned char *h, const unsigned char *n)
+# F8 arch helper for 4-byte needles (original Saphira code,
+# upstream musl MIT). Replaces fourbyte_strstr: same contract.
+# Method: 16-byte windows with 13-byte step (3-byte overlap), ordinary
+# SSE2 equality masks: eq(n0) & (eq(n1)>>1) & (eq(n2)>>2) & (eq(n3)>>3),
+# accepted only for start j <= 12. NUL/page handling as in simd2_strstr.
+# No AVX/VEX anywhere (SSE-only, no clock/transition risk).
+# Touches: rax, rcx, rdx, rsi, r8-r11, xmm0-xmm6 (xmm7 zero). Callee-saved
+# registers, DF and stack discipline preserved; integer flags unspecified.
+__fourbyte_strstr:
+	movzbq (%rsi),%r8	# n0
+	movzbq 1(%rsi),%r9	# n1
+	movzbq 2(%rsi),%r10	# n2
+	movzbq 3(%rsi),%r11	# n3
+	mov %r8,%rax
+	mov %r9,%rcx
+	imul $0x01010101,%eax
+	imul $0x01010101,%ecx
+	movd %eax,%xmm1
+	movd %ecx,%xmm2
+	mov %r10,%rax
+	mov %r11,%rcx
+	imul $0x01010101,%eax
+	imul $0x01010101,%ecx
+	movd %eax,%xmm3
+	movd %ecx,%xmm4
+	pshufd $0,%xmm1,%xmm1
+	pshufd $0,%xmm2,%xmm2
+	pshufd $0,%xmm3,%xmm3
+	pshufd $0,%xmm4,%xmm4
+	pxor %xmm7,%xmm7
+	mov %rdi,%rsi		# rsi = cursor
+.Ls4_page:
+	mov %rsi,%rax
+	and $4095,%rax
+	neg %rax
+	add $4096,%rax
+	cmp $16,%rax
+	jb .Ls4_tail
+	movdqu (%rsi),%xmm0
+	movdqa %xmm0,%xmm5
+	movdqa %xmm0,%xmm6
+	pcmpeqb %xmm1,%xmm5
+	pcmpeqb %xmm2,%xmm6
+	pmovmskb %xmm5,%eax
+	pmovmskb %xmm6,%ecx
+	shr $1,%ecx
+	and %ecx,%eax
+	movdqa %xmm0,%xmm5
+	pcmpeqb %xmm3,%xmm5
+	pmovmskb %xmm5,%ecx
+	shr $2,%ecx
+	and %ecx,%eax
+	movdqa %xmm0,%xmm5
+	pcmpeqb %xmm4,%xmm5
+	pmovmskb %xmm5,%ecx
+	shr $3,%ecx
+	and %ecx,%eax
+	and $0x1fff,%eax	# starts j <= 12 only
+	jnz .Ls4_hit
+	pcmpeqb %xmm7,%xmm0
+	pmovmskb %xmm0,%edx
+	test $0x1fff,%edx
+	jnz .Ls4_null
+	add $13,%rsi		# overlap step
+	jmp .Ls4_page
+.Ls4_tail:
+	movzbq (%rsi),%rcx
+	test %rcx,%rcx
+	jz .Ls4_null
+	cmp %r8b,%cl
+	jne .Ls4_adv
+	movzbq 1(%rsi),%rdx
+	cmp %r9b,%dl
+	jne .Ls4_adv
+	movzbq 2(%rsi),%rdx
+	cmp %r10b,%dl
+	jne .Ls4_adv
+	movzbq 3(%rsi),%rdx
+	cmp %r11b,%dl
+	jne .Ls4_adv
+	mov %rsi,%rax
+	ret
+.Ls4_adv:
+	inc %rsi
+	jmp .Ls4_page
+.Ls4_hit:
+	bsf %eax,%eax		# j = first hit (0..12)
+	pcmpeqb %xmm7,%xmm0
+	pmovmskb %xmm0,%edx
+	mov %eax,%ecx
+	mov $1,%eax
+	shl %cl,%eax
+	dec %eax
+	test %eax,%edx
+	jnz .Ls4_null
+	lea (%rsi,%rcx,1),%rax
+	ret
+.Ls4_null:
+	xor %eax,%eax
+	ret
+	.size __fourbyte_strstr,.-__fourbyte_strstr
+	.section .note.GNU-stack,"",@progbits
diff -Naur old/src/string/x86_64/threebyte_strstr.s new/src/string/x86_64/threebyte_strstr.s
--- old/src/string/x86_64/threebyte_strstr.s	1970-01-01 00:00:00.000000000 +0000
+++ new/src/string/x86_64/threebyte_strstr.s	2026-11-10 12:02:52.216229549 +0000
@@ -0,0 +1,96 @@
