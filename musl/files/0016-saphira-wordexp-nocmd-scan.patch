+/* Bound on nested ${...} recursion: the scanner recurses per nesting
+ * level, so unbounded input depth would exhaust the stack. Legitimate
+ * expansions nest single digits deep; anything beyond this is treated
+ * as too complex to verify safe (fail closed, like upstream). */
+#define BRACE_MAXDEPTH 64
+
+/* ${...} unit at s (s[0]=='$', s[1]=='{'), with fresh quote state
+ * (globs/words inside are parsed as their own context).
+ * in_arith: single-quote does not suppress cmdsub detection.
+ * *len set past the closing '}'.
+ * Returns 0 clean, 1 dirty (command substitution inside),
+ * 2 malformed or too deeply nested, -1 to fall back to legacy
+ * handling (bare brace or unbalanced: the caller reverts to
+ * historical behaviour). */
+static int brace_unit(const char *s, size_t *len, int in_arith, int depth)
+{
+	size_t i = 2;
+	int brdepth = 1, sq = 0, dq = 0;
+	if (depth > BRACE_MAXDEPTH)
+		return 2;
+	while (s[i]) {
+		char c = s[i];
+		if (c == '\\') {
+			if (!s[i+1]) return -2;
+			i += 2;
+			continue;
+		}
+		if (c == '\'' && !dq) {
+			sq ^= 1;
+			i++;
+			continue;
+		}
+		if (c == '"' && !sq) {
+			dq ^= 1;
+			i++;
+			continue;
+		}
+		if (c == '$' && s[i+1] == '\'' && !sq) {
+			size_t al = 0;
+			int a = ansi_unit(s+i, &al);
+			if (a < 0) return -2;
+			if (a == 2) return 2;
+			if (a) return 1;
+			i += al;
+			continue;
+		}
+		if (c == '{' && !sq) return -1;
+		if (c == '$' && s[i+1] == '{' && !sq) {
+			size_t nl = 0;
+			int n = brace_unit(s+i, &nl, in_arith, depth+1);
+			if (n < 0) return n;
+			if (n == 2) return 2;
+			if (n) return 1;
+			i += nl;
+			continue;
+		}
+		if (c == '$' && s[i+1] == '(' && s[i+2] == '(' && !sq) {
+			size_t al = 0;
+			int ar = arith_ok(s+i+1, &al);
+			if (ar == 0) {
+				i += 1 + al;
+				continue;
+			}
+			/* Invalid arithmetic reads as literal text here;
+			 * keep scanning it (an inner $( or backquote still
+			 * trips the rules below, so nothing executable
+			 * slips through). */
+			i++;
+			continue;
+		}
+		if (c == '$' && s[i+1] == '(') {
+			if (s[i+2] != '(') {
+				if (in_arith || !sq) return 1;
+				i += 2;
+				continue;
+			}
+		}
+		if (c == '`' && (in_arith || !sq)) return 1;
+		if (c == '}' && !sq) {
+			if (--brdepth == 0) {
+				*len = i+1;
+				return 0;
+			}
+			i++;
+			continue;
+		}
+		i++;
+	}
+	return -2;
+}
