+			/* base notation 16#ff needs a digit before # */
+			if (i > 0 && p[i-1] >= '0' && p[i-1] <= '9') {
+				while (is_wc(p[i+1]) || p[i+1] == '@')
+					i++;
+				i++;
+				last = 1;
+				continue;
+			}
+			return 2;
+		}
+		if (c == '$') {
+			if (p[i+1] == '\'') {
+				size_t al = 0;
+				int a = ansi_unit(p+i, &al);
+				if (a) return a == 2 ? 2 : 1;
+				if (last == 1) return 1;
+				last = 1;
+				i += al;
+				continue;
+			}
+			if (p[i+1] == '{') {
+				size_t bl = 0;
+				int b;
+				if (last == 1) return 1;
+				b = brace_unit(p+i, &bl, 1, 0);
+				if (b < 0) return 2;
+				if (b) return 1;
+				last = 1;
+				i += bl;
+				continue;
+			}
+			if (p[i+1] == '(') {
+				if (p[i+2] != '(') return 1;
+				i++;
+				last = 0;
+				continue;
+			}
+			{
+				size_t j = i+1;
+				if (p[j] == '{' || p[j] == '\'')
+					return 1;
+				if (is_wc(p[j]) || p[j] == '#' ||
+				    p[j] == '?' || p[j] == '-' ||
+				    p[j] == '$' || p[j] == '!') {
+					if (last == 1) return 1;
+					last = 1;
+					i++;
+					while (is_wc(p[i])) i++;
+					continue;
+				}
+				return 1;
+			}
+		}
+		if (is_wc(c) || c == '.') {
+			size_t j = i;
+			if (last == 1) return 1;
+			while (is_wc(p[j]) || p[j] == '.') j++;
+			last = 1;
+			i = j;
+			continue;
+		}
+		{
+			size_t j = i;
+			while (p[j] == '+' || p[j] == '-' || p[j] == '*' ||
+			       p[j] == '/' || p[j] == '%' || p[j] == '<' ||
+			       p[j] == '>' || p[j] == '&' || p[j] == '|' ||
+			       p[j] == '^' || p[j] == '~' || p[j] == '=' ||
+			       p[j] == '!' || p[j] == '?' || p[j] == ':' ||
+			       p[j] == ',')
+				j++;
+			if (j == i) return 1;
+			if (j - i == 1 && (p[i] == '&' || p[i] == '|'))
+				return 1;
+			if (last == 1) {
+				last = 2;
+				i = j;
+				continue;
+			}
+			{
+				size_t k = i;
+				while (k < j && (p[k] == '+' || p[k] == '-' ||
+						 p[k] == '~' || p[k] == '!'))
+					k++;
+				if (k != j) return 2;
+				i = j;
+				continue;
+			}
+		}
+	}
+	return 2;
+}
