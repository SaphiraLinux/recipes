+/* ANSI-C $'...' unit at s (s[0]=='$', s[1]=='\'').
+ * *len set past the closing quote.
+ * Returns 1 if the content holds "$(" or backquote, 2 if empty,
+ * 0 if clean, -1 if unterminated. */
+static int ansi_unit(const char *s, size_t *len)
+{
+	size_t i = 2;
+	int dirty = 0, empty = 1;
+	for (;;) {
+		if (s[i] == '\\') {
+			if (!s[i+1]) return -1;
+			empty = 0;
+			i += 2;
+			continue;
+		}
+		if (s[i] == '\'') {
+			*len = i+1;
+			if (empty) return 2;
+			return dirty;
+		}
+		if (!s[i]) return -1;
+		empty = 0;
+		if (s[i] == '$' && s[i+1] == '(') dirty = 1;
+		if (s[i] == '`') dirty = 1;
+		i++;
+	}
+}
