diff -Naur old/src/multibyte/mbsrtowcs.c new/src/multibyte/mbsrtowcs.c
--- old/src/multibyte/mbsrtowcs.c	2026-11-10 11:11:56.743361306 +0000
+++ new/src/multibyte/mbsrtowcs.c	2026-11-10 11:11:56.766503021 +0000
@@ -5,6 +5,10 @@
 #include <stdlib.h>
 #include "internal.h"
 
+#ifdef __x86_64__
+hidden size_t __avx2_ascii_run(const unsigned char *, size_t);
+#endif
+
 size_t mbsrtowcs(wchar_t *restrict ws, const char **restrict src, size_t wn, mbstate_t *restrict st)
 {
 	const unsigned char *s = (const void *)*src;
@@ -72,6 +76,31 @@
 			*src = (const void *)s;
 			return wn0;
 		}
+#ifdef __x86_64__
+		/* AVX2 fast path (x86-64-v3): bulk-copy a leading run of ASCII
+		 * bytes via __avx2_ascii_run (src/multibyte/x86_64/). The
+		 * helper counts leading ASCII non-NUL bytes in [s, s+maxlen)
+		 * and never reads outside it; maxlen is bounded by wn and the
+		 * bytes left in the current page, so every helper load stays
+		 * in mapped memory. The stop byte (NUL terminator, multibyte
+		 * lead, truncation, or EILSEQ) is handled by the scalar path
+		 * below. Other architectures keep the SWAR block as-is. */
+		if (*s-1u < 0x7f) {
+			size_t __page = 4096 - ((uintptr_t)s & 4095);
+			size_t __max = wn < __page ? wn : __page;
+			size_t __run = __avx2_ascii_run(s, __max);
+			wn -= __run;
+			while (__run--) *ws++ = *s++;
+			/* The block above can spend wn to exactly 0; the
+			 * SWAR/scalar paths below assume wn>0 (the loop-top
+			 * check), so re-check here instead of falling through
+			 * and underflowing wn with one more store. */
+			if (!wn) {
+				*src = (const void *)s;
+				return wn0;
+			}
+		}
+#endif
 #ifdef __GNUC__
 		typedef uint32_t __attribute__((__may_alias__)) w32;
 		if (*s-1u < 0x7f && (uintptr_t)s%4 == 0) {
diff -Naur old/src/multibyte/x86_64/__avx2_ascii_run.s new/src/multibyte/x86_64/__avx2_ascii_run.s
--- old/src/multibyte/x86_64/__avx2_ascii_run.s	1970-01-01 00:00:00.000000000 +0000
+++ new/src/multibyte/x86_64/__avx2_ascii_run.s	2026-11-10 11:11:56.766583597 +0000
@@ -0,0 +1,71 @@
+	.text
+	.globl __avx2_ascii_run
+	.hidden __avx2_ascii_run
+	.type __avx2_ascii_run,@function
+# size_t __avx2_ascii_run(const unsigned char *s, size_t maxlen)
+# Counts leading bytes that are ASCII *and* non-NUL, stopping at the
+# first high-bit byte, the first NUL, or maxlen — whichever comes first.
+# NEVER reads outside [s, s+maxlen): scalar head until 32-byte aligned,
+# then only aligned 32-byte vector blocks (an aligned block cannot
+# cross a page, and every loaded block is covered by maxlen), then a
+# scalar tail. maxlen==0 performs no read at all.
+# Caller contract: use for bounded spans only (e.g. min(wn, page bytes)).
+# NUL handling, wn accounting and multibyte decoding stay with the caller.
+# Preserves DF; integer flags unspecified on return (musl convention);
+# callee-saved registers untouched.
+# rdi=s (preserved), rsi=maxlen, rax=count, rdx=cursor, rcx=scratch.
+__avx2_ascii_run:
+	xor %eax,%eax		# count = 0
+	mov %rdi,%rdx		# cursor = s
+	test %rsi,%rsi
+	jz .Lrun_done		# maxlen==0: no read, return 0
+	# scalar head to 32-byte alignment (also covers tiny maxlen)
+.Lrun_head:
+	cmp %rsi,%rax		# count >= maxlen?
+	jae .Lrun_done
+	test $31,%edx
+	jz .Lrun_vectest	# aligned -> try vector path
+	movzbq (%rdx),%rcx	# load byte (in-bounds: count < maxlen)
+	test $0x80,%cl
+	jnz .Lrun_done		# non-ASCII (incl. NUL? no: NUL check below)
+	test %rcx,%rcx
+	jz .Lrun_done		# NUL -> stop (not counted)
+	inc %rdx
+	inc %rax
+	jmp .Lrun_head
+.Lrun_vectest:
+	# remaining = maxlen - count; need >= 32 for a vector block
+	mov %rsi,%rcx
+	sub %rax,%rcx
+	cmp $32,%rcx
+	jb .Lrun_tail		# <32 left -> scalar tail
+	vmovdqa (%rdx),%ymm0	# aligned: cannot cross a page
+	vpxor %ymm1,%ymm1,%ymm1	# zero vector (kept in-loop for clarity)
+	vpcmpeqb %ymm1,%ymm0,%ymm2	# zeros -> 0xFF bytes
+	vpmovmskb %ymm0,%ecx	# hi = high-bit mask
+	vpmovmskb %ymm2,%r8d	# zo = NUL mask... (r8d: caller-saved, free)
+	or %r8d,%ecx		# stop = non-ASCII or NUL
+	jz .Lrun_full		# no stop in this block
+	tzcntl %ecx,%ecx	# first stop position
+	add %rcx,%rax
+	jmp .Lrun_done		# span ends here (cursor NOT advanced past stop)
+.Lrun_full:
+	add $32,%rdx		# consume full block
+	add $32,%rax
+	jmp .Lrun_vectest
+.Lrun_tail:			# scalar to maxlen (no align requirement)
+	cmp %rsi,%rax
+	jae .Lrun_done
+	movzbq (%rdx),%rcx	# in-bounds: count < maxlen
+	test $0x80,%cl
+	jnz .Lrun_done
+	test %rcx,%rcx
+	jz .Lrun_done
+	inc %rdx
+	inc %rax
+	jmp .Lrun_tail
+.Lrun_done:
+	vzeroupper
+	ret
+	.size __avx2_ascii_run,.-__avx2_ascii_run
+	.section .note.GNU-stack,"",@progbits
