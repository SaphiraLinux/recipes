# snmp runtime identity (canonical, fixed): user snmp UID 148,
# primary group snmp GID 148. Required by the shipped service units
# (snmpd.service/snmptrapd.service User=snmp, both init scripts
# command_user snmp:snmp with -u/-g drop). The daemons bind ports
# 161/162 via a file capability (cap_net_bind_service), so the
# account itself stays unprivileged.
# UID 148 sits in the preferred 0..199 packaged range - never reuse it
# for another identity. Persistent-state mode 0750 mirrors staging.
#
# 148, not the 105 this fragment originally declared: 105 is haproxy's in
# the base seed, and one package owns each declared identity. net-snmp was
# never published, so the move costs no migration and needs no legacy
# sidecar. 148 is the next free ID above 146 openldap, allocated in
# package-name order across the 2026-10-02 identity unblock.
user snmp 148 snmp /var/lib/snmp /sbin/nologin
group snmp 148
dir /var/lib/snmp 0750 snmp snmp
