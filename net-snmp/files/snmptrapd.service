[Unit]
Description=Net-SNMP trap receiver
Documentation=man:snmptrapd(8)
After=network.target snmpd.service

[Service]
Type=simple
User=snmp
Group=snmp
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/sbin/snmptrapd -f -C -c /etc/snmp/snmptrapd.conf -u snmp -g snmp
Restart=on-failure

[Install]
WantedBy=multi-user.target
