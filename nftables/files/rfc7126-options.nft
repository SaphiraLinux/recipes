#!/usr/sbin/nft -f
# RFC 7126 (BCP 186) IPv4-options filtering defaults for Saphira.
#
# What nft can and cannot express (read before tightening):
# - nft has no per-option-type match. Presence is exact: a packet
#   carries options iff ip hdrlength > 5. First-byte matching
#   (@nh,160,8) catches an option only when it leads unpadded; a
#   preceding NOP evades that single rule. This implementation is
#   therefore NOT a complete mitigation, and must never be presented
#   as one (see RFC 7126 interoperability/security trade-offs).
#   The RFC explicitly endorses coarse granularity.
# - EOOL (0) and NOP (1) are NEVER matched below (RFC 4.1/4.2:
#   dropping them breaks legitimate traffic).
# - IPSO BSO/ESO (130/133) and CIPSO (134) are never dropped by
#   default (RFC 4.12-4.14): closed environments need them carried.
# - Router Alert (148): default is IGNORE (no rule). The kernel only
#   diverts it to registered listeners (e.g. RSVP); there is nothing
#   to drop. Uncomment the RA rule only to harden a host that must
#   never see it.
# - Host-level LSRR/SSRR die in the kernel already
#   (net.ipv4.conf.*.accept_source_route=0, locked in /etc/sysctl.conf).
#   These rules additionally stop FORWARDED optioned packets, which
#   sysctl cannot express.
#
# Auditability (RFC asks for per-type counters): every counter below
# is readable via `nft list chain inet rfc7126_options prerouting`.

table inet rfc7126_options {
    # Stateful counters must be declared before rules reference them.
    counter ip-options-seen {
    }
    counter lsrr-drop {
    }
    counter ssrr-drop {
    }
    counter rr-drop {
    }
    counter ts-drop {
    }
    counter stream-drop {
    }
    counter probemtu-drop {
    }
    counter replymtu-drop {
    }
    counter traceroute-drop {
    }
    counter visa-drop {
    }
    counter eip-drop {
    }
    chain prerouting {
        type filter hook prerouting priority -310; policy accept;

        # Audit: every optioned packet, any type.
        ip hdrlength > 5 counter name ip-options-seen comment "RFC7126 audit: IPv4 packets carrying any options"

        # LSRR (131): firewall bypass, stealth TCP, topology, amplification.
        ip hdrlength > 5 @nh,160,8 == 131 counter name lsrr-drop drop comment "RFC7126 4.3"

        # SSRR (137): same threat class as LSRR.
        ip hdrlength > 5 @nh,160,8 == 137 counter name ssrr-drop drop comment "RFC7126 4.4"

        # Record Route (7): topology mapping.
        ip hdrlength > 5 @nh,160,8 == 7 counter name rr-drop drop comment "RFC7126 4.5"

        # Internet Timestamp (68): clock-skew/OS fingerprinting, topology.
        ip hdrlength > 5 @nh,160,8 == 68 counter name ts-drop drop comment "RFC7126 4.7"

        # Obsolete: Stream ID (136), Probe MTU (11), Reply MTU (12),
        # Traceroute (82), VISA (142), EIP (145). No legitimate use.
        ip hdrlength > 5 @nh,160,8 == 136 counter name stream-drop drop comment "RFC7126 4.6 obsolete"
        ip hdrlength > 5 @nh,160,8 == 11 counter name probemtu-drop drop comment "RFC7126 4.9 obsolete"
        ip hdrlength > 5 @nh,160,8 == 12 counter name replymtu-drop drop comment "RFC7126 4.10 obsolete"
        ip hdrlength > 5 @nh,160,8 == 82 counter name traceroute-drop drop comment "RFC7126 4.11 obsolete"
        ip hdrlength > 5 @nh,160,8 == 142 counter name visa-drop drop comment "RFC7126 4.15 obsolete"
        ip hdrlength > 5 @nh,160,8 == 145 counter name eip-drop drop comment "RFC7126 4.16 obsolete"

        # Router Alert (148): default IGNORE per RFC 4.8. Uncomment to drop.
        # ip hdrlength > 5 @nh,160,8 == 148 counter name ra-drop drop comment "RFC7126 4.8 opt-in"
    }
}
