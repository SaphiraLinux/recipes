+++ b/vendor/github.com/NVIDIA/go-nvml/pkg/dl/dl_linux.go	2026-10-21 05:01:53.978826780 +0000
@@ -21,6 +21,12 @@
 // #include <dlfcn.h>
 // #include <stdlib.h>
