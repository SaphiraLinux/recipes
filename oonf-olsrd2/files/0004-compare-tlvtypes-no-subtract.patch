From: Saphira packaging <recipes@saphira.vm2.uk>
Subject: [PATCH] gcc16: compare tlv orders without signed subtraction

(int)a - b trips -Werror=strict-overflow once inlined into the
schedule comparisons. Spell the three-way comparison directly;
identical results on the uint16_t/uint8_t domains, no overflow
assumption for the optimizer to exploit.

--- a/src-plugins/subsystems/rfc5444/rfc5444_reader.c
+++ b/src-plugins/subsystems/rfc5444/rfc5444_reader.c
@@ -377,5 +377,19 @@
   if (entry->match_type_ext) {
-    return (int)tlv->_order - _calc_tlvconsumer_intorder(entry);
+    uint16_t tlv_order = tlv->_order;
+    uint16_t entry_order = _calc_tlvconsumer_intorder(entry);
+    if (tlv_order < entry_order) {
+      return -1;
+    }
+    if (tlv_order > entry_order) {
+      return 1;
+    }
+    return 0;
   }
-  return (int)tlv->type - (int)entry->type;
+  if (tlv->type < entry->type) {
+    return -1;
+  }
+  if (tlv->type > entry->type) {
+    return 1;
+  }
+  return 0;
 }
