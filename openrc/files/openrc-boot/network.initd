#!/sbin/openrc-run

description="Configure Saphira user-space networking"
command=/sbin/saphira-network-config
command_args=${network_args:-}

depend()
{
	need localmount
	before netmount
	provide net
}

start()
{
	ebegin "Configuring Saphira networking"
	"$command" start $command_args
	eend $?
}

stop()
{
	ebegin "Stopping Saphira networking"
	"$command" stop $command_args
	eend $?
}
