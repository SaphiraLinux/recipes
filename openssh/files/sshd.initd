#!/sbin/openrc-run

description="OpenBSD SSH daemon"

command="/usr/sbin/sshd"
command_args="-D"
supervisor="supervise-daemon"
required_files="/etc/ssh/sshd_config"

depend()
{
	use net
}

start_pre()
{
	checkpath -d -m 0755 /var/run/sshd
	# Login accounting databases: sshd records logins here but creates
	# neither file itself (proven by missing-lastlog and /dev/null-wtmp
	# errors). Created when absent only, existing files never touched:
	# /var/log/wtmp may be a live database with history, and payload
	# files would collide with unowned fossils on upgraded hosts.
	for acct in /var/log/wtmp /var/log/lastlog; do
		if [ ! -e "$acct" ] && [ ! -L "$acct" ]; then
			: > "$acct" || return 1
			chmod 0644 "$acct" || return 1
		fi
	done
	# First-start host keys, before any validation: ssh-keygen -A is
	# idempotent (it generates only missing key types, never replaces
	# existing keys), so this is safe on every start, and sshd -t
	# below requires the keys to exist. Same semantics as the
	# systemd unit's ExecStartPre=/usr/bin/ssh-keygen -A.
	ebegin "Generating missing SSH host keys"
	/usr/bin/ssh-keygen -A || return 1
	ebegin "Checking sshd configuration"
	# The check gates the start (SEV 2026-10-23: without `|| return 1`
	# a failed validation merely logged while sshd started degraded --
	# here without its mldsa44 host key, whose files had been corrupt
	# since 2026-10-17 while the type was never served).
	/usr/sbin/sshd -t || return 1
}
