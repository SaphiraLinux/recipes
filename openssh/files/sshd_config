# Saphira OpenSSH server configuration
Port 22
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::

# Host keys, newest first: mldsa44 (latest), ed25519 (standard),
# ecdsa (minimum). No RSA host key offered: clients negotiate the
# best of the above. This does not prevent RSA otherwise — client
# keys, signatures and key-exchange algorithms are untouched.
HostKey /etc/ssh/ssh_host_mldsa44_ed25519_key
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_ecdsa_key

SyslogFacility AUTHPRIV
LogLevel INFO

LoginGraceTime 120
PermitRootLogin prohibit-password
StrictModes yes
MaxAuthTries 4

PubkeyAuthentication yes
PasswordAuthentication yes
KbdInteractiveAuthentication no
# PAM per Saphira platform policy (built --with-pam); the service
# entry in /etc/pam.d/sshd is owned by this package.
UsePAM yes

UseDNS no
AllowTcpForwarding yes
X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/ssh/sftp-server
