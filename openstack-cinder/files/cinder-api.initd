#!/sbin/openrc-run
#
# OpenRC service for the OpenStack Block Storage (Cinder) API.
#
# Served by gunicorn with the supported WSGI application
# (cinder.wsgi.api:application). Configuration lives in
# /etc/cinder/cinder.conf (operator-provided). Runtime settings are
# read from /etc/conf.d/cinder-api.
#
# Shipped unconditionally; never enabled or started at install.
# Runs on controller nodes.

name="cinder-api"
description="OpenStack Block Storage (Cinder) API"

: "${CINDER_API_BIND:=127.0.0.1:8776}"
: "${CINDER_API_WORKERS:=$(nproc 2>/dev/null || echo 4)}"
: "${CINDER_API_CONF:=/etc/cinder/cinder.conf}"

command="/usr/bin/gunicorn"
command_args="--name cinder-api --bind ${CINDER_API_BIND} --workers ${CINDER_API_WORKERS} --pid /var/run/cinder/cinder-api.pid --config ${CINDER_API_CONF} cinder.wsgi.api:application"
command_user="cinder:cinder"
command_background="yes"
pidfile="/var/run/cinder/cinder-api.pid"

depend() {
	need net
	after firewall
}
