# Horizon service identity (fixed, in the preferred 0..199 packaged
# range): user horizon UID 170, primary group horizon GID 170.
# OpenStack services own the 164-170 block (164 keystone, 165 glance,
# 166 placement, 167 nova, 168 neutron, 169 cinder, 170 horizon).
# Required by the shipped service unit (systemd User=horizon, OpenRC
# command_user horizon:horizon) and the state/log directories.
# UID 170 is not reused by any other packaged identity.
user horizon 170 horizon /var/lib/horizon /sbin/nologin
group horizon 170
dir /var/lib/horizon 0750 horizon horizon
dir /var/log/horizon 0750 horizon horizon
