# Keystone API runtime settings (operator-editable).
#
# These are the WSGI container's own settings, not Keystone's configuration
# (which lives in /etc/keystone/keystone.conf). Nothing here is applied
# until the operator enables and starts the service.

# Address and port gunicorn listens on. Point this at a TLS-terminating
# proxy (nginx/haproxy) for production; leave the default for a local
# listener behind such a proxy.
#KEYSTONE_BIND="127.0.0.1:5000"

# Number of gunicorn worker processes.
#KEYSTONE_WORKERS="4"

# Path to the Keystone configuration file.
#KEYSTONE_CONF="/etc/keystone/keystone.conf"
