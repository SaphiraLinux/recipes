#!/sbin/openrc-run
#
# OpenRC service for the OpenStack Compute (Nova) API.
#
# Served by gunicorn with the supported WSGI application
# (nova.wsgi.osapi_compute:application). Configuration lives in
# /etc/nova/nova.conf (operator-provided). Runtime settings are read
# from /etc/conf.d/nova-api.
#
# Shipped unconditionally; never enabled or started at install.
# Runs on controller nodes; compute nodes do not need it.

name="nova-api"
description="OpenStack Compute (Nova) API"

: "${NOVA_API_BIND:=127.0.0.1:8774}"
: "${NOVA_API_WORKERS:=$(nproc 2>/dev/null || echo 4)}"
: "${NOVA_API_CONF:=/etc/nova/nova.conf}"

command="/usr/bin/gunicorn"
command_args="--name nova-api --bind ${NOVA_API_BIND} --workers ${NOVA_API_WORKERS} --pid /var/run/nova/nova-api.pid --config ${NOVA_API_CONF} nova.wsgi.osapi_compute:application"
command_user="nova:nova"
command_background="yes"
pidfile="/var/run/nova/nova-api.pid"

depend() {
	need net
	after firewall
}
