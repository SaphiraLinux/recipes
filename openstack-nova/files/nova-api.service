[Unit]
Description=OpenStack Compute (Nova) API
Documentation=man:gunicorn(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=nova
Group=nova
# Defaults first, operator file last: EnvironmentFile assignments win
# over Environment=, so /etc/conf.d/nova-api overrides these (the
# reverse order silently ignored operator settings). WORKERS default
# matches the initd nproc||4 fallback (systemd takes no command
# substitution); missing default was a boot failure (gunicorn
# --workers '' -> exit 2, proven on Hatchling). --name is gone:
# gunicorn 26 removed it. --config loads the argv sanitizer, NEVER
# nova.conf (an INI file gunicorn would import as Python and die on
# with SyntaxError, proven on Minimer).
Environment=NOVA_API_BIND=127.0.0.1:8774
Environment=NOVA_API_WORKERS=4
EnvironmentFile=-/etc/conf.d/nova-api
RuntimeDirectory=nova
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/gunicorn --config /etc/nova/gunicorn.conf.py \
	--bind ${NOVA_API_BIND} --workers ${NOVA_API_WORKERS} \
	--pid /var/run/nova/nova-api.pid \
	nova.wsgi.osapi_compute:application
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
