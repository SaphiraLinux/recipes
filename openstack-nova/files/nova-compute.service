[Unit]
Description=OpenStack Nova compute agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nova
Group=nova
EnvironmentFile=-/etc/conf.d/nova-compute
ExecStart=/usr/bin/nova-compute
Restart=on-failure
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
