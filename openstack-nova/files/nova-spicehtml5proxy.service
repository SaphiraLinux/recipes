[Unit]
Description=OpenStack Nova SPICE console proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nova
Group=nova
EnvironmentFile=-/etc/conf.d/nova-spicehtml5proxy
ExecStart=/usr/bin/nova-spicehtml5proxy
Restart=on-failure
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
