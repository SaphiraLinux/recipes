#!/sbin/openrc-run
#
# OpenRC service for the OpenStack Placement API.
#
# Served by gunicorn with the supported WSGI application
# (placement.wsgi.api:application). Configuration lives in
# /etc/placement/placement.conf (operator-provided). Runtime settings
# are read from /etc/conf.d/placement.
#
# Shipped unconditionally; never enabled or started at install.

name="placement"
description="OpenStack Placement API"

: "${PLACEMENT_BIND:=127.0.0.1:8778}"
: "${PLACEMENT_WORKERS:=$(nproc 2>/dev/null || echo 4)}"

command="/usr/bin/gunicorn"
command_args="--config /etc/placement/gunicorn.conf.py --bind ${PLACEMENT_BIND} --workers ${PLACEMENT_WORKERS} --pid /var/run/placement/placement.pid placement.wsgi.api:application"
command_user="placement:placement"
command_background="yes"
pidfile="/var/run/placement/placement.pid"

depend() {
	need net
	after firewall
}
