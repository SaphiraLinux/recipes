#!/sbin/openrc-run

description="Open vSwitch"
command=/usr/share/openvswitch/scripts/ovs-ctl

depend()
{
	need localmount
	before net
}

start_pre()
{
	checkpath -d -o root:root -m 0755 /var/run/openvswitch
}

start()
{
	ebegin "Starting Open vSwitch"
	"$command" ${ovs_options:---system-id=random} start
	eend $?
}

stop()
{
	ebegin "Stopping Open vSwitch"
	"$command" stop
	eend $?
}

status()
{
	"$command" status
}
