[Unit]
Description=PHP 8.5 FastCGI Process Manager
After=network.target

[Service]
Type=simple
LimitNOFILE=65535
# RuntimeDirectory= cannot express /var/run paths (it always creates
# under /run), so the directory is created explicitly. Stale pid and
# socket from an unclean shutdown are cleared before each start: the
# master recreates both, and ExecStartPre runs only when the service
# is (re)starting, never against a live master.
ExecStartPre=/usr/bin/install -d -m 0755 -o php-fpm -g php-fpm /var/run/php-fpm85
ExecStartPre=/bin/rm -f /var/run/php-fpm85/php-fpm85.pid /var/run/php-fpm85/www.sock
ExecStart=/usr/sbin/php-fpm85 -F -y /etc/php85/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
