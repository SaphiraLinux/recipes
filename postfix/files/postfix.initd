#!/sbin/openrc-run

description="Postfix Mail Transport Agent"

command="/usr/libexec/postfix/master"
pidfile="/var/spool/postfix/pid/master.pid"

depend()
{
	use net logger dns
}

start_pre()
{
	# No runtime-dir creation here: the queue directory (including
	# pid/) ships in the payload and converges via the accounts.d
	# dir stanza; `postfix check` validates the rest. The old
	# /run/postfix path was consumed by nothing and is gone.
	ebegin "Checking postfix configuration"
	/usr/sbin/postfix check
}

stop_post()
{
	# Let postfix tear down its own queue daemons cleanly.
	/usr/sbin/postfix stop >/dev/null 2>&1 || true
	return 0
}
