+/* musl: error() is a glibc-ism; pppoe-discovery links this file standalone */
+#include <stdarg.h>
+void error(char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	fprintf(stderr, "pppoe-discovery: ");
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+	fprintf(stderr, "\n");
+}
