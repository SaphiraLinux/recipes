# qmail runtime identities and filesystem contract (canonical, fixed).
# Derived from upstream hier.c + doc/INSTALL.ids at pin 466192b:
# all ownership/modes below mirror hier() exactly; the live
# reconciler applies them because rootless staging cannot chown.
# Primary groups follow INSTALL.ids: alias/qmaild/qmaill/qmailp in
# nofiles, qmailq/qmailr/qmails in qmail. UIDs 132-142 frozen.
# control/cache + overlimit are vpopmail-owned and declared in the
# vpopmail fragment, not here (one package owns each identity).
# The queue trigger fifo cannot ship in APKs; qmail-send units
# create it with ownership at start. This fragment ships in the
# qmail main output; the filename must match the output.
# Minimality rule: the reconciler converges mode+ownership on the
# declared leaf only, never walks, and the payload ships every path
# below with hier() modes intact (only chown is skipped rootless).
# So every path whose live ownership must differ from root:root is
# covered - parents by dir stanzas, the eight numbered queue
# families (mess/todo/intd/info/local/remote/suppl0/suppl1 0..22)
# by one dir-children rule each. dir-children expands to per-child
# dir operations on computed names only: the parent is never
# listed, so live queue content is never touched. The only paths
# with no stanza at all are `0755 root qmail`: payload mode is
# already 0755 and root:qmail is access-identical to root:root
# there - declaring them would be a no-op converge on every
# install. Sole exception is /var/qmail itself (below): every qmail*
# user homes there, so home reconciliation chowns it on every run and
# only a real stanza restores hier ownership afterwards. Do not expand
# the rules back into numbered lines.
user alias 133 nofiles /var/qmail/alias /sbin/nologin
user qmaild 134 nofiles /var/qmail /sbin/nologin
user qmaill 135 nofiles /var/qmail /sbin/nologin
user qmailp 136 nofiles /var/qmail /sbin/nologin
user qmailq 137 qmail /var/qmail /sbin/nologin
user qmailr 138 qmail /var/qmail /sbin/nologin
user qmails 139 qmail /var/qmail /sbin/nologin
group qmail 132
group nofiles 142
dir /var/qmail/control/domainkeys 0700 qmailr qmail
dir /var/qmail/control/notlshosts 0755 qmailr qmail
# /var/qmail itself is root:qmail by hier(), and it must stay so: every
# qmail* user homes here, and home reconciliation chowns (but since the
# create-only fix, never chmods) the home path on every run. Without this
# stanza nothing would restore hier ownership afterwards.
dir /var/qmail 0755 root qmail
dir /var/qmail/alias 2755 alias qmail
dir /var/qmail/queue 0750 qmailq qmail
dir /var/qmail/queue/pid 0700 qmailq qmail
dir /var/qmail/queue/intd 0700 qmailq qmail
dir /var/qmail/queue/todo 0750 qmailq qmail
dir /var/qmail/queue/bounce 0700 qmails qmail
dir /var/qmail/queue/lock 0750 qmailq qmail
dir /var/qmail/queue/mess 0750 qmailq qmail
dir-children /var/qmail/queue/mess 0..22 0750 qmailq qmail
dir-children /var/qmail/queue/todo 0..22 0750 qmailq qmail
dir-children /var/qmail/queue/intd 0..22 0700 qmailq qmail
dir /var/qmail/queue/info 0700 qmails qmail
dir-children /var/qmail/queue/info 0..22 0700 qmails qmail
dir /var/qmail/queue/local 0700 qmails qmail
dir-children /var/qmail/queue/local 0..22 0700 qmails qmail
dir /var/qmail/queue/remote 0700 qmails qmail
dir-children /var/qmail/queue/remote 0..22 0700 qmails qmail
dir /var/qmail/queue/suppl0 0700 qmails qmail
dir-children /var/qmail/queue/suppl0 0..22 0700 qmails qmail
dir /var/qmail/queue/suppl1 0700 qmails qmail
dir-children /var/qmail/queue/suppl1 0..22 0700 qmails qmail
file /var/qmail/bin/qmail-queue 04711 qmailq qmail
file /var/qmail/bin/qmail-dkim 0711 qmailq qmail
file /var/qmail/bin/dkim 0711 qmailq qmail
file /var/qmail/queue/lock/tcpto 0644 qmailr qmail
file /var/qmail/queue/lock/sendmutex 0600 qmails qmail
