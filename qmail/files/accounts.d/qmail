# qmail runtime identities and filesystem contract (canonical, fixed).
# Derived from upstream hier.c + doc/INSTALL.ids at pin 466192b:
# all ownership/modes below mirror hier() exactly; the live
# reconciler applies them because rootless staging cannot chown.
# Primary groups follow INSTALL.ids: alias/qmaild/qmaill/qmailp in
# nofiles, qmailq/qmailr/qmails in qmail. UIDs 132-142 frozen.
# control/cache + overlimit are vpopmail-owned and declared in the
# vpopmail fragment, not here (one package owns each identity).
# The queue trigger fifo cannot ship in APKs; qmail-send units
# create it with ownership at start. This fragment ships in the
# qmail main output; the filename must match the output.
user alias 133 nofiles /var/qmail/alias /sbin/nologin
user qmaild 134 nofiles /var/qmail /sbin/nologin
user qmaill 135 nofiles /var/qmail /sbin/nologin
