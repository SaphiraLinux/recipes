 #include <stdio.h>
 #include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+/* Saphira rootless staging: DESTDIR prefixes every installed
+   path, and SAPHIRA_NO_CHOWN skips ownership changes (the
+   accounts.d file/dir stanzas apply them at install time).
+   Modes are still applied - chmod works unprivileged. */
+static const char *saphira_destdir = 0;
+static int saphira_no_chown = 0;
+static char *saphira_home(char *home)
+{
+  static char buf[512];
+  if (!saphira_destdir || !*saphira_destdir) return home;
+  snprintf(buf,sizeof buf,"%s%s",saphira_destdir,home);
+  return buf;
+}
+static int saphira_chown(const char *p, int u, int g)
+{
+  if (saphira_no_chown) return 0;
+  return chown(p,u,g);
+}
