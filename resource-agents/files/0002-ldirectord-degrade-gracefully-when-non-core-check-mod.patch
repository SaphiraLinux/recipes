+# _check_http_tiny
+# Minimal HTTP/HTTPS negotiate check used when the LWP module chain
+# (LWP::UserAgent, Net::HTTP, URI) is not installed. Mirrors the
+# check_http() semantics: request $$r{url} with the virtual Host
+# header, match the optional receive string against the response
+# content and treat any transport error or non-success status as
+# SERVICE_DOWN. HTTPS requires IO::Socket::SSL; without it the
+# transport fails and the server is reported down.
+sub _check_http_tiny
+{
+	my ($v, $r) = @_;
+
+	my $virtualhost = (defined $$v{virtualhost} ? $$v{virtualhost} : $$r{server});
+	my $recstr = $$r{receive};
+
+	&ld_debug(2, "check_http(HTTP::Tiny fallback): url=\"$$r{url}\" "
+		. "virtualhost=\"$virtualhost\"");
+
+	require HTTP::Tiny;
+	my $http = HTTP::Tiny->new(
+		timeout => $$v{negotiatetimeout},
+		verify_SSL => 0,
+	);
+	my $response = eval {
+		local $SIG{'__DIE__'} = "DEFAULT";
+		local $SIG{'ALRM'} = sub { die "Timeout Alarm" };
+		alarm $$v{negotiatetimeout};
+		my $res = $http->get($$r{url},
+			{ headers => { Host => $virtualhost } });
+		alarm 0;
+		$res;
+	};
+
+	unless (defined($response)) {
+		&ld_debug(2, "check_http: timeout");
+		service_set($v, $r, "down", {do_log => 1}, "no response");
+		&ld_debug(2, "check_http: $$r{url} is down\n");
+		return $SERVICE_DOWN;
+	}
+
+	unless ($response->{success}) {
+		service_set($v, $r, "down", {do_log => 1},
+			($response->{status} // 0) . " "
+			. ($response->{reason} // ""));
+		&ld_debug(2, "check_http: $$r{url} is down\n");
+		return $SERVICE_DOWN;
+	}
+
+	if (!($recstr =~ /.+/) || $response->{content} =~ /$recstr/) {
+		service_set($v, $r, "up", {do_log => 1},
+			$response->{status} . " " . $response->{reason});
+		&ld_debug(2, "check_http: $$r{url} is up\n");
+		return $SERVICE_UP;
+	}
+
+	service_set($v, $r, "down", {do_log => 1},
+		$response->{status} . " " . $response->{reason});
+	&ld_debug(2, "check_http: $$r{url} is down\n");
+	return $SERVICE_DOWN;
+}
