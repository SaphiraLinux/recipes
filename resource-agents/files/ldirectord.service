[Unit]
Description=ldirectord load balancer director (Layer 4 LVS)
Documentation=man:ldirectord(8)
After=network-online.target
Wants=network-online.target

[Service]
# ldirectord is both the daemon and its own control interface: the
# start/stop/reload subcommands drive the virtual IP and real server
# tables. Mirrors files/ldirectord.initd.
Type=forking
PIDFile=/var/run/ldirectord.ldirectord.pid
# ABSOLUTE configuration path. The previous spelling was a bare
# "ldirectord.cf", which only resolved if the working directory happened
# to be /etc/ha.d -- it is not, so the unit could not have started. The
# file also did not exist: the package installed no configuration at all.
# Only an .example ships, because a virtual IP table is a site decision
# and a wrong one silently blackholes traffic.
ExecStart=/usr/sbin/ldirectord /etc/ha.d/ldirectord.cf start
ExecStop=/usr/sbin/ldirectord /etc/ha.d/ldirectord.cf stop
ExecReload=/usr/sbin/ldirectord /etc/ha.d/ldirectord.cf reload
# ldirectord needs ipvsadm and refuses to start without it. Check it here
# so the failure names the missing dependency rather than surfacing as an
# opaque daemon exit.
ExecCondition=/bin/sh -c 'command -v ipvsadm >/dev/null 2>&1'

# Restart= was on-failure with RestartSec=2. That is NOT justified for a
# director: a crash-restart loop re-arps the virtual addresses on every
# iteration, which can blackhole traffic for longer than leaving the
# director down would. Restart only on abnormal exit (a clean non-zero
# from `stop` is not a fault) and rate-limit the attempts.
Restart=on-abnormal
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Deliberately NOT set: NoNewPrivileges (ldirectord programs the kernel
# IPVS table and binds virtual addresses, so it needs CAP_NET_ADMIN and
# CAP_NET_RAW), ProtectSystem=strict, and any CapabilityBoundingSet
# without a real LVS test.
#
# Safe and therefore set: ProtectHome, PrivateTmp.

ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
