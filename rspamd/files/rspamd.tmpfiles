# tmpfiles.d entry for rspamd. The unit runs unprivileged
# (User=rspamd), so it cannot create its own runtime dir under
# /var/run (RuntimeDirectory= only covers /run): tmpfiles.d owns
# creation with the service identity. /var/run is persistent by
# design, never wiped at boot.
d /var/run/rspamd 0755 rspamd rspamd -
