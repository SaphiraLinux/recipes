GRUB_DEFAULT=0
GRUB_TIMEOUT=3
GRUB_DISTRIBUTOR="Saphira"
# console= names exactly one console, and it is the VGA (tty0). The kernel
# takes the LAST console= on the command line as the one /dev/console maps
# to, so listing ttyS0 here handed /dev/console to a serial port that most
# Saphira machines do not have: firstboot - which runs entirely on
# /dev/console (openrc init script redirection, systemd TTYPath) - had
# nowhere to show or read, so an unconfigured machine booted straight past
# setup to the login prompt with no error anywhere (proven on a BIOS
# acceptance image booted on a machine with no serial hardware). A
# deployment that genuinely has a serial console adds console=ttyS0 to its
# own kernel line.
GRUB_CMDLINE_LINUX="rootfstype=ext4 rw rootwait console=tty0 raid=noautodetect"
# root= must name something the kernel resolves WITHOUT an initramfs:
# Saphira ships no initrd and no builtin initramfs, and the running
# kernel's early_lookup_bdev resolves device paths, PARTUUID= and
# PARTLABEL= only (verified against vendored sources). The filesystem
# UUID= and LABEL= forms are parsed by initrd/initramfs userspace
# (blkid), so a generated root=UUID= entry boots nowhere here - proven
# on Minimer 2026-11-07, where every UUID entry failed with an
# unmountable root and the device path booted. GRUB_DISABLE_LINUX_UUID
# removes the unbootable form tree-wide. PARTUUID stays enabled: GPT
# partition UUIDs are stable across disk reorder AND resolve in-kernel,
# with a device-path fallback when unprobable (see the 10_linux guard
# in the grub recipe, which must never emit a bare PARTUUID=).
GRUB_DISABLE_LINUX_UUID=true
GRUB_DISABLE_LINUX_PARTUUID=false
# No nomodeset: Saphira needs kernel modesetting and the EFI framebuffer
# for console (nomodeset blinds UEFI boxes: no efifb, and i915 ships as
# a module with no initramfs to load it early). A machine that genuinely
# needs modesetting off overrides this on its own kernel line.
# No init= override, ever: an explicit init= never falls back - if the named
# path does not exist the kernel panics (proven on Egg 2026-10-22, where the
# packaged init=/usr/lib/systemd/systemd reached a live grub.cfg through the
# kernel upgrade hook and the machine had to be recovered). The kernel's
# /sbin/init search is the only supported path, and the bootloader never
# selects the init implementation. Merged-usr paths are invalid on
# Saphira/SaphiraD: there is no /usr/sbin/init and no other PID 1 location.
# Test boots must omit init= to prove the contract.
# systemd.imds=no: Saphira is not a cloud image, so the IMDS metadata
# generator can never enable here - but in auto mode it still opens the
# hardware database at every boot and logs a failed lookup when none
# exists yet. Disabling it explicitly (documented upstream knob) keeps
# boot output clean; a future cloud role re-enables it deliberately.
# It is NOT in the line above. The packaged default is init-neutral, and
# a systemd-only kernel argument on an OpenRC target is target leakage:
# meaningless there, and misleading to anyone reading /proc/cmdline.
# Nothing adds init-specific arguments anywhere: saphira-image used to
# inject systemd.getty_auto=0/systemd.imds=no for SaphiraD targets, but
# that made grub differ by init, so it was removed (2026-11-06) -
# generator concerns stay init-side, never bootloader tokens.
# The boot MENU is offered on the native console only. Serial used to be
# offered alongside the VGA on the theory that grub ignores a terminal it
# cannot open - but the explicit `serial' command is NOT ignored: with
# --unit=0 it looks up port com0, and on machines with no UART and no ACPI
# SPCR that lookup fails, printing `serial port `com0' isn't found' at
# every boot. A deployment that genuinely has a serial console opts back
# in by uncommenting the three lines below (and, separately, adds its own
# console=ttyS0 kernel line - see the console= note above, which this file
# deliberately does not do for you).
GRUB_TERMINAL_INPUT="console"
GRUB_TERMINAL_OUTPUT="console"
#GRUB_TERMINAL_INPUT="console serial"
#GRUB_TERMINAL_OUTPUT="console serial"
#GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1"
GRUB_DISABLE_OS_PROBER=true
