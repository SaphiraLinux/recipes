#!/usr/bin/env bash

set -euo pipefail

ROOTFS=${1:?derived rootfs path is required}
ROOT=${SAPHIRA_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}
[[ $ROOTFS == "$ROOT/out/stage4/rootfs" ]] ||
	{ printf 'configure-grub: unsafe rootfs: %s\n' "$ROOTFS" >&2; exit 1; }
config=$ROOTFS/boot/grub/grub.cfg
test -s "$config" || {
	printf 'configure-grub: missing accepted GRUB configuration\n' >&2
	exit 1
}
grep -Fq 'Akadata Linux Stage4 (network validation, no kernel ip=)' "$config" &&
	exit 0

temporary=$config.stage4
cp "$config" "$temporary"
{
	printf '\n'
	sed -n '/^menuentry /,/^}/p' "$config" |
sed \
	-e '1s|^menuentry .*|menuentry "Akadata Linux Stage4 (network validation, no kernel ip=)" {|' \
	-e '/^[[:space:]]*linux /s/ ip=[^[:space:]]*//'
} >> "$temporary"
grep -Fq 'network validation, no kernel ip=' "$temporary"
mv "$temporary" "$config"
