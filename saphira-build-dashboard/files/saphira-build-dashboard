def open_db(path):
    """Open the queue database strictly read-only."""
    return sqlite3.connect(
        "file:%s?mode=ro" % pathname2url(path), uri=True, timeout=5.0
    )


def load_repo_map(repo_dir):
    """{package: (nvr, published_at)} from repository.db newest rows.

    Fail-open: missing/unreadable repo yields {}. The dashboard never
    writes; this is a read-only join for the repository-newest label."""
    out = {}
    if not repo_dir:
        return out
    try:
        db = sqlite3.connect(
            "file:%s/repository.db?mode=ro" % pathname2url(repo_dir),
            uri=True, timeout=5.0)
        try:
            for name, nvr, pub in db.execute(
                    "SELECT name,nvr,published_at FROM packages"
                    " WHERE is_newest=1"):
                out[name] = (nvr, pub)
        finally:
            db.close()
    except sqlite3.Error:
        return {}
    return out


def load_req_map(recipes_dir):
    """{package: nvr} requested by the recipe tree.

    Fail-open line parse of pkgname/pkgver/pkgrel (recipes are never
    sourced). Missing tree yields {}."""
    import os as _os
    import re as _re
    out = {}
    if not recipes_dir:
        return out
    try:
        names = sorted(_os.listdir(recipes_dir))
    except OSError:
        return out
    for pkg in names:
        rp = _os.path.join(recipes_dir, pkg, "recipe.sh")
        try:
            with open(rp, encoding="utf-8", errors="replace") as f:
                text = f.read(65536)
        except OSError:
            continue
        ver = _re.search(r"^pkgver=(\S+)", text, _re.M)
        rel = _re.search(r"^pkgrel=(\S+)", text, _re.M)
        if ver:
            nvr = ver.group(1) + ("-r" + rel.group(1) if rel else "")
            out[pkg] = nvr
    return out


def row_nvr(row):
    """'version-r revision' for a COLUMNS row, or ''."""
    ver, rev = row[1], row[2]
    if ver and rev:
        return "%s-r%s" % (ver, rev)
    return ver or ""


TRUNC = 140
FAIL_STATUSES = ("fail", "failed", "failure", "error")


def parse_result(result_json):
    """result_json as a dict, or {} when absent, unparsable, or not an
    object. Never raises: unknown shapes must not break the page."""
    try:
        obj = json.loads(result_json or "")
    except (TypeError, ValueError):
        return {}
    return obj if isinstance(obj, dict) else {}


def shorten(text):
    """One-line detail budget: long details (tracebacks) would blow
    the compact layout, so cap at TRUNC chars with an explicit mark."""
    text = str(text)
    return text if len(text) <= TRUNC else text[:TRUNC] + "…"


def stage_detail(obj, wanted):
    """Detail of the first stage in dict order whose status is wanted,
    as 'STAGE: detail', or ''. Dict order is pipeline order, so this
    names the earliest failed stage - never the build step when a
    later stage is what actually failed."""
    stages = obj.get("stages")
    if not isinstance(stages, dict):
        return ""
    for name, entry in stages.items():
        if not isinstance(entry, dict):
            continue
        if str(entry.get("status", "")).lower() in wanted:
            detail = entry.get("detail")
            if detail:
                return "%s: %s" % (name, shorten(detail))
            return str(name)
    return ""


def build_detail(obj):
    """BUILD stage detail, or '' (says why a refusal never ran)."""
    stages = obj.get("stages")
    if not isinstance(stages, dict):
        return ""
    build = stages.get("BUILD")
    if isinstance(build, dict) and build.get("detail"):
        return shorten(build["detail"])
    return ""


def fallback_detail(obj):
    blockers = obj.get("blockers")
    if isinstance(blockers, list) and blockers:
        return shorten("blockers: " + ", ".join(str(b) for b in blockers))
    attempt = obj.get("attempt")
    return shorten(str(attempt)) if attempt else ""


def cell(value):
    if value is None:
        return "-"
    return html.escape(str(value))


def classify(row):
    """(css class, state text, detail) for one build row.

    Row layout follows COLUMNS: 3 state, 4 result_json, 10 finished_at,
    11 started_at, 12 published_at, 13 queued_at. Unfinished rows derive
    QUEUED vs RUNNING vs STALLED from timestamps alone, so unknown state
    strings can never break the page; unknown terminal states read FAILED
    with whatever detail the result carries. BLOCKED and INTERRUPTED are
    first-class states, never folded into FAILED: a blocked build waits
    on dependencies (amber), an interrupted build died mid-flight (red,
    retryable), a failed build ran and failed (red).
    """
    state, result_json = row[3], row[4]
    finished, started, published = row[10], row[11], row[12]
    queued = row[13] if len(row) > 13 else None
    if finished is None:
        if state == "BLOCKED":
            obj = parse_result(result_json)
            return ("blocked", "BLOCKED", fallback_detail(obj))
        if _is_stalled(started or queued):
            return ("stalled", "STALLED",
                    "no progress for over 2h (started: %s)" % (started or queued or "?"))
        return ("amber", "QUEUED" if started is None else "RUNNING", "")
    obj = parse_result(result_json)
    if obj.get("attempt") == "refusal":
        why = build_detail(obj)
        return ("refused", "REFUSED",
                "never built" + (": " + why if why else ""))
    if state == "INTERRUPTED":
        detail = stage_detail(obj, ("interrupted",)) or fallback_detail(obj)
        return ("interrupted", "INTERRUPTED",
                (detail or "builder died mid-flight; retry explicitly"))
    if state == "PASS":
        # published_at is written when the package publishes. A PASS
        # without one is built but awaiting signing (amber by
        # agreement). If the column were ever left unpopulated, every
        # PASS would read amber: visibly wrong, reported, one-line fix
        # - never silent.
        if published:
            return ("ok", "PUBLISHED", "")
        return ("amber", "AWAITING SIGNING", "")
    detail = stage_detail(obj, FAIL_STATUSES)
    if not detail:
        detail = fallback_detail(obj) or "failed (no detail recorded)"
    return ("failed", "FAILED", detail)


def _is_stalled(ref):
    """True when an unfinished row's reference timestamp is over 2h old."""
    if not ref:
        return False
    try:
        import time as _time
        import calendar as _cal
        now = _cal.timegm(_time.gmtime())
        then = _cal.timegm(_time.strptime(str(ref)[:19], "%Y-%m-%dT%H:%M:%S"))
        return (now - then) > 7200
    except (ValueError, OverflowError):
        return False


def _is_recent(ref, days=7):
    """True when the ISO UTC timestamp is within the last days."""
    if not ref:
        return False
    try:
        import time as _time
        import calendar as _cal
        now = _cal.timegm(_time.gmtime())
        then = _cal.timegm(_time.strptime(str(ref)[:19], "%Y-%m-%dT%H:%M:%S"))
        return 0 <= (now - then) <= days * 86400
    except (ValueError, OverflowError):
        return False


def effective(row, repo_map, req_map, blocked_pkgs):
    """Effective package state: requested NVR + actual repository
    publication + the queue attempt - never the latest row alone.

    Returns (css class, state text, detail, note). repo_map maps
    package -> (repo newest NVR, published_at); req_map maps package
    -> requested NVR; either may be empty (dimensions read "unknown",
    the row verdict still stands). blocked_pkgs names packages with
    any BLOCKED row (relevant context for QUEUED latest rows).
    Classes: failed/interrupted (red), blocked/stalled/amber (amber),
    ok (green), refused (hatched), stale (grey reference).
    """
    cls, text, detail = classify(row)
    package = row[0]
    nvr = row_nvr(row)
    note = ""
    req = req_map.get(package, "")
    repo = repo_map.get(package)
    # Exact-NVR publication wins over any row state, whether the
    # queue stamped it or the repository alone knows it (direct
    # sign-apk-repo publishes without touching the queue).
    if nvr and (row[12] or (repo and repo[0] == "%s-%s" % (package, nvr))):
        if text != "PUBLISHED" or not row[12]:
            note = "succeeded (NVR live in repository)"
        return ("ok", "PUBLISHED", detail, note)
    if cls == "failed" and req and nvr and req != nvr:
        return ("stale", "STALE",
                detail, "failed %s; recipe now requests %s" % (nvr, req))
    if text in ("QUEUED", "RUNNING") and package in blocked_pkgs:
        note = "latest attempt %s; older BLOCKED rows on record" % text
    if text == "BLOCKED" and req:
        note = "requested %s" % req
    return (cls, text, detail, note)


def nvr_published_in_db(conn, package, version, revision):
    """True when any row carries this exact NVR with published_at set.

    Queue-only published-NVR rule: a BLOCKED/FAIL latest row whose exact
    NVR is already published elsewhere in this database is succeeded work,
    not outstanding. Same-NVR only: a failed r4 is never hidden by a
    published r1."""
    try:
        hit = conn.execute(
            "SELECT 1 FROM builds WHERE package=? AND version=? AND revision=?"
            " AND published_at IS NOT NULL LIMIT 1",
            (package, version, revision),
        ).fetchone()
        return bool(hit)
    except sqlite3.Error:
        return False


DOT = '<span class="dot %s">●</span>'


def hide_superseded_failures(rows, ctx):
    """Drop FAILED/BLOCKED/INTERRUPTED/STALE rows a newer success supersedes.

    Success and staleness come from effective(): PUBLISHED or AWAITING
    SIGNING counts as success; STALE means the recipe moved past the
    attempt (kept when nothing newer succeeded, greyed as reference).
    Queued, running, stalled and refused rows never hide anything.
    """
    newest_success = {}
    for row in rows:
        cls, state_text, _, _ = effective(
            row, ctx["repo"], ctx["req"], ctx["blocked"])
        finished = row[10]
        if finished is None:
            continue
        if cls == "ok" or state_text == "AWAITING SIGNING":
            prev = newest_success.get(row[0])
            if prev is None or finished > prev:
                newest_success[row[0]] = finished
    kept, hidden = [], 0
    for row in rows:
        cls, _, _, _ = effective(
            row, ctx["repo"], ctx["req"], ctx["blocked"])
        finished = row[10]
        if (cls in ("failed", "blocked", "interrupted", "stale") and finished is not None
                and row[0] in newest_success
                and finished < newest_success[row[0]]):
            hidden += 1
            continue
        kept.append(row)
    return kept, hidden


OUTSTANDING_SQL = (
    "SELECT " + COLUMNS + " FROM builds "
    "WHERE id IN (SELECT max(id) FROM builds GROUP BY package) "
    "ORDER BY package"
)


def outstanding_rows(conn, ctx):
    """Currently-unresolved latest-per-package rows.

    Four buckets, never folded together: terminal failures with no
    later success (FAILED, incl. regressions), waiting work
    (BLOCKED, INTERRUPTED, STALLED), stale verification (AWAITING
    SIGNING over 24h), and stale recipe attempts (STALE: the recipe
    moved past the failure - reference, not outstanding). A row whose
    exact NVR is published is succeeded work, not outstanding
    (same-NVR only; the repository map covers publishes the queue
    never stamped). Successful builds do not imply signed, published,
    verified or task-complete: PUB/Signoff stays per-row."""
    kept = []
    for row in conn.execute(OUTSTANDING_SQL).fetchall():
        package, version, revision = row[0], row[1], row[2]
        cls, state_text, _, _ = effective(
            row, ctx["repo"], ctx["req"], ctx["blocked"])
        if cls == "ok" or state_text in ("QUEUED", "RUNNING"):
            if state_text in ("QUEUED", "RUNNING") and cls == "stalled":
                pass
            else:
                continue
        if cls == "refused":
            continue
        if nvr_published_in_db(conn, package, version, revision):
            continue
        if state_text == "AWAITING SIGNING" and not _stale_awaiting(row[10]):
            continue
        kept.append(row)
    kept, _ = hide_superseded_failures(kept, ctx)
    return kept


def bucket_of(row, ctx):
    """Sort key for outstanding ordering: needs-attention first."""
    cls, state_text, _, _ = effective(
        row, ctx["repo"], ctx["req"], ctx["blocked"])
    if cls in ("failed", "interrupted"):
        return 0
    if cls in ("blocked", "stalled"):
        return 1
    if state_text == "AWAITING SIGNING":
        return 2
    return 3


def _stale_awaiting(finished):
    """True when an AWAITING SIGNING row finished over 24h ago."""
    if not finished:
        return True
    try:
        import time as _time
        import calendar as _cal
        now = _cal.timegm(_time.gmtime())
        then = _cal.timegm(_time.strptime(str(finished)[:19], "%Y-%m-%dT%H:%M:%S"))
        return (now - then) > 86400
    except (ValueError, OverflowError):
        return True


def render_table(rows, ctx):
    out = [
        "<table><tr><th></th><th>package</th><th>nvr</th><th>state</th>"
        "<th>detail</th><th>requested</th><th>repo newest</th>"
        "<th>wall</th><th>cpu</th><th>rss MB</th>"
        "<th>arch</th><th>builder</th><th>finished (UTC)</th></tr>"
    ]
    for row in rows:
        package, version, revision = row[0], row[1], row[2]
        wall, cpu, rss, arch, host = row[5], row[6], row[7], row[8], row[9]
        finished = row[10]
        cls, state_text, detail, note = effective(
            row, ctx["repo"], ctx["req"], ctx["blocked"])
        if note:
            detail = (detail + " [" + note + "]") if detail else note
        req = ctx["req"].get(package, "-")
        repo = ctx["repo"].get(package, ("-", ""))[0]
        if cls == "ok":
            dot_cls = "green"
        elif cls in ("amber", "blocked", "stalled"):
            dot_cls = "amber"
        elif cls == "stale":
            dot_cls = "stale"
        else:
            dot_cls = "red"
        finished_text = "running" if finished is None else cell(finished)
        out.append(
            "<tr class=\"%s\"><td>%s</td><td>%s</td><td>%s-r%s</td>"
            "<td>%s</td><td>%s</td><td>%s</td><td>%s</td>"
            "<td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td>"
            "<td>%s</td></tr>"
            % (cls, DOT % dot_cls, cell(package), cell(version),
               cell(revision), cell(state_text), cell(detail),
               cell(req), cell(repo),
               cell(wall), cell(cpu), cell(rss), cell(arch), cell(host),
               finished_text)
        )
    out.append("</table>")
    return "".join(out)


def render_sbu(conn):
    """Active SBU baselines, or an explicit note when there are none."""
    tables = conn.execute(
        "SELECT name FROM sqlite_master"
        " WHERE type='table' AND name='sbu_baseline'"
    ).fetchall()
    if not tables:
        return ("<p>No sbu_baseline table in this database: "
                "no calibration has been recorded.</p>")
    try:
        cur = conn.execute(
            "SELECT package, version, revision, arch, builder_host,"
            " cache_policy, wall_s, cpu_s, calibrated_at"
            " FROM sbu_baseline WHERE active=1"
            " ORDER BY package, arch, builder_host"
        )
        rows = cur.fetchall()
    except sqlite3.Error as exc:
        return "<p>Could not read sbu_baseline: %s</p>" % cell(exc)
    if not rows:
        return ("<p>sbu_baseline exists but holds no active row: "
                "no calibration has been recorded.</p>")
    out = ["<table><tr><th>package</th><th>nvr</th><th>arch</th>"
           "<th>builder</th><th>cache</th><th>wall</th><th>cpu</th>"
           "<th>calibrated (UTC)</th></tr>"]
    for (package, version, revision, arch, host,
         policy, wall, cpu, calibrated) in rows:
        out.append(
            "<tr><td>%s</td><td>%s-r%s</td><td>%s</td><td>%s</td>"
            "<td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>"
            % (cell(package), cell(version), cell(revision), cell(arch),
               cell(host), cell(policy), cell(wall), cell(cpu),
               cell(calibrated))
        )
    out.append("</table>")
    return "".join(out)


def summarize(rows, ctx):
    """(red, amber, green, refused, stale, recent_red) for one view.

    Effective-state classes: failed/interrupted read red (recent_red
    counts those finished within 7 days); blocked/stalled/amber read
    amber; stale reads stale (reference, never attention); refused and
    green as before. Red/green/refused/stale count distinct packages
    over the rows shown (superseded rows are already hidden upstream,
    so red reads current state); amber counts live rows."""
    red, green, refused, stale = set(), set(), set(), set()
    recent_red = set()
    amber = 0
    for row in rows:
        cls, _, _, _ = effective(
            row, ctx["repo"], ctx["req"], ctx["blocked"])
        if cls in ("failed", "interrupted"):
            red.add(row[0])
            if _is_recent(row[10]):
                recent_red.add(row[0])
        elif cls == "refused":
            refused.add(row[0])
        elif cls in ("amber", "blocked", "stalled"):
            amber += 1
        elif cls == "stale":
            stale.add(row[0])
        else:
            green.add(row[0])
    return len(red), amber, len(green), len(refused), len(stale), len(recent_red)


def render_counts(red, amber, green, refused, scope, stale=0, recent_red=0):
    extra = ""
    if recent_red or stale:
        extra = " (%d recent" % recent_red
        if stale:
            extra += ", +%d stale (recipe moved on)" % stale
        extra += ")"
    return (
        '<p class="counts">'
        '<span class="dot red">●</span> %d failed %s%s · '
        '<span class="dot amber">●</span> %d pending / running / '
        "awaiting signing · "
        '<span class="dot green">●</span> %d published · '
        "%d refused (never built)</p>"
        % (red, scope, extra, amber, green, refused)
    )


def view_ctx(conn, recipes_dir, repo_dir):
    """Join context for one render: blocked packages plus the optional
    recipe/repository dimensions. Empty maps keep the queue-only
    verdict (row state stands; requested/repo read unknown)."""
    blocked = {r[0] for r in conn.execute(
        "SELECT DISTINCT package FROM builds WHERE state='BLOCKED'")}
    return {"repo": load_repo_map(repo_dir),
            "req": load_req_map(recipes_dir),
            "blocked": blocked}


def render_view(db_path, today, recipes_dir="", repo_dir=""):
    conn = open_db(db_path)
    try:
        ctx = view_ctx(conn, recipes_dir, repo_dir)
        if today:
            rows = conn.execute(TODAY_SQL).fetchall()
            rows, hidden = hide_superseded_failures(rows, ctx)
            _s = summarize(rows, ctx)
            counts = render_counts(_s[0], _s[1], _s[2], _s[3], "today",
                                   stale=_s[4], recent_red=_s[5])
            head = "<h1>TODAY</h1>" + counts
            nav = ('<nav><strong>TODAY</strong>'
                   '<a href="/outstanding">Outstanding</a>'
                   '<a href="/history">History</a></nav>')
            body = head + nav + render_table(rows, ctx)
        else:
            total = conn.execute("SELECT COUNT(*) FROM builds").fetchone()[0]
            rows = conn.execute(HISTORY_SQL).fetchall()
            rows, hidden = hide_superseded_failures(rows, ctx)
            _s = summarize(rows, ctx)
            counts = render_counts(_s[0], _s[1], _s[2], _s[3], "shown",
                                   stale=_s[4], recent_red=_s[5])
            head = ("<h1>History</h1><p>Newest %d of %d recorded "
                    "builds" % (len(rows), total))
            if hidden:
                head += " (%d superseded %s hidden)" % (
                    hidden, "failure" if hidden == 1 else "failures")
            head += ".</p>" + counts
            nav = ('<nav><a href="/">TODAY</a>'
                   '<a href="/outstanding">Outstanding</a>'
                   '<strong>History</strong></nav>')
            body = (head + nav + render_table(rows, ctx) +
                    "<h2>SBU baselines</h2>" + render_sbu(conn))
        legend = (
            '<p class="legend">State is effective: requested recipe NVR + '
            "actual repository publication + the queue attempt - never the "
            "latest row alone (requested/repo columns read unknown without "
            "--recipes-dir/--repo-dir; the MCP joins all three). Red rows "
            "FAILED/INTERRUPTED: the build ran and "
            "failed (or died mid-flight) and no newer build has succeeded since; the failed "
            "stage is named in detail. Grey rows STALE: the attempt failed for "
            "an NVR the recipe has moved past (reference, not outstanding). "
            "Failures a later build fixed are "
            "hidden as superseded (counted in the header above). Amber rows "
            "BLOCKED/STALLED: waiting on dependencies or no progress over 2h, "
            "never failures. Hatched "
            "rows REFUSED: never built - refused before building, reason "
            "shown. Amber: queued, running, or built but awaiting "
            "signing. Green: built, signed and published. A refusal is "
            "the absence of a build, never a failure. <a href=\"/outstanding\">"
            "Outstanding</a> orders needs-attention first: failed, waiting, "
            "stale awaiting-signing, then stale recipe attempts.</p>"
        )
        return body + legend
    finally:
        conn.close()


def render_outstanding(db_path, recipes_dir="", repo_dir=""):
    """Standalone outstanding view: currently-unresolved work only.

    No MCP dependency. Buckets stay separate and ordered by priority:
    terminal failures (FAILED/INTERRUPTED with no later success),
    waiting work (BLOCKED/STALLED), stale verification (AWAITING
    SIGNING over 24h), stale recipe attempts (reference only). A row
    whose exact NVR is published is succeeded work, never listed.
    Successful builds do not imply signed, published, verified or
    task-complete: PUB/Signoff stays per-row. Complete history stays
    in /history; the header keeps the totals."""
    conn = open_db(db_path)
    try:
        ctx = view_ctx(conn, recipes_dir, repo_dir)
        rows = outstanding_rows(conn, ctx)
        # Needs-attention first, most-recent first within a bucket
        # (unfinished rows sort before dated ones).
        rows = sorted(rows, key=lambda r: (
            bucket_of(r, ctx),
            r[10] is not None,
            r[10] or ""))
        by_bucket = {"failed": [], "waiting": [], "awaiting": [],
                     "stale": []}
        for row in rows:
            cls, state_text, _, _ = effective(
                row, ctx["repo"], ctx["req"], ctx["blocked"])
            if cls in ("failed", "interrupted"):
                by_bucket["failed"].append(row)
            elif state_text == "AWAITING SIGNING":
                by_bucket["awaiting"].append(row)
            elif cls == "stale":
                by_bucket["stale"].append(row)
            else:
                by_bucket["waiting"].append(row)
        red, amber, green, refused, stale, recent = summarize(rows, ctx)
        counts = render_counts(red, amber, green, refused,
                               "outstanding", stale, recent)
        head = ("<h1>Outstanding</h1><p>Currently-unresolved work only, "
                "needs-attention first: "
                "%d failed (%d recent), %d waiting (blocked/interrupted/stalled), "
                "%d stale awaiting signing, +%d stale recipe attempts (reference).</p>" % (
                    len(by_bucket["failed"]),
                    sum(1 for r in by_bucket["failed"] if _is_recent(r[10])),
                    len(by_bucket["waiting"]),
                    len(by_bucket["awaiting"]),
                    len(by_bucket["stale"])) + counts)
        nav = ('<nav><a href="/">TODAY</a>'
               '<strong>Outstanding</strong>'
               '<a href="/history">History</a></nav>')
        return head + nav + render_table(rows, ctx)
    finally:
        conn.close()


class IPv4Server(http.server.ThreadingHTTPServer):
    # IPv4 by agreement: pin the family so this listener can never
    # silently become a dual-stack socket.
    address_family = socket.AF_INET


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "saphira-build-dashboard"
    sys_version = ""

    def __init__(self, *args, db_path=None, recipes_dir="",
                   repo_dir="", **kwargs):
        self.db_path = db_path
        self.recipes_dir = recipes_dir
        self.repo_dir = repo_dir
        super().__init__(*args, **kwargs)

    def log_message(self, fmt, *args):
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def _send_page(self, title, body, status=200, head_only=False):
        page = ("<!DOCTYPE html><html><head><meta charset=\"utf-8\">"
                "<title>%s</title><style>%s</style></head>"
                "<body>%s</body></html>"
                % (html.escape(title), CSS, body))
        data = page.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if not head_only:
            self.wfile.write(data)

    def _serve(self, head_only):
        path = self.path.split("?", 1)[0]
        try:
            if path == "/":
                self._send_page("TODAY - build dashboard",
                                render_view(self.db_path, today=True,
                                            recipes_dir=self.recipes_dir,
                                            repo_dir=self.repo_dir),
                                head_only=head_only)
            elif path == "/outstanding":
                self._send_page("Outstanding - build dashboard",
                                render_outstanding(self.db_path,
                                                   recipes_dir=self.recipes_dir,
                                                   repo_dir=self.repo_dir),
                                head_only=head_only)
            elif path == "/history":
                self._send_page("History - build dashboard",
                                render_view(self.db_path, today=False,
                                            recipes_dir=self.recipes_dir,
                                            repo_dir=self.repo_dir),
                                head_only=head_only)
            else:
                self._send_page("Not found", "<h1>404</h1>"
                                "<p>No such view. <a href=\"/\">TODAY</a> "
                                "<a href=\"/history\">History</a></p>",
                                status=404, head_only=head_only)
        except sqlite3.Error as exc:
            self._send_page("Database error",
                            "<h1>500</h1><p>Could not read the queue "
                            "database: %s</p>" % cell(exc),
                            status=500, head_only=head_only)

    def do_GET(self):
        self._serve(head_only=False)

    def do_HEAD(self):
        self._serve(head_only=True)

    def _refuse(self):
        self.send_response(405)
        self.send_header("Allow", "GET, HEAD")
        self.send_header("Content-Length", "0")
        self.end_headers()

    # Read-only surface: anything that is not a read is refused.
    do_POST = _refuse
    do_PUT = _refuse
    do_DELETE = _refuse
    do_PATCH = _refuse
    do_OPTIONS = _refuse
    do_TRACE = _refuse


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Read-only build-queue dashboard (TODAY/History).")
    parser.add_argument("--bind", default=DEFAULT_BIND,
                        help="IPv4 address to bind (default %(default)s)")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT,
                        help="port to listen on (default %(default)s)")
    parser.add_argument("--db", default=DEFAULT_DB,
                        help="queue database path (default %(default)s)")
    parser.add_argument("--recipes-dir", default="",
                        help="recipe tree for the requested-NVR column"
                        " (default disabled: reads unknown)")
    parser.add_argument("--repo-dir", default="",
                        help="repository dir for the repo-newest column"
                        " (default disabled: reads unknown)")
    args = parser.parse_args(argv)
    if not 1 <= args.port <= 65535:
        parser.error("port must be 1-65535")
    handler = functools.partial(Handler, db_path=args.db,
                                recipes_dir=args.recipes_dir,
                                repo_dir=args.repo_dir)
    # A bind failure raises here and exits non-zero: loud, and never a
    # silent fallback to another address.
    server = IPv4Server((args.bind, args.port), handler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
