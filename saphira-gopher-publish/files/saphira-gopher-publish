def load_root_include(path: Path, gopher_host: str, gopher_port: int) -> tuple[list[str], list[str], set[str]]:
    """Load optional root include (classic gophermap format).

    Returns (classic_lines, native_lines, curated_selectors).
    Classic lines are used verbatim for gophermap; native lines are converted
    for index.gph (info -> plain text, links -> [type|display|selector|host|port]).
    """
    classic_lines: list[str] = []
    native_lines: list[str] = []
    curated: set[str] = set()
    try:
        raw = path.read_text(encoding="utf-8").splitlines()
    except Exception as e:
        raise RuntimeError(f"failed to read --root-include {path}: {e}") from e
    for raw_line in raw:
        # Preserve leading spaces after type char; do not strip line entirely
        # Keep line as is except remove trailing \r
        line = raw_line.rstrip("\r\n")
        if line == "" or line.startswith("#"):
            # Blank or comment in include -> blank info line in both
            # For classic, blank comment is ignored; for native, emit blank
            continue
        if line.startswith("[") and line.endswith("]"):
            # Already native form -> keep for native, convert to classic
            native_lines.append(line)
            # Convert native "[type|display|selector|host|port]" -> classic "typeDisplay<TAB>selector"
            inner = line[1:-1]
            parts = inner.split("|")
            if len(parts) >= 3:
                t, d, s = parts[0], parts[1], parts[2]
                # For classic, host/port empty
                if t == "i":
                    # info native -> classic i line: display is d (if blank -> just "i")
                    if d.strip() == "" or d == "Err":
                        classic_lines.append("i")
                    else:
                        classic_lines.append(f"i{d}")
                else:
                    # link
                    classic_lines.append(f"{t}{d}\t{s}")
                    if s.startswith("URL:"):
                        curated.add(s)
                    else:
                        curated.add(s)
            else:
                classic_lines.append(line)
            continue
        # Classic format: first char is type, rest up to tab is display
        if not line:
            continue
        t = line[0]
        # Split on tab to get display+selector
        if "\t" in line:
            first, rest = line.split("\t", 1)
            display = first[1:]  # after type
            # rest may contain selector plus host/port tabs, we keep selector as first field
            selector = rest.split("\t")[0]
        else:
            # No tab: e.g. "i" or "i   text" with no selector
            display = line[1:]
            selector = ""
        # For classic, keep verbatim
        classic_lines.append(line)
        # For native, convert
        if t == "i":
            # Informational: plain text without brackets (geomyidae native treats any non-"[" line as info)
            # Preserve display exactly (including leading spaces for centering)
            if display.strip() == "":
                # blank info -> empty line or [i||Err||] for explicit blank
                native_lines.append("")
            else:
                # Plain informational line (no brackets)
                native_lines.append(display)
        elif t in "0123456789ghH":
            d = display.strip()
            s = selector.strip()
            if s == "":
                s = "Err"
            native_lines.append(f"[{t}|{gopher_escape(d)}|{s}|{gopher_host}|{gopher_port}]")
            curated.add(s)
        elif t == "h":
            d = display.strip()
            s = selector.strip()
            if s == "":
                s = "URL:"
            native_lines.append(f"[h|{gopher_escape(d)}|{s}|{gopher_host}|{gopher_port}]")
            curated.add(s)
        else:
            # Unknown type -> treat as info plain
            native_lines.append(display)
    return classic_lines, native_lines, curated


def build_tree(root_url: str, output_dir: Path, gopher_host: str, gopher_port: int, timeout: int, dry_run: bool, root_include: Path | None = None, chown_user: str | None = None, chown_group: str | None = None) -> dict:
    root_origin = origin_of(root_url)
    # Ensure root_url canonical with trailing slash for origin
    if not root_url.endswith("/"):
        root_url_canonical = root_url + "/"
    else:
        root_url_canonical = root_url

    print(f"fetching sitemap from {root_url_canonical}sitemap.xml ...", file=sys.stderr)
    sitemap_urls = fetch_sitemap(root_url_canonical, timeout)
    print(f"sitemap: {len(sitemap_urls)} URLs", file=sys.stderr)

    # Fetch each page's markdown
    pages: list[dict] = []
    seen_selectors: dict[str, str] = {}  # selector -> url (detect collision)
    skipped: list[str] = []
    for url in sitemap_urls:
        # sitemap may include query? Keep as is
        # Skip non-eligible? Keep all same-origin; but skip if url is sitemap.xml itself (not in locs anyway)
        # Skip if path is /sitemap.xml etc — but not in list
        print(f"  GET {url}  Accept: text/markdown", file=sys.stderr)
        try:
            body, final_url, ctype = fetch_url(url, root_origin, timeout, accept_markdown=True)
        except RuntimeError as e:
            msg = str(e)
            # POST-only endpoints like /mcp return 405; skip with warning, don't abort whole tree.
            # The sitemap is authoritative but includes such routes (collectPublicPaths).
            # Skipping 405/404 is more useful than failing the entire publish.
            if "HTTP 405" in msg or "HTTP 404" in msg:
                print(f"  skip {url}: {msg} (non-GET route)", file=sys.stderr)
                skipped.append(url)
                continue
            raise
        # Validate content-type is text/markdown (allow charset suffix)
        if "text/markdown" not in ctype.lower():
            # Some endpoints might return text/markdown; charset=utf-8
            # If server returns something else, it's an error — fail loudly
            # Allow text/markdown; charset=utf-8 or similar
            # If ctype is empty, treat as failure unless body looks like markdown
            # Strict: require text/markdown
            # However 405 endpoints already handled above; other non-markdown types skip with warning
            if ctype.lower().startswith("text/plain") and "Method Not Allowed" in body.decode("utf-8", errors="replace"):
                print(f"  skip {url}: {ctype!r} Method Not Allowed (POST-only)", file=sys.stderr)
                skipped.append(url)
                continue
            raise RuntimeError(f"unexpected Content-Type for {url}: {ctype!r} (expected text/markdown)")
        md = body.decode("utf-8", errors="replace")
        if not md.strip():
            raise RuntimeError(f"empty markdown body for {url}")
        plain, internal_sels, external_urls = markdown_to_plain(md, final_url, root_origin)
        # Use original sitemap URL for selector to preserve hierarchy even when server 307-redirects
        # (e.g. /packagerepository/systemd -> 307 /packagerepository). Final_url is kept for Source header.
        rel_path, selector = url_to_file_info(url, None)
        # Detect selector collision (two URLs mapping to same file via original URL)
        if selector in seen_selectors and seen_selectors[selector] != url:
            counter = 2
            while selector in seen_selectors:
                sel_base, ext = os.path.splitext(selector)
                selector = f"{sel_base}-{counter}{ext}"
                rel_path = selector.lstrip("/")
                counter += 1
                if counter > 10:
                    raise RuntimeError(f"selector collision for {url} vs {seen_selectors[selector]}")
        seen_selectors[selector] = url
        if final_url != url:
            print(f"  note {url} -> {final_url} (redirect, keeping selector {selector})", file=sys.stderr)

        # Title
        fallback = os.path.splitext(os.path.basename(rel_path))[0].replace("-", " ").replace("_", " ").title()
        if rel_path == "index.txt":
            fallback = "Home"
        title = title_from_markdown(md, fallback, url)

        pages.append({
            "url": final_url,
            "original_url": url,
            "rel_path": rel_path,
            "selector": selector,
            "title": title,
            "md": md,
            "plain": plain,
            "internal": internal_sels,
            "external": external_urls,
        })

    # Sort pages deterministically by selector
    pages.sort(key=lambda p: p["selector"])
    if skipped:
        print(f"skipped {len(skipped)} non-GET sitemap entries: {', '.join(skipped)}", file=sys.stderr)

    # Build directory structure
    # dirs: dict[dir_rel -> {files: [], subdirs:set, externals:set}]
    dirs: dict[str, dict] = defaultdict(lambda: {"files": [], "subdirs": set(), "externals": set()})
    # Ensure root dir exists
    dirs[""]  # create

    for p in pages:
        rel = p["rel_path"]
        # dir is parent of file
        dir_rel = os.path.dirname(rel)
        # normalize "" for root
        dirs[dir_rel]["files"].append(p)
        for ext in p["external"]:
            dirs[dir_rel]["externals"].add(ext)
        # Also propagate externals to root? Keep per-dir only

    # Add subdirs for intermediate dirs
    all_dirs = set(dirs.keys())
    # Ensure every parent dir exists
    for d in list(all_dirs):
        parts = Path(d).parts if d else []
        for i in range(len(parts)):
            parent = os.path.join(*parts[:i]) if i > 0 else ""
            child = parts[i]
            dirs[parent]["subdirs"].add(child)
            # ensure child dir entry exists
            child_full = os.path.join(parent, child) if parent else child
            if child_full not in dirs:
                dirs[child_full] = {"files": [], "subdirs": set(), "externals": set()}
                all_dirs.add(child_full)

    # For determinism, sort everything
    for d in dirs.values():
        d["files"].sort(key=lambda f: f["selector"])
        d["externals"] = sorted(d["externals"])
        d["subdirs"] = sorted(d["subdirs"])

    # Prepare optional root include (generic publisher, site-owned file)
    # e.g. /etc/saphira/gopher-home.conf or /srv/gopher-source/root-menu.include
    root_classic_inc: list[str] = []
    root_native_inc: list[str] = []
    root_curated: set[str] = set()
    if root_include is not None:
        if not root_include.is_file():
            raise RuntimeError(f"--root-include not found: {root_include}")
        root_classic_inc, root_native_inc, root_curated = load_root_include(root_include, gopher_host, gopher_port)
        print(f"root include: {root_include} ({len(root_classic_inc)} lines, {len(root_curated)} curated selectors)", file=sys.stderr)

    # Now write to temp dir unless dry-run
    tmp_root: Path | None = None
    if dry_run:
        print(f"\nDry-run: would write {len(pages)} pages to {output_dir}", file=sys.stderr)
        if root_include is not None:
            print(f"  root include: {root_include} -> {len(root_classic_inc)} classic / {len(root_native_inc)} native lines", file=sys.stderr)
        for p in pages:
            print(f"  {p['selector']}  <= {p['url']}  \"{p['title']}\"")
        for d in sorted(dirs.keys()):
            print(f"  dir /{d} : {len(dirs[d]['files'])} files, {len(dirs[d]['subdirs'])} subdirs, {len(dirs[d]['externals'])} externals", file=sys.stderr)
        return {"pages": pages, "dirs": dirs}

    tmp_root = Path(tempfile.mkdtemp(prefix="saphira-gopher-"))
    try:
        for p in pages:
            out_path = tmp_root / p["rel_path"]
            out_path.parent.mkdir(parents=True, exist_ok=True)
            header = f"{p['title']}\n{'='*len(p['title'])}\n\nSource: {p['url']}\n\n"
            content = header + p["plain"]
            if not content.endswith("\n"):
                content += "\n"
            out_path.write_text(content, encoding="utf-8")

        # Write menus for every directory: both classic gophermap (geomyidae 0.99
        # deployment) and native index.gph ([1|...] syntax). They share the
        # same entries, only the serialization differs. Classic gophermap
        # leaves host/port empty so geomyidae fills its own address.
        for dir_rel in sorted(dirs.keys()):
            dir_path = tmp_root / dir_rel if dir_rel else tmp_root
            dir_path.mkdir(parents=True, exist_ok=True)

            entries = []

            # 1 - subdirectories (skip curated at root)
            for sub in dirs[dir_rel]["subdirs"]:
                sub_selector = f"/{dir_rel}/{sub}/" if dir_rel else f"/{sub}/"
                sub_selector = sub_selector.replace("//", "/")
                if dir_rel == "" and sub_selector in root_curated:
                    continue
                display = gopher_escape(sub.replace("-", " ").replace("_", " ").title())
                if not display:
                    display = sub
                entries.append(("1", display, sub_selector))

            # 0 - files in this directory (skip curated at root)
            for f in dirs[dir_rel]["files"]:
                if dir_rel == "" and f["selector"] in root_curated:
                    continue
                disp = gopher_escape(f["title"])
                entries.append(("0", disp, f["selector"]))

            # h - external links found in this directory's files (skip curated at root)
            for ext in dirs[dir_rel]["externals"]:
                sel = f"URL:{ext}"
                if dir_rel == "" and sel in root_curated:
                    continue
                parsed = urllib.parse.urlparse(ext)
                disp_raw = parsed.netloc + parsed.path
                if len(disp_raw) > 60:
                    disp_raw = disp_raw[:57] + "..."
                disp = gopher_escape(disp_raw or ext)
                entries.append(("h", disp, sel))

            # Native geomyidae index.gph: [type|Display|Selector|Host|Port]
            # For root, prepend include native lines before exhaustive
            native_entries = [f"[{t}|{d}|{s}|{gopher_host}|{gopher_port}]" for t, d, s in entries]
            if dir_rel == "" and root_native_inc:
                native_lines = root_native_inc + native_entries
            else:
                native_lines = native_entries
            native_content = "\n".join(native_lines) + "\n" if native_lines else ""
            (dir_path / "index.gph").write_text(native_content, encoding="utf-8", newline="\n")

            # Classic gophermap: type+Display<TAB>Selector<TAB>Host<TAB>Port
            # For 0.99 deployment leave host/port empty (geomyidae fills).
            def classic_escape(d: str) -> str:
                return d.replace("\t", " ").replace("\r", " ").replace("\n", " ").strip()

            classic_entries = [f"{t}{classic_escape(d)}\t{s}" for t, d, s in entries]
            if dir_rel == "" and root_classic_inc:
                classic_lines = root_classic_inc + classic_entries
            else:
                classic_lines = classic_entries
            classic_content = "\n".join(classic_lines) + "\n" if classic_lines else ""
            (dir_path / "gophermap").write_text(classic_content, encoding="utf-8", newline="\n")

        # Atomic replacement of output_dir
        output_dir = Path(output_dir)
        # Ensure parent exists
        output_dir.parent.mkdir(parents=True, exist_ok=True)
        # If output_dir exists, remove it (disposable)
        if output_dir.exists():
            # Remove atomically via rename to .old then delete?
            # Simpler: shutil.rmtree
            shutil.rmtree(output_dir)
        shutil.move(str(tmp_root), str(output_dir))
        # tmp_root now moved, avoid cleanup
        tmp_root = None
        # Ownership: publisher should own files as gopher:gopher (site policy)
        if chown_user or chown_group:
            u = chown_user or "gopher"
            g = chown_group or "gopher"
            chown_tree(output_dir, u, g)
        elif not dry_run:
            # Default site policy: chown to gopher:gopher if that user exists (best-effort)
            try:
                pwd.getpwnam("gopher")
                grp.getgrnam("gopher")
                chown_tree(output_dir, "gopher", "gopher")
            except KeyError:
                pass
        print(f"wrote {len(pages)} pages, {len(dirs)} directories to {output_dir}", file=sys.stderr)
        return {"pages": pages, "dirs": dirs}
    finally:
        if tmp_root and tmp_root.exists():
            shutil.rmtree(tmp_root, ignore_errors=True)

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="saphira-gopher-publish",
        description=(
            "Walk the Markdown representation of a website and generate a complete "
            "Gopher tree suitable for geomyidae 0.99 (gophermap + index.gph)."
        ),
        epilog=(
            "examples:\n"
            "  saphira-gopher-publish https://saphira.vm2.uk/ ./out\n"
            "  saphira-gopher-publish https://saphira.vm2.uk/ /tmp/gopher-out --gopher-host saphira.vm2.uk --gopher-port 70\n"
            "  saphira-gopher-publish --config /etc/saphira/gopher-publisher.conf\n"
            "  saphira-gopher-publish https://saphira.vm2.uk/ ./out --dry-run --timeout 10\n"
            "\n"
            "The tool fetches sitemap.xml, then GETs each URL with 'Accept: text/markdown',\n"
            "converts Markdown to plain text, and writes:\n"
            "  out/index.txt, out/about.txt, ... and out/**/gophermap (classic) + out/**/index.gph\n"
            "  (geomyidae 0.99: gophermap classic \"1Display<TAB>/selector\" with host/port empty,\n"
            "   plus native index.gph \"[0|Display|/file.txt|host|port]\" etc.)\n"
            "\n"
            "Config file /etc/saphira/gopher-publisher.conf (or gopher/etc/saphira/gopher-publisher.conf\n"
            "next to bin) may set any option: root_url, output_dir, gopher_host, gopher_port,\n"
            "timeout, root_include, user, group. CLI overrides config.\n"
            "Output is disposable; regenerate deterministically. Never appends stale entries.\n"
            "Same-origin redirects only; fail loudly on malformed/unreachable source.\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("root_url", nargs="?", default=None, help="website root URL, e.g. https://saphira.vm2.uk/ (or in config)")
    parser.add_argument("output_dir", nargs="?", default=None, help="output directory (disposable, atomically replaced) (or in config)")
    parser.add_argument("--config", metavar="FILE", help="publisher config file (default: /etc/saphira/gopher-publisher.conf or next-to-bin etc/saphira/gopher-publisher.conf)")
    parser.add_argument("--root-url", dest="opt_root_url", metavar="URL", help="override root_url from config")
    parser.add_argument("--output-dir", dest="opt_output_dir", metavar="DIR", help="override output_dir from config")
    parser.add_argument("--gopher-host", default=None, help=f"Gopher host for selectors (default: {DEFAULT_GOPHER_HOST})")
    parser.add_argument("--gopher-port", type=int, default=None, help=f"Gopher port (default: {DEFAULT_GOPHER_PORT})")
    parser.add_argument("--timeout", type=int, default=None, help=f"request timeout seconds (default: {DEFAULT_TIMEOUT})")
    parser.add_argument("--root-include", metavar="FILE", help="optional root menu include (classic gophermap lines) prepended to / (site-owned, e.g. /etc/saphira/gopher-home.conf or /srv/gopher-source/root-menu.include)")
    parser.add_argument("--user", dest="chown_user", metavar="USER", help="output owner user (default: gopher)")
    parser.add_argument("--group", dest="chown_group", metavar="GROUP", help="output owner group (default: gopher)")
    parser.add_argument("--dry-run", action="store_true", help="validate without writing (print inventory)")
    parser.add_argument("--validate", action="store_true", help="alias for --dry-run (validation mode)")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")

    args = parser.parse_args()

    # --validate is alias
    dry = args.dry_run or args.validate

    # Load config file (CLI --config overrides search)
    cfg: dict[str, str] = {}
    cfg_path: Path | None = None
    if args.config:
        cfg_path = Path(args.config)
        if not cfg_path.is_file():
            parser.error(f"--config not found: {cfg_path}")
        cfg = load_publisher_config(cfg_path)
    else:
        for cand in default_config_paths():
            if cand.is_file():
                cfg_path = cand
                try:
                    cfg = load_publisher_config(cand)
                except Exception as e:
                    parser.error(f"failed to read config {cand}: {e}")
                break

    # Explicit --root-url / --output-dir overrides positional
    if args.opt_root_url is not None:
        args.root_url = args.opt_root_url
    if args.opt_output_dir is not None:
        args.output_dir = args.opt_output_dir

    # Single positional with config: treat non-URL arg as output_dir
    if args.root_url is not None and args.output_dir is None and cfg.get("root_url") and cfg.get("output_dir"):
        if not (args.root_url.startswith("http://") or args.root_url.startswith("https://")):
            args.output_dir = args.root_url
            args.root_url = None

    def cfg_or_arg(key: str, arg_val, default=None):
        if arg_val is not None:
            return arg_val
        return cfg.get(key, default)

    # Resolve required positional via config fallback
    root_url = cfg_or_arg("root_url", args.root_url)
    output_dir = cfg_or_arg("output_dir", args.output_dir)
    gopher_host = cfg_or_arg("gopher_host", args.gopher_host, DEFAULT_GOPHER_HOST)
    gopher_port_raw = cfg_or_arg("gopher_port", args.gopher_port, str(DEFAULT_GOPHER_PORT))
    timeout_raw = cfg_or_arg("timeout", args.timeout, str(DEFAULT_TIMEOUT))
    root_include_raw = cfg_or_arg("root_include", args.root_include)
    chown_user = cfg_or_arg("user", args.chown_user, "gopher")
    chown_group = cfg_or_arg("group", args.chown_group, "gopher")

    try:
        gopher_port = int(gopher_port_raw)  # type: ignore
        timeout = int(timeout_raw)  # type: ignore
    except ValueError as e:
        parser.error(f"invalid numeric config: {e}")

    if not root_url or not output_dir:
        parser.error("root_url and output_dir are required (positional or in config)")

    # Validate root_url
    try:
        parsed = urllib.parse.urlparse(root_url)
        if parsed.scheme not in ("http", "https") or not parsed.netloc:
            parser.error(f"root_url must be http(s) URL, got {root_url!r}")
        if gopher_port < 1 or gopher_port > 65535:
            parser.error("gopher-port must be 1..65535")
    except SystemExit:
        raise
    except Exception as e:
        parser.error(str(e))

    try:
        root_inc = Path(root_include_raw) if root_include_raw else None
        build_tree(root_url, Path(output_dir), gopher_host, gopher_port, timeout, dry, root_inc, chown_user, chown_group)
    except Exception as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
