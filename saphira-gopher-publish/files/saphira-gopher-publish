#!/usr/bin/env python3
"""
saphira-gopher-publish — Markdown → geomyidae 0.99 Gopher tree

Consumes the published Markdown interface (Accept: text/markdown) and
produces a geomyidae directory tree with both gophermap (classic,
host/port empty, geomyidae fills) and index.gph (native [type|...]) menus.

Contract:
  saphira-linux-os (website) --build--> https://saphira.vm2.uk/
       -- Accept: text/markdown --> gopher/bin/saphira-gopher-publish
       --> gopher/out/ --rsync --delete--> D2:/srv/gopher/
       --> gopher://saphira.vm2.uk/

Usage:
  saphira-gopher-publish <root-url> <output-dir> [options]

Standards: stdlib only, same-origin, deterministic, atomic replace,
bounded timeout, fail loudly.
"""
from __future__ import annotations

import argparse
import configparser
import os
import pwd
import grp
import re
import shutil
import sys
import tempfile
import textwrap
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path
from collections import defaultdict

VERSION = "0.1.0"

DEFAULT_GOPHER_HOST = "saphira.vm2.uk"
DEFAULT_GOPHER_PORT = 70
DEFAULT_TIMEOUT = 10

USER_AGENT = f"saphira-gopher-publish/{VERSION} (+https://saphira.vm2.uk/)"

# ---------------------------------------------------------------------------
# URL helpers
# ---------------------------------------------------------------------------

def origin_of(url: str) -> str:
    p = urllib.parse.urlparse(url)
    if p.scheme not in ("http", "https"):
        raise ValueError(f"unsupported scheme in URL: {url!r}")
    # normalize: lower host, strip default port, no trailing slash
    host = p.hostname.lower() if p.hostname else ""
    port = f":{p.port}" if p.port and p.port not in (80, 443) else ""
    return f"{p.scheme}://{host}{port}"

def normalize_url(url: str) -> str:
    """Canonical form without fragment, without trailing slash except root."""
    p = urllib.parse.urlparse(url)
    # drop fragment
    path = p.path or "/"
    # norm path: collapse //, resolve . and ..
    # posix norm but keep leading /
    import posixpath
    path = posixpath.normpath(path)
    if not path.startswith("/"):
        path = "/" + path
    # preserve trailing slash only for explicit dir? sitemap has no //
    # we keep as normpath gives without trailing slash except root
    # keep query if any (but sitemap has none)
    q = f"?{p.query}" if p.query else ""
    return f"{p.scheme}://{p.hostname.lower()}{f':{p.port}' if p.port else ''}{path}{q}"

def is_same_origin(url: str, root_origin: str) -> bool:
    try:
        return origin_of(url) == root_origin
    except ValueError:
        return False

# ---------------------------------------------------------------------------
# HTTP with Accept: text/markdown and same-origin redirect enforcement
# ---------------------------------------------------------------------------

class SameOriginRedirectHandler(urllib.request.HTTPRedirectHandler):
    def __init__(self, root_origin: str):
        super().__init__()
        self.root_origin = root_origin

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        # urllib gives newurl as possibly relative; resolve
        resolved = urllib.parse.urljoin(req.full_url, newurl)
        if not is_same_origin(resolved, self.root_origin):
            raise urllib.error.URLError(
                f"redirect to different origin rejected: {req.full_url} -> {resolved}"
            )
        return super().redirect_request(req, fp, code, msg, headers, newurl)

def fetch_url(url: str, root_origin: str, timeout: int, accept_markdown: bool = True) -> tuple[bytes, str, str]:
    """
    Returns (body_bytes, final_url, content_type).
    Raises on failure. Enforces same-origin redirects only.
    """
    headers = {
        "User-Agent": USER_AGENT,
    }
    if accept_markdown:
        headers["Accept"] = "text/markdown"
    req = urllib.request.Request(url, headers=headers, method="GET")
    handler = SameOriginRedirectHandler(root_origin)
    opener = urllib.request.build_opener(handler)
    try:
        with opener.open(req, timeout=timeout) as resp:
            body = resp.read()
            final_url = resp.geturl()  # after redirects
            ctype = resp.headers.get_content_type() if hasattr(resp.headers, "get_content_type") else resp.headers.get("Content-Type", "")
            # also check header string fallback
            if not ctype:
                ctype = resp.headers.get("Content-Type", "")
            # enforce same-origin on final
            if not is_same_origin(final_url, root_origin):
                raise RuntimeError(f"final URL escaped origin: {url} -> {final_url}")
            status = getattr(resp, "status", 200)
            if status >= 400:
                raise RuntimeError(f"HTTP {status} for {url}")
            return body, final_url, ctype
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"HTTP {e.code} {e.reason} for {url}") from e
    except urllib.error.URLError as e:
        raise RuntimeError(f"fetch failed for {url}: {e.reason}") from e
    except Exception as e:
        if isinstance(e, RuntimeError):
            raise
        raise RuntimeError(f"fetch failed for {url}: {e}") from e

def fetch_sitemap(root_url: str, timeout: int) -> list[str]:
    p = urllib.parse.urlparse(root_url)
    # ensure root ends with /
    if not root_url.endswith("/"):
        root_url = root_url + "/"
    sitemap_url = urllib.parse.urljoin(root_url, "sitemap.xml")
    root_origin = origin_of(root_url)
    # sitemap is application/xml, not markdown — fetch without Accept markdown
    body, final_url, ctype = fetch_url(sitemap_url, root_origin, timeout, accept_markdown=False)
    text = body.decode("utf-8", errors="replace")
    # parse <loc>
    # use regex for robustness (namespace)
    locs = re.findall(r"<loc>\s*([^<\s]+)\s*</loc>", text)
    if not locs:
        # try ET with namespace
        try:
            root_el = ET.fromstring(text)
            ns = {"sm": "http://www.sitemaps.org/schemas/sitemap/0.9"}
            locs = [e.text.strip() for e in root_el.findall(".//sm:loc", ns) if e.text]
            if not locs:
                locs = [e.text.strip() for e in root_el.findall(".//loc") if e.text]
        except Exception:
            pass
    if not locs:
        raise RuntimeError(f"sitemap at {sitemap_url} contained no <loc> entries")
    # dedup preserve order, filter same-origin only
    seen = set()
    out = []
    for loc in locs:
        loc = loc.strip()
        n = normalize_url(loc)
        if n in seen:
            continue
        if not is_same_origin(n, root_origin):
            continue
        seen.add(n)
        out.append(n)
    out.sort()
    return out

# ---------------------------------------------------------------------------
# Markdown helpers
# ---------------------------------------------------------------------------

_LINK_RE = re.compile(r"\[([^\]]*)\]\(([^)]+)\)")
_IMAGE_RE = re.compile(r"!\[([^\]]*)\]\(([^)]+)\)")
_CODE_FENCE_RE = re.compile(r"```([^\n]*)\n(.*?)```", re.DOTALL)
_INLINE_CODE_RE = re.compile(r"`([^`]+)`")
_BOLD_RE = re.compile(r"\*\*([^\*]+)\*\*")
_BOLD2_RE = re.compile(r"__([^_]+)__")
_ITALIC_RE = re.compile(r"(?<!\*)\*([^\*]+)\*(?!\*)")
_ITALIC2_RE = re.compile(r"(?<!_) _([^_]+)_ (?!_)".replace(" ", ""))  # _text_

def extract_links(md: str) -> list[tuple[str, str]]:
    """Return list of (text, href) from markdown."""
    # exclude images
    # temporarily remove image patterns
    tmp = _IMAGE_RE.sub("", md)
    return [(m.group(1).strip(), m.group(2).strip()) for m in _LINK_RE.finditer(tmp)]

def markdown_to_plain(md: str, page_url: str, root_origin: str) -> tuple[str, list[str], list[str]]:
    """
    Convert markdown to readable plain text.

    Returns (plain_text, internal_selectors, external_urls)
    - plain_text is wrapped, heading/paragraph/list/code preserved
    - internal selectors are Gopher selectors (e.g. /about.txt)
    - external urls are full https://...
    The plain_text itself embeds human-readable hints for links.
    """
    # 1. Extract fenced code blocks and replace with placeholders
    fences: list[str] = []
    def fence_sub(m):
        lang = m.group(1).strip()
        body = m.group(2)
        fences.append(body)
        return f"\n__FENCE_{len(fences)-1}__\n"
    md_no_fence = _CODE_FENCE_RE.sub(fence_sub, md)

    # 2. Collect links before we rewrite them
    links = extract_links(md_no_fence)
    internal_selectors: list[str] = []
    external_urls: list[str] = []

    # Helper to map href to selector
    def href_to_selector(href: str) -> str | None:
        # strip fragment and query? keep query? For selector we strip fragment, ignore query for now
        href = href.strip()
        if not href or href.startswith("#") or href.startswith("mailto:") or href.startswith("javascript:"):
            return None
        # resolve relative to page_url
        abs_url = urllib.parse.urljoin(page_url, href)
        p = urllib.parse.urlparse(abs_url)
        if p.scheme in ("http", "https"):
            if is_same_origin(abs_url, root_origin):
                # map path to selector
                path = p.path or "/"
                if path == "/":
                    return "/index.txt"
                # strip trailing slash
                if path.endswith("/") and len(path) > 1:
                    path = path.rstrip("/")
                # ignore query/fragment for file mapping; keep clean
                # If path contains dot already (unlikely for sitemap), keep as-is but ensure .txt
                # Normal pages: /about -> /about.txt
                if "." in os.path.basename(path):
                    # e.g. already has extension, treat as-is
                    return path
                return path + ".txt"
            else:
                return None
        elif href.startswith("/"):
            # same-origin without scheme
            if href == "/":
                return "/index.txt"
            clean = href.split("#")[0].split("?")[0]
            if clean.endswith("/") and len(clean) > 1:
                clean = clean.rstrip("/")
            if "." in os.path.basename(clean):
                return clean
            return clean + ".txt"
        else:
            # relative without leading /
            abs2 = urllib.parse.urljoin(page_url, href)
            p2 = urllib.parse.urlparse(abs2)
            if p2.scheme in ("http", "https") and not is_same_origin(abs2, root_origin):
                return None
            path = p2.path or "/"
            if path == "/":
                return "/index.txt"
            if path.endswith("/") and len(path) > 1:
                path = path.rstrip("/")
            if "." in os.path.basename(path):
                return path
            return path + ".txt"

    # 3. Rewrite links in text
    def link_repl(m):
        text = m.group(1).strip()
        href = m.group(2).strip()
        abs_url = urllib.parse.urljoin(page_url, href)
        p = urllib.parse.urlparse(abs_url)
        # external?
        if p.scheme in ("http", "https") and not is_same_origin(abs_url, root_origin):
            # filter only http/https
            external_urls.append(abs_url.split("#")[0])
            # For plain text, show as "text <url>"
            if text:
                return f"{text} <{abs_url}>"
            else:
                return f"<{abs_url}>"
        elif href.startswith("#") or href.startswith("mailto:") or href.startswith("javascript:"):
            # just text
            return text
        else:
            # internal
            sel = href_to_selector(href)
            if sel:
                internal_selectors.append(sel)
                if text:
                    # show as "text [=> /selector]"
                    return f"{text} [=> {sel}]"
                else:
                    return f"[=> {sel}]"
            else:
                return text

    # Remove images: replace with alt text
    md_no_fence = _IMAGE_RE.sub(lambda m: m.group(1).strip(), md_no_fence)
    md_linked = _LINK_RE.sub(link_repl, md_no_fence)

    # 4. Headings
    def heading_repl(m):
        hashes = m.group(1)
        text = m.group(2).strip()
        level = len(hashes)
        if level == 1:
            # Uppercase with underline
            t = text.upper()
            return f"\n\n{t}\n{'='*len(t)}\n\n"
        elif level == 2:
            return f"\n\n{text}\n{'-'*len(text)}\n\n"
        elif level == 3:
            return f"\n\n{text}\n\n"
        else:
            return f"\n\n{text}\n\n"
    md_headed = re.sub(r"^(#{1,6})\s+(.+?)\s*$", heading_repl, md_linked, flags=re.MULTILINE)

    # 5. Horizontal rules
    md_headed = re.sub(r"^\s*([-*_]\s*){3,}\s*$", "\n\n---\n\n", md_headed, flags=re.MULTILINE)

    # 6. Unwrap bold/italic/inline code
    md_headed = _BOLD_RE.sub(r"\1", md_headed)
    md_headed = _BOLD2_RE.sub(r"\1", md_headed)
    # italic single * and _ — careful not to mangle lists
    md_headed = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"\1", md_headed)
    md_headed = re.sub(r"(?<!_) _([^_]+)_ (?!_)".replace(" ", ""), r"\1", md_headed)
    md_headed = _INLINE_CODE_RE.sub(r"\1", md_headed)

    # 7. Lists: normalize bullets, keep numbering
    # Unordered: - , * remain as "  * "
    md_headed = re.sub(r"^\s*[-*]\s+", "  * ", md_headed, flags=re.MULTILINE)
    # Ordered: keep "  1. "
    md_headed = re.sub(r"^\s*(\d+)\.\s+", r"  \1. ", md_headed, flags=re.MULTILINE)

    # 8. Collapse remaining markdown cruft: blockquote > , tables |
    md_headed = re.sub(r"^\s*>\s?", "", md_headed, flags=re.MULTILINE)

    # 9. Restore fences as indented verbatim (no wrapping)
    # We have placeholders __FENCE_n__
    # Reinsert with indentation preservation
    for idx, body in enumerate(fences):
        placeholder = f"__FENCE_{idx}__"
        # body is verbatim; ensure it has trailing newline
        # indent with 4 spaces? For gopher plain text, show as:
        # --- code ---
        # body
        # ------------
        fenced = "\n    " + body.strip("\n").replace("\n", "\n    ") + "\n"
        md_headed = md_headed.replace(placeholder, fenced)

    # 10. Clean up whitespace: normalize spaces but preserve paragraph breaks and code indentation
    # Split into blocks by double newline, process each
    # Keep code-indented lines (4 spaces) untouched for wrapping
    # For non-code, collapse spaces and wrap
    blocks = re.split(r"\n{2,}", md_headed)
    cleaned_blocks = []
    for blk in blocks:
        blk = blk.strip()
        if not blk:
            continue
        # if block is code-like (starts with 4 spaces line), keep as-is
        lines = blk.split("\n")
        is_code = all(l.startswith("    ") or not l.strip() for l in lines if l.strip())
        if is_code and any(l.startswith("    ") for l in lines):
            # keep verbatim, but strip trailing spaces
            cleaned_blocks.append("\n".join(l.rstrip() for l in lines))
        else:
            # collapse single newlines to space, but keep list items line breaks
            # If block contains list items (lines starting with "  * " or "  1. "), preserve lines individually
            if any(l.lstrip().startswith("* ") or re.match(r"^\s*\d+\.\s", l) for l in lines):
                # wrap each list item individually
                wrapped_items = []
                for l in lines:
                    l = l.strip()
                    if not l:
                        continue
                    # remove leading bullet already normalized, then re-wrap with indent
                    m = re.match(r"^\*\s+(.*)", l)
                    if m:
                        content = m.group(1)
                        wrapped = textwrap.fill(content, width=76, initial_indent="  * ", subsequent_indent="      ")
                        wrapped_items.append(wrapped)
                    else:
                        m2 = re.match(r"^(\d+)\.\s+(.*)", l)
                        if m2:
                            num, content = m2.groups()
                            indent = f"  {num}. "
                            sub_indent = " " * len(indent)
                            wrapped = textwrap.fill(content, width=76, initial_indent=indent, subsequent_indent=sub_indent)
                            wrapped_items.append(wrapped)
                        else:
                            wrapped = textwrap.fill(l, width=76)
                            wrapped_items.append(wrapped)
                cleaned_blocks.append("\n".join(wrapped_items))
            else:
                # normal paragraph: collapse to single line then wrap
                para = " ".join(blk.split())
                # Don't wrap headings that are underlined with === or ---
                if "\n" in blk and ("=" in blk or "-" in blk):
                    # heading block already formatted, keep lines as-is but clean
                    cleaned_blocks.append(blk)
                else:
                    if para:
                        wrapped = textwrap.fill(para, width=76)
                        cleaned_blocks.append(wrapped)

    plain = "\n\n".join(cleaned_blocks).strip() + "\n"

    # Deduplicate selectors/externals
    internal_selectors = sorted(set(internal_selectors))
    external_urls = sorted(set(external_urls))

    return plain, internal_selectors, external_urls

