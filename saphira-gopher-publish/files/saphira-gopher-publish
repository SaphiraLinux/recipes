def url_to_file_info(url: str, title_hint: str | None) -> tuple[str, str]:
    """
    Map canonical URL to (relative_file_path, selector).
    e.g. https://saphira.vm2.uk/about -> ("about.txt", "/about.txt")
         https://saphira.vm2.uk/ -> ("index.txt", "/index.txt")
         https://saphira.vm2.uk/a/b/c -> ("a/b/c.txt", "/a/b/c.txt")
    """
    p = urllib.parse.urlparse(url)
    path = p.path or "/"
    if path == "/":
        return "index.txt", "/index.txt"
    # strip leading / and trailing /
    rel = path.lstrip("/")
    if rel.endswith("/"):
        rel = rel.rstrip("/")
    # if rel has extension already, keep, else add .txt
    if "." not in os.path.basename(rel):
        rel = rel + ".txt"
    selector = "/" + rel
    return rel, selector

def title_from_markdown(md: str, fallback: str, url: str | None = None) -> str:
    # Find first H1 and first H2; disambiguate generic "Saphira Linux" headings
    # that are duplicated across subpages (e.g. all dnsDragon subpages share
    # "# Saphira Linux dnsDragon"). In that case use the H2 and optionally
    # prefix with parent dir for uniqueness (e.g. "Dnsdragon - Install BIND 9").
    # Root ("/") is excluded: it should keep its H1 (SAPHIRA LINUX).
    headings: list[tuple[str, str]] = re.findall(r"^(#{1,6})\s+(.+?)\s*$", md, flags=re.MULTILINE)
    h1: str | None = None
    h2: str | None = None
    for hashes, text in headings:
        clean = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
        clean = re.sub(r"[*_`]+", "", clean).strip()
        lvl = len(hashes)
        if lvl == 1 and h1 is None:
            h1 = clean
        elif lvl == 2 and h2 is None:
            h2 = clean
            if h1 is not None:
                break
    # Root special-case: keep H1 to avoid news-item title
    if url:
        try:
            p = urllib.parse.urlparse(url)
            if p.path == "/" or p.path == "":
                if h1:
                    return h1
        except Exception:
            pass
    if h1:
        if h1.lower().startswith("saphira linux") and h2:
            # Generic branding -> use H2, prefixed with parent for navigation clarity
            if url:
                p = urllib.parse.urlparse(url)
                path = p.path.strip("/")
                parts = path.split("/") if path else []
                if len(parts) >= 2:
                    parent_disp = parts[0].replace("-", " ").replace("_", " ").title()
                    if parent_disp.lower() not in h2.lower():
                        return f"{parent_disp} - {h2}"
            return h2
        return h1
    if h2:
        return h2
    return fallback

def gopher_escape(display: str) -> str:
    """
    Geomyidae 0.99 index.gph native syntax: [type|Display|Selector|Host|Port]
    Escape '|' and ']' and newlines. Upstream does not define fully;
    we escape '|' as r'\\|' and strip control chars. ']' is left as-is
    unless followed by '|'? Conservative.
    """
    # strip control, tabs, newlines
    display = display.replace("\r", " ").replace("\n", " ").replace("\t", " ")
    # escape pipe
    display = display.replace("|", r"\|")
    # collapse spaces
    display = re.sub(r"\s+", " ", display).strip()
    # limit length? geomyidae truncates maybe 70; we keep 70 for display
    if len(display) > 70:
        display = display[:67] + "..."
    return display


def default_config_paths() -> list[Path]:
    """Search order for gopher-publisher.conf (system then dev next-to-bin)."""
    candidates: list[Path] = []
    # System location
    candidates.append(Path("/etc/saphira/gopher-publisher.conf"))
    # Next-to-bin: gopher/etc/saphira/gopher-publisher.conf (dev)
    try:
        bin_dir = Path(__file__).resolve().parent
        candidates.append(bin_dir.parent / "etc" / "saphira" / "gopher-publisher.conf")
        candidates.append(bin_dir.parent / "etc" / "gopher-publisher.conf")
    except Exception:
        pass
    # CWD fallback
    candidates.append(Path("etc/saphira/gopher-publisher.conf"))
    return candidates


def load_publisher_config(path: Path) -> dict[str, str]:
    """Load key=value config (INI with or without section). Returns dict."""
    parser = configparser.ConfigParser()
    # Allow file without section header by prepending [gopher]
    text = path.read_text(encoding="utf-8")
    if not re.search(r"^\s*\[", text, re.MULTILINE):
        text = "[gopher]\n" + text
    parser.read_string(text)
    cfg: dict[str, str] = {}
    # Prefer [gopher] section, fallback to DEFAULT
    section = "gopher" if parser.has_section("gopher") else parser.default_section
    for k, v in parser.items(section):
        cfg[k.lower()] = v.strip()
    return cfg


def chown_tree(root: Path, user: str, group: str) -> None:
    """Recursively chown root to user:group if possible (best-effort, warns on fail)."""
    try:
        uid = pwd.getpwnam(user).pw_uid
        gid = grp.getgrnam(group).gr_gid
    except KeyError as e:
        print(f"warning: chown {user}:{group} skipped ({e})", file=sys.stderr)
        return
    try:
        for dirpath, dirnames, filenames in os.walk(root):
            os.chown(dirpath, uid, gid)
            for name in filenames:
                os.chown(os.path.join(dirpath, name), uid, gid)
    except PermissionError as e:
        print(f"warning: chown {root} -> {user}:{group} failed ({e})", file=sys.stderr)
    except Exception as e:
        print(f"warning: chown failed: {e}", file=sys.stderr)

