#!/bin/bash
# saphira-firstboot-image: dedicated installer wizard for the USB
# creator appliance. Boots, guides, writes to ONE real disk, reboots.
#
# This is NOT saphira-firstboot (which configures the machine it runs
# on) and it does NOT modify saphira-image (which it drives). The
# appliance is a temporary installation environment: this wizard
# configures the DESTINATION system only and leaves the appliance
# itself unchanged.
#
# Strict isolation, enforced and tested:
#   - only saphira-image install-to-disk is ever invoked (no build,
#     no export, no image-file output);
#   - the destination must be a whole real disk, never the boot disk,
#     never a partition, never mounted;
#   - nothing is written before the preview plus the typed-path
#     confirmation;
#   - passwords live in shell variables only: never in arguments
#     (the engine takes SAPHIRA_ROOT_PASSWORD from the environment),
#     never in logs, never in files (refused in manifests);
#   - cancellation writes nothing, at any point.
#
# Network validation reuses apply-network.sh verbs directly
# (validate-ipv4-cidr, validate-ipv6-cidr, validate-domain,
# normalize-dns, dns-provider). The validators are the contract; the
# dialogs around them are new. Target network files are written in the
# exact format write_network_file produces, only after validate
# accepts the staged state.

set -eu

# Self-sufficient PATH: the wizard runs from init with whatever the
# environment gives it; engine tools live across bin and sbin.
# Caller directories are preserved first (tests inject stubs there).
PATH=$PATH:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
# dialog is TERM-driven and the boot runlevel sets no TERM: without
# this every dialog call fails instantly and the service dies silent.
export TERM=${TERM:-linux}

DIALOG=${SAPHIRA_IMAGE_DIALOG:-dialog}
TTY=${SAPHIRA_IMAGE_TTY:-/dev/console}
test -c "$TTY" || die "no console at $TTY"
MARKER=${SAPHIRA_IMAGE_MARKER:-/etc/saphira-image-firstboot-required}
STATE_DIR=${SAPHIRA_IMAGE_STATE_DIR:-/var/lib/saphira-image-firstboot}
NETWORK_APPLY=${SAPHIRA_IMAGE_NETWORK_APPLY:-/usr/libexec/saphira/apply-network.sh}
TMPDIR=${SAPHIRA_TMPDIR:-/build/tmp}

die()
{
	printf 'saphira-firstboot-image: %s\n' "$*" >&2
	exit 1
}

test "$(id -u)" -eq 0 || [ "${SAPHIRA_IMAGE_ALLOW_NONROOT:-0}" = 1 ] ||
	die "must run as root (SAPHIRA_IMAGE_ALLOW_NONROOT=1 admits tests only)"
command -v "$DIALOG" >/dev/null 2>&1 || die "menu backend missing: $DIALOG"
command -v saphira-image >/dev/null 2>&1 || die "image engine missing: saphira-image"
test -x "$NETWORK_APPLY" || die "network validator absent: $NETWORK_APPLY (install cannot proceed: the appliance profile must provide it)"
command -v blkid >/dev/null 2>&1 || die "blkid missing (util-linux)"

backtitle="Saphira Linux installer"

menu_pick()
{
	title=$1 text=$2
	shift 2
	"$DIALOG" --backtitle "$backtitle" --title "$title" \
		--menu "$text" 0 0 0 "$@" 2>&1 >"$TTY" <"$TTY" || die "cancelled at $title (nothing was written)"
}

menu_info()
{
	"$DIALOG" --backtitle "$backtitle" --title "$1" --msgbox "$2" 0 0 <"$TTY" >"$TTY" || die "cancelled (nothing was written)"
}

menu_yesno()
{
	"$DIALOG" --backtitle "$backtitle" --title "$1" --yesno "$2" 0 0 <"$TTY" >"$TTY"
}

menu_input()
{
	"$DIALOG" --backtitle "$backtitle" --title "$1" --inputbox "$2" 0 0 "$3" 2>&1 >"$TTY" <"$TTY" || die "cancelled at $1 (nothing was written)"
}

menu_password()
{
	"$DIALOG" --backtitle "$backtitle" --title "$1" --passwordbox "$2" 0 0 2>&1 >"$TTY" <"$TTY" || die "cancelled at $1 (nothing was written)"
}

# --- marker: setup owed exactly once -----------------------------------
test -e "$MARKER" || {
	printf 'Saphira installer has already completed on this appliance.\n'
	exit 0
}
install -d -m 0700 "$STATE_DIR"

# --- step 1: welcome ----------------------------------------------------
menu_info "Welcome" "This appliance installs Saphira Linux onto a real disk in this machine. It never changes itself: every answer below goes into the INSTALLED system only. Nothing is written anywhere until you confirm the plan twice."

# --- step 2: destination disk -------------------------------------------
# Stable identifiers for display, kernel node for the engine (which
# has no by-id resolver: part_device_for on a symlink path yields a
# nonsense partition name). The boot disk can never be the target,
# including under QEMU/KVM where every disk looks alike.
boot_disk()
{
	src=$(findmnt -no SOURCE / 2>/dev/null || true)
	[ -n "$src" ] || return 0
	node=$(readlink -f "$src" 2>/dev/null || printf '%s' "$src")
	base=$(basename "$node")
	# Whole-disk spelling: nvme0n1p2 -> nvme0n1 (strip partition
	# suffix only), sda1 -> sda (strip trailing digits). Engine
	# re-validates; this is the fail-fast pre-check.
	case $base in
	*p[0-9]*) base=${base%%p*} ;;
	*[0-9]*) base=$(expr "$base" : '\(.*[^0-9]\)[0-9]*$') ;;
	esac
	printf '/dev/%s' "$base"
}

pick_device()
{
	if [ -n "${SAPHIRA_IMAGE_DISK:-}" ]; then
		DEVICE=$SAPHIRA_IMAGE_DISK
	else
		# udev publishes by-id asynchronously after trigger: poll
		# bounded (30s), then fail closed with a diagnostic. An
		# empty picker on a settled tree means the daemon is down;
		# proceeding would offer nothing installable.
		tries=0
		entries=
		while [ $tries -lt 30 ]; do
			entries=$(ls /dev/disk/by-id/ 2>/dev/null | grep -v -- '-part[0-9]*$' | grep -v '^wwn-' | grep -v 'CD-ROM')
			[ -n "$entries" ] && break
			sleep 1
			tries=$((tries + 1))
		done
		[ -n "$entries" ] ||
			die "no /dev/disk/by-id entries after 30s (is udev running and settled? check systemd-udevd)"
		boot=$(boot_disk)
		set --
		for id in $entries; do
			node=$(readlink -f "/dev/disk/by-id/$id")
			case $node in /dev/sd*|/dev/vd*|/dev/nvme*|/dev/mmcblk*|/dev/hd*) ;;
			*) continue ;;
			esac
			if [ -n "$boot" ] && [ "$node" = "$boot" ]; then
				continue
			fi
			size=$(blockdev --getsize64 "$node" 2>/dev/null || echo 0)
			mib=$((size / 1048576))
			set -- "$@" "$id" "$node ${mib}MiB"
		done
		[ "$#" -gt 0 ] || die "no installable disk: every disk is the boot disk or unreadable"
		id=$(menu_pick "Destination disk" "Install onto which disk? The appliance boot disk is never offered. ALL DATA ON THE CHOSEN DISK WILL BE DESTROYED.")
		DEVICE=$(readlink -f "/dev/disk/by-id/$id")
	fi
	case $DEVICE in /dev/sd*|/dev/vd*|/dev/nvme*|/dev/mmcblk*|/dev/hd*) ;;
	*) die "refusing non-disk device: $DEVICE" ;;
	esac
	# The engine re-validates (partition, mounted, boot disk); this
	# pre-check fails fast with the appliance's own wording.
	[ "$DEVICE" != "$(boot_disk)" ] || die "the boot disk is never an install target: $DEVICE"
	mounted=$(grep -cF "$DEVICE" /proc/mounts 2>/dev/null || true)
	[ "$mounted" = 0 ] || die "device has mounted partitions: $DEVICE"
}

# --- step 3: product ------------------------------------------------------
pick_product()
{
	PRODUCT=$(menu_pick "Operating system" "Which Saphira to install? (The appliance stays OpenRC regardless.)" \
		saphira "Saphira with OpenRC" \
		saphirad "Saphira-D with systemd")
	case $PRODUCT in
	saphira) TARGET_FLAVOR=openrc ;;
	saphirad) TARGET_FLAVOR=systemd ;;
	esac
}

# --- step 4: firmware -----------------------------------------------------
pick_firmware()
{
	if test -d /sys/firmware/efi; then detected=uefi; else detected=bios; fi
	FIRMWARE=$(menu_pick "Firmware" "Boot mode for the INSTALLED system (this boot: $detected)." \
		bios "Legacy BIOS" \
		uefi "UEFI")
	case $FIRMWARE in
	bios) FIRMWARE_TARGET=bios ;;
	uefi) FIRMWARE_TARGET=uefi ;;
	esac
}

# --- step 5: filesystem ---------------------------------------------------
pick_rootfs()
{
	while :; do
		ROOTFS=$(menu_pick "Root filesystem" "Filesystem for / on the installed system." \
			ext4 "ext4 (supported)" \
			zfs "ZFS pool with ext4 /boot (EXPERIMENTAL: ZFS-root boot needs the import path, still pending)")
		case $ROOTFS in
		ext4|zfs) return 0 ;;
		esac
	done
}

# --- step 6: hostname -----------------------------------------------------
pick_hostname()
{
	while :; do
		HOSTNAME=$(menu_input "Hostname" "Hostname for the installed machine." "saphira-new")
		case $HOSTNAME in
		''|*[!A-Za-z0-9-]*) menu_info "Hostname" "Letters, digits and hyphens only." ;;
		*) return 0 ;;
		esac
	done
}

# --- step 7: networking ---------------------------------------------------
# Interface list: physical ethernets only (ARPHRD_ETHER + device
# link), never lo. Mirrors firstboot's enumeration, not its flow.
list_interfaces()
{
	for ifdir in /sys/class/net/*; do
		iface=${ifdir##*/}
		case $iface in lo) continue ;; esac
		[ "$(cat "$ifdir/type" 2>/dev/null)" = 1 ] || continue
		[ -e "$ifdir/device" ] || continue
		printf '%s\n' "$iface"
	done
}

pick_network()
{
	IFACE=$(menu_pick "Network interface" "Configure which interface? (Stays DHCP unless you pick static.)" \
		$(for i in $(list_interfaces); do printf '%s %s ' "$i" "$i"; done) \
		skip "No network (offline install from local repository only)")
	[ "$IFACE" = skip ] && { NETCONF=""; DNS_SERVERS=""; return 0; }
	V4MODE=$(menu_pick "IPv4" "IPv4 for $IFACE." \
		dhcp "DHCP (default)" \
		static "Static address" \
		off "Disabled")
	if [ "$V4MODE" = static ]; then
		while :; do
			V4CIDR=$(menu_input "IPv4 static" "Address in CIDR form (example 192.168.1.10/24)." "")
			"$NETWORK_APPLY" validate-ipv4-cidr "$V4CIDR" 2>/dev/null && break
			menu_info "IPv4" "Not a valid IPv4 CIDR."
		done
		V4GATEWAY=$(menu_input "IPv4 static" "Gateway (blank for none)." "")
		if [ -n "$V4GATEWAY" ]; then
			"$NETWORK_APPLY" validate-ipv4 "$V4GATEWAY" 2>/dev/null ||
				die "invalid IPv4 gateway: $V4GATEWAY"
		fi
	else
		V4CIDR=""; V4GATEWAY=""
	fi
	WANTV6=$(menu_pick "IPv6" "Configure IPv6 for $IFACE?" \
		no "No (default)" \
		yes "Yes")
	if [ "$WANTV6" = yes ]; then
		V6MODE=$(menu_pick "IPv6 mode" "IPv6 for $IFACE." \
			slaac "SLAAC (default where offered)" \
			dhcpv6 "DHCPv6" \
			static "Static address" \
			off "Disabled")
		if [ "$V6MODE" = static ]; then
			while :; do
				V6CIDR=$(menu_input "IPv6 static" "Address in CIDR form." "")
				"$NETWORK_APPLY" validate-ipv6-cidr "$V6CIDR" 2>/dev/null && break
				menu_info "IPv6" "Not a valid IPv6 CIDR."
			done
			V6GATEWAY=$(menu_input "IPv6 static" "Gateway (blank for none)." "")
			if [ -n "$V6GATEWAY" ]; then
				"$NETWORK_APPLY" validate-ipv6 "$V6GATEWAY" 2>/dev/null ||
					die "invalid IPv6 gateway: $V6GATEWAY"
			fi
		else
			V6CIDR=""; V6GATEWAY=""
		fi
	else
		V6MODE=off; V6CIDR=""; V6GATEWAY=""
	fi
	DNSPICK=$(menu_pick "DNS" "Name servers for the installed system." \
		1 "Quad9 (default)" \
		2 "Cloudflare" \
		3 "OpenDNS" \
		4 "Custom")
	if [ "$DNSPICK" = 4 ]; then
		while :; do
			raw=$(menu_input "DNS" "Name servers, space separated." "")
			DNS_SERVERS=$("$NETWORK_APPLY" normalize-dns "$raw" 2>/dev/null) && break
			menu_info "DNS" "No usable name server in that answer."
		done
		DNS_SEARCH=""
	else
		provider=$("$NETWORK_APPLY" dns-provider "$DNSPICK") ||
			die "DNS provider lookup failed"
		DNS_SERVERS=${provider%%|*}
		DNS_SEARCH=""
	fi
	# Stage + validate through the real contract before anything is
	# shown or applied: the staged file proves the answers before
	# the engine or the target ever sees them.
	state=$(mktemp "$STATE_DIR/.iface.XXXXXX")
	chmod 0600 "$state"
	{
		printf 'TYPE=physical\nINTERFACE=%s\n' "$IFACE"
		printf 'IPV4_MODE=%s\nIPV4_CIDR=%s\nIPV4_GATEWAY=%s\nIPV4_METRIC=\n' "$V4MODE" "$V4CIDR" "$V4GATEWAY"
		printf 'IPV6_MODE=%s\nIPV6_CIDR=%s\nIPV6_GATEWAY=%s\nIPV6_METRIC=\n' "$V6MODE" "$V6CIDR" "$V6GATEWAY"
		printf 'DNS_SERVERS=%s\nDNS_SEARCH=%s\n' "$DNS_SERVERS" "$DNS_SEARCH"
	} > "$state"
	"$NETWORK_APPLY" validate "$state" || die "network answers failed validation (nothing was written)"
	NETSTATE=$state
	# Engine netconf covers dhcp/off only; static travels in the file
	# written to the target after install. dhcp is the live default.
	if [ "$V4MODE" = dhcp ] && [ "$V6MODE" = off ]; then
		NETCONF="$IFACE:dhcp"
	elif [ "$V4MODE" = off ] && [ "$V6MODE" = off ]; then
		NETCONF="$IFACE:off"
	else
		NETCONF="$IFACE:dhcp"
	fi
}

# --- step 8: root password --------------------------------------------------
pick_password()
{
	while :; do
		TARGETPW=$(menu_password "Root password" "Root password for the INSTALLED system (asked every time, never stored).")
		TARGETPW2=$(menu_password "Root password" "Repeat it.")
		[ "$TARGETPW" = "$TARGETPW2" ] && [ -n "$TARGETPW" ] && break
		menu_info "Root password" "Empty or mismatched; try again."
	done
	unset TARGETPW2
}

# --- step 9+10: plan, preview, confirm --------------------------------------
# --- engine ---------------------------------------------------------------
# Only install-to-disk is ever invoked. NOEXEC prints instead of
# running (tests). The strings build/export/--output never occur in
# this file (test-grepped).
run_engine()
{
	if [ "${SAPHIRA_IMAGE_NOEXEC:-0}" = 1 ]; then
		printf 'NOEXEC saphira-image install-to-disk --target %s --device %s --hostname %s %s --rootfs %s %s %s\n' \
			"$TARGET" "$DEVICE" "$HOSTNAME" "$NETCONF_ARGS" "$ROOTFS" "$ZFS_ROLE" "$*" >&2
		return 0
	fi
	# shellcheck disable=SC2086
	SAPHIRA_ROOT_PASSWORD="$TARGETPW" saphira-image install-to-disk \
		--target "$TARGET" --device "$DEVICE" \
		--hostname "$HOSTNAME" $NETCONF_ARGS --rootfs "$ROOTFS" $ZFS_ROLE "$@" <"$TTY" >"$TTY" 2>&1 ||
		die "engine failed (see above)"
}

pick_device; pick_product; pick_firmware; pick_rootfs; pick_hostname; pick_network; pick_password

NETCONF_ARGS=
[ -n "${NETCONF:-}" ] && NETCONF_ARGS="--netconf $NETCONF"

# Flavor target follows product+firmware. usb-creator is the
# appliance itself and is never offered as a product.
resolve_target_name()
{
	case $PRODUCT/$FIRMWARE in
	saphira/bios) printf 'bios-saphira' ;;
	saphira/uefi) printf 'uefi-saphira' ;;
	saphirad/bios) printf 'bios-saphirad' ;;
	saphirad/uefi) printf 'uefi-saphirad' ;;
	*) die "internal: no target for $PRODUCT/$FIRMWARE" ;;
	esac
}
TARGET=$(resolve_target_name)

ZFS_ROLE=
zfs_note=
if [ "$ROOTFS" = zfs ]; then
	ZFS_ROLE="--role role-zfs"
	zfs_note=' (EXPERIMENTAL boot: ZFS-root import path pending)'
fi

plan="Product: $PRODUCT ($TARGET)
Firmware: $FIRMWARE
Filesystem: $ROOTFS$zfs_note
Device: $DEVICE (whole disk; the appliance boot disk was never offered)
Hostname: $HOSTNAME
Network: ${NETCONF:-none}
DNS: ${DNS_SERVERS:-none}"
menu_yesno "Install plan" "$plan

Write it? (preview runs first, then a final typed confirmation)" || die "aborted (nothing was written)"

menu_info "Preview" "Dry run. Read it, then confirm the real write."
run_engine --preview ||
	die "preview failed (nothing was written)"

menu_yesno "Destroy and write" "Last chance: ALL DATA on $DEVICE will be destroyed. The engine asks you to type the path back next. Proceed?" ||
	die "aborted (nothing was written)"
run_engine ||
	die "installation failed (see above)"
unset TARGETPW

# --- destination network + DNS (engine covers dhcp/off only) ---------------
# Static answers travel in files written to the finished target,
# found by its root label (ext4) or its pool dataset (ZFS, imported
# read-write here for the purpose and exported again after).
# No layout knowledge beyond what the engine itself guarantees.
mount_target_root()
{
	# $1 = mountpoint. Prints nothing; fails closed.
	if [ "$ROOTFS" = zfs ]; then
		zpool import -d "$(dirname -- "$DEVICE")" -N "$POOL" 2>/dev/null ||
			die "cannot import pool $POOL from $DEVICE"
		case $TARGET_FLAVOR in
		openrc) ds=saphira ;;
		systemd) ds=saphirad ;;
		esac
		mount -t zfs "$POOL/ROOTS/$ds" "$1" 2>/dev/null ||
			die "cannot mount $POOL/ROOTS/$ds"
		mkdir -p "$1/boot"
		bootpart=$(blkid -L saphira-boot 2>/dev/null || true)
		[ -n "$bootpart" ] || die "installed /boot not found by label"
		mount -o noatime "$bootpart" "$1/boot" 2>/dev/null ||
			die "cannot mount the installed /boot"
	else
		rootpart=$(blkid -L saphira-root 2>/dev/null || true)
		[ -n "$rootpart" ] || die "installed root not found by label (cannot finish network setup)"
		mount -o noatime "$rootpart" "$1" 2>/dev/null ||
			die "cannot mount the installed root"
	fi
}

umount_target_root()
{
	# $1 = mountpoint.
	umount -R -- "$1" 2>/dev/null || true
	if [ "$ROOTFS" = zfs ]; then
		zpool export "$POOL" 2>/dev/null || true
	fi
}

write_target_network()
{
	[ -n "${NETSTATE:-}" ] || return 0
	mnt=$(mktemp -d "$TMPDIR/image-firstboot.XXXXXX")
	if mount_target_root "$mnt"; then
		mkdir -p "$mnt/etc/saphira-network.d"
		cp "$NETSTATE" "$mnt/etc/saphira-network.d/$IFACE.conf"
		chmod 0644 "$mnt/etc/saphira-network.d/$IFACE.conf"
		if [ -n "${DNS_SERVERS:-}" ]; then
			{
				for ns in $DNS_SERVERS; do printf 'nameserver %s\n' "$ns"; done
				[ -n "${DNS_SEARCH:-}" ] && printf 'search %s\n' "$DNS_SEARCH"
			} > "$mnt/etc/resolv.conf"
			chmod 0644 "$mnt/etc/resolv.conf"
		fi
		umount_target_root "$mnt"
	else
		rmdir "$mnt" 2>/dev/null || true
		die "cannot reach the installed target for network setup"
	fi
	rmdir "$mnt" 2>/dev/null || true
	rm -f "$NETSTATE"
}
write_target_network

# --- step 11+12: verify, report, reboot offer ---------------------------------
# Never claim a bootable installation without verifying it: partitions
# by label, bootloader artifacts for the selected firmware, hostname,
# network files and a set root credential in the target.
verify_target()
{
	mnt=$(mktemp -d "$TMPDIR/image-firstboot.XXXXXX")
	mount_target_root "$mnt" || die "verification failed: cannot reach the installed target"
	failures=0
	[ -s "$mnt/boot/grub/grub.cfg" ] || { printf 'missing grub.cfg\n' >&2; failures=$((failures + 1)); }
	grep -q 'vmlinuz' "$mnt/boot/grub/grub.cfg" 2>/dev/null || { printf 'no kernel entry\n' >&2; failures=$((failures + 1)); }
	[ "$(cat "$mnt/etc/hostname" 2>/dev/null)" = "$HOSTNAME" ] || { printf 'hostname mismatch\n' >&2; failures=$((failures + 1)); }
	field=$(awk -F: '$1 == "root" { print $2; exit }' "$mnt/etc/shadow" 2>/dev/null || true)
	case $field in ''|'!'*|'*'*) printf 'root credential missing\n' >&2; failures=$((failures + 1)) ;; esac
	if [ "$FIRMWARE" = uefi ]; then
		esp=$(blkid -L SaphiraESP 2>/dev/null || true)
		[ -n "$esp" ] || { printf 'ESP not found\n' >&2; failures=$((failures + 1)); }
	fi
	# No device-exists recheck here: the engine validated the device
	# before writing, and blkid label lookups above already prove the
	# target media is still present.
	umount_target_root "$mnt" || die "verification failed: cannot release the target"
	rmdir "$mnt" 2>/dev/null || true
	[ "$failures" -eq 0 ] || die "verification failed ($failures checks): inspect the target before rebooting"
}
verify_target
rm -f "$MARKER"

menu_info "Done" "$PRODUCT installed on $DEVICE. Remove this USB (or detach the appliance image), then reboot the new system. It boots independently with the hostname, network and root password you set."
FINAL=$(menu_pick "Finish" "What now?" \
	reboot "Reboot this machine" \
	poweroff "Power off" \
	shell "Stay on a shell")
case $FINAL in
reboot) reboot ;;
poweroff) poweroff ;;
shell) sh <"$TTY" >"$TTY" 2>&1 || true ;;
esac
