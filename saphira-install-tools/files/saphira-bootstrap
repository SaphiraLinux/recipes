#!/bin/sh

set -u

usage()
{
	printf 'usage: saphira-bootstrap [-r REPOSITORY] TARGET [PROFILE]\n' >&2
	exit 2
}

die()
{
	printf 'saphira-bootstrap: %s\n' "$*" >&2
	exit 1
}

# Saphira tool scratch lives under SAPHIRA_TMPDIR, never host /tmp.
# RECIPE_RULES.md: "Host /tmp is never Saphira scratch: not for archives,
# not for work, not for tests. Tool and test scratch lives under
# SAPHIRA_TMPDIR (/build/tmp default)". /tmp is wiped on reboot, shared,
# and invisible; on a live system it is also a small tmpfs.
saphira_tmpdir()
{
	printf '%s\n' "${SAPHIRA_TMPDIR:-/build/tmp}"
}

repository=${SAPHIRA_REPOSITORY:-}
case ${1:-} in
	-r|--repository)
		test $# -ge 3 || usage
		repository=$2
		shift 2
		;;
	--repository=*) repository=${1#*=}; shift ;;
esac
test $# -ge 1 && test $# -le 2 || usage
id_command=${SAPHIRA_ID:-id}
test "$($id_command -u)" -eq 0 || die 'root privileges are required'

target=$1
profile=${2:-base}
profile_root=${SAPHIRA_PROFILE_ROOT:-/usr/share/saphira/profiles}
apk_command=${SAPHIRA_APK:-apk}

case $profile in
	*[^A-Za-z0-9._+-]*|'') die "invalid profile name: $profile" ;;
esac
test -f "$profile_root/$profile" || die "profile is unavailable: $profile"
test -n "$repository" || test -s /etc/apk/repositories ||
	die 'host repository configuration is unavailable'
test -d "$target" || die "target is not a directory: $target"
target=$(readlink -f -- "$target") || die "cannot resolve target: $target"
if find "$target" -mindepth 1 -maxdepth 1 ! -name lost+found -print -quit |
	grep -q .; then
	die 'target is not empty'
fi

packages_file=$(mktemp "$(saphira_tmpdir)/saphira-bootstrap.packages.XXXXXX") ||
	die 'cannot create package-list workspace'
trap 'rm -f -- "$packages_file"' EXIT HUP INT TERM
seen_profiles=

expand_profile()
{
	current=$1
	case " $seen_profiles " in
		*" $current "*) die "profile reference cycle: $current" ;;
	esac
	seen_profiles="$seen_profiles $current"
	while IFS= read -r entry || test -n "$entry"; do
		case $entry in
			''|'#'*) continue ;;
			@saphira-stage4-*) expand_profile "${entry#@saphira-stage4-}" ;;
			@akadata-stage4-*) expand_profile "${entry#@akadata-stage4-}" ;;
			@*) expand_profile "${entry#@}" ;;
			# '=' is permitted so a CONSUMER can pin a version, e.g.
			# saphira-kernel=7.1.5-r10. Saphira must not withhold that
			# capability: someone installing an older line deliberately, or
			# holding a system steady while a new one is validated, needs to
			# say so, and the mechanism should be there for them.
			#
			# This says nothing about what WE do. Our own profiles name bare
			# packages and never pin - see recipe-rules.sh, which enforces
			# exactly that. The distinction matters: the system provides the
			# capability, the project declines to use it. Removing the '='
			# here would not make our installs safer, it would only make
			# pinning impossible for everyone else.
			*[!A-Za-z0-9._+=-]*) die "invalid package in profile $current: $entry" ;;
			*) printf '%s\n' "$entry" >> "$packages_file" ;;
		esac
	done < "$profile_root/$current"
}

expand_profile "$profile"
packages=$(awk '!seen[$0]++ { printf "%s%s", separator, $0; separator=" " }' \
	"$packages_file")
test -n "$packages" || die "profile is empty: $profile"

if test "${SAPHIRA_BOOTSTRAP_PLAN:-0}" = 1; then
	printf 'profile=%s\n' "$profile"
	printf 'repository=%s\n' "${repository:-host}"
	printf 'apk --root %s --initdb --keys-dir etc/apk/keys --repositories-file %s/etc/apk/repositories add --no-scripts %s\n' \
		"$target" "$target" "$packages"
	exit 0
fi

install -d -m 0755 "$target/etc/apk/keys" "$target/var/cache/apk" \
	"$target/dev" "$target/proc" "$target/sys" "$target/run" \
	"$target/boot" "$target/usr" "$target/var" "$target/etc"
install -d -m 0700 "$target/root"
install -d -m 1777 "$target/tmp"

key_count=0
if test -d /etc/apk/keys; then
	for key in /etc/apk/keys/*.pub; do
		test -f "$key" || continue
		install -m 0644 "$key" "$target/etc/apk/keys/"
		key_count=$((key_count + 1))
	done
fi
test "$key_count" -gt 0 || die 'no repository public keys are installed on the host'
if test -n "$repository"; then
	printf '%s\n' "$repository" > "$target/etc/apk/repositories"
else
	install -m 0644 /etc/apk/repositories "$target/etc/apk/repositories"
fi

"$apk_command" --root "$target" --initdb \
	--keys-dir etc/apk/keys \
	--repositories-file "$target/etc/apk/repositories" add --no-scripts $packages
# Package install scripts cannot run here: apk executes them chrooted in
# the target, which has no /bin/sh until bash lands and the link below
# exists. saphira-assemble-rootfs replays every installed accounts.d
# fragment explicitly through the host-run reconciler instead, so
# assembly and live install converge on the same helper and data.
if test ! -e "$target/etc/mtab" && test ! -L "$target/etc/mtab"; then
	ln -s /proc/mounts "$target/etc/mtab"
fi
# Root shell convention (mirrors the builder's root initialization):
# /bin/sh is always a link to bash. The bash package owns the link, so this
# is normally already in place; the installer keeps creating it as an
# ordering safety net for profiles whose bash payload has not landed yet.
# Fail closed when bash is absent.
if test ! -e "$target/bin/sh" && test ! -L "$target/bin/sh"; then
	test -x "$target/bin/bash" ||
		die 'installed profile did not provide /bin/bash for /bin/sh'
	ln -s bash "$target/bin/sh" || die 'cannot link /bin/sh to bash'
fi
if test ! -e "$target/usr/bin/env" && test ! -L "$target/usr/bin/env"; then
	test -x "$target/bin/env" ||
		die 'installed profile did not provide /bin/env for /usr/bin/env'
	ln -s /bin/env "$target/usr/bin/env" || die 'cannot link /usr/bin/env'
fi
test -x "$target/bin/sh" && test -e "$target/usr/lib/libc.so" ||
	die 'installed profile did not provide a usable Saphira base system'
