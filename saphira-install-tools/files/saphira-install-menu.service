[Unit]
Description=Saphira USB installer menu (text UI on tty1)
Documentation=man:saphira-install-menu(8)
After=multi-user.target network-online.target
Wants=network-online.target

[Service]
Type=simple
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=tty
StandardError=journal
ExecStart=/usr/bin/saphira-install-menu
Restart=no

[Install]
WantedBy=multi-user.target
