#!/bin/sh
# lb.saphira.http - HTTP transaction against real:$4 (L7).
# Env: LB_SAPHIRA_HTTP_PATH (default /), LB_SAPHIRA_HTTP_HOST (Host header),
# LB_SAPHIRA_HTTP_OK (status class regex, default 2xx/3xx),
# LB_SAPHIRA_HTTP_EXPECT (body regex). No silent degradation to tcp:
# a failed HTTP transaction fails the check.
# Copyright (c) 2026 AKADATA. MIT licensed.
. /usr/share/saphira/lb-healthchecks/lib/lb-saphira-common.sh
lb_init "$@"
PORT="${LB_RPORT:-$LB_VPORT}"
PATH_URL="${LB_SAPHIRA_HTTP_PATH:-/}"
HDRS=""
[ -n "$LB_SAPHIRA_HTTP_HOST" ] && HDRS="-H Host:$LB_SAPHIRA_HTTP_HOST"
if [ -n "$LB_SAPHIRA_HTTP_EXPECT" ]; then
	body=$(curl -sS --max-time "$LB_TIMEOUT" -g $HDRS "http://${LB_REAL}:${PORT}${PATH_URL}" 2>/dev/null) || exit 1
	printf '%s' "$body" | grep -qE -- "$LB_SAPHIRA_HTTP_EXPECT"
else
	code=$(curl -sS --max-time "$LB_TIMEOUT" -g -o /dev/null -w '%{http_code}' $HDRS "http://${LB_REAL}:${PORT}${PATH_URL}" 2>/dev/null) || exit 1
	[ -n "$code" ] || exit 1
	printf '%s' "$code" | grep -qE -- "${LB_SAPHIRA_HTTP_OK:-^(2|3)[0-9][0-9]$}"
fi
