#!/bin/sh
# lb.saphira.fhir - FHIR server capability statement (L7/deep, cheap,
# continuous-safe). Proves the FHIR endpoint serves its
# CapabilityStatement with a FHIR media type.
# Configuration ($6 convenience; env/conf otherwise):
#   $6  FHIR base    LB_SAPHIRA_FHIR_URL (required, e.g. https://host:port/fhir)
#       LB_SAPHIRA_FHIR_TLS_VERIFY=1 enforces cert checks.
# Copyright (c) 2026 AKADATA LIMITED. BSL 1.1 licensed.
. /usr/share/saphira/lb-healthchecks/lib/lb-saphira-common.sh
lb_init "$@"
BASE="${6:-${LB_SAPHIRA_FHIR_URL:-}}"
[ -n "$BASE" ] || exit 2
BASE="${BASE%/}"
V=""
[ "${LB_SAPHIRA_FHIR_TLS_VERIFY:-0}" = "1" ] || V="-k"
out=$(curl $V -sS --max-time "$LB_TIMEOUT" -D - -o /dev/null \
	-H 'Accept: application/fhir+json' "$BASE/metadata") || exit 1
printf '%s\n' "$out" | grep -qiE '^HTTP/[^ ]+ 200' || exit 1
printf '%s\n' "$out" | grep -qi '^content-type:.*application/fhir\+json'
