# mailDragon main.cf additions.
# Source: live ZeroDNS postfix (akadata-mailserver/etc/postfix/main.cf),
# MariaDB lookups replaced by sqlite maps shipped beside this file.
# Apply over the package default with:
#   postconf -e $(grep -v '^#' /usr/share/saphira/maildragon/etc/main.cf.d/*)

virtual_mailbox_domains = sqlite:/etc/postfix/sqlite-virtual-mailbox-domains.cf
virtual_mailbox_maps = sqlite:/etc/postfix/sqlite-virtual-mailbox-maps.cf
virtual_alias_maps = sqlite:/etc/postfix/sqlite-virtual-alias-maps.cf
recipient_bcc_maps = sqlite:/etc/postfix/sqlite-recipient-bcc-maps.cf

virtual_transport = lmtp:unix:private/dovecot-lmtp
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000

smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = inet:127.0.0.1:11332
milter_protocol = 6
milter_default_action = accept

smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
