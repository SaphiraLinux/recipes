#!/bin/sh
#
# ovs-vmswitch
#
# Create a complete Open vSwitch network for libvirt VMs.
#
# Example:
#
#   ovs-vmswitch \
#     --switch test0 \
#     --port tgw0 \
#     --ipv4 10.100.0.1/24 \
#     --ipv6 2a02:8012:bc57:100::1/64
#
# Creates: OVS bridge + internal gateway port (single atomic ovs-vsctl
# transaction), MTU 9000, systemd-networkd configs for bridge and port,
# persistent libvirt network XML, defines/starts/autostarts the network.
#
# SaphiraD (systemd) flavor: systemd-networkd is the only network stack
# this tool integrates with; openrc boxes use saphira-network-config.

set -eu

SWITCH=""
PORT=""
IPV4=""
IPV6=""
NETWORK=""
MTU=9000

XMLDIR="/root/switches"
NETWORKDIR="/etc/systemd/network"

usage()
{
    cat <<EOF
Usage:
  ovs-vmswitch --switch NAME --port NAME [options]

Required:
  --switch NAME       Open vSwitch bridge name
  --port NAME         OVS internal gateway port

Optional:
  --ipv4 CIDR         IPv4 address for gateway port (e.g. 10.100.0.1/24)
  --ipv6 CIDR         IPv6 address for gateway port
  --network NAME      Libvirt network name (default: SWITCH-network)
  --mtu MTU           Interface MTU (default: 9000)
  -h, --help          Show this help
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --switch)  [ "$#" -ge 2 ] || { echo "ovs-vmswitch: --switch requires a value" >&2; exit 2; }; SWITCH="$2"; shift 2 ;;
        --port)    [ "$#" -ge 2 ] || { echo "ovs-vmswitch: --port requires a value" >&2; exit 2; }; PORT="$2"; shift 2 ;;
        --ipv4)    [ "$#" -ge 2 ] || { echo "ovs-vmswitch: --ipv4 requires a value" >&2; exit 2; }; IPV4="$2"; shift 2 ;;
        --ipv6)    [ "$#" -ge 2 ] || { echo "ovs-vmswitch: --ipv6 requires a value" >&2; exit 2; }; IPV6="$2"; shift 2 ;;
        --network) [ "$#" -ge 2 ] || { echo "ovs-vmswitch: --network requires a value" >&2; exit 2; }; NETWORK="$2"; shift 2 ;;
        --mtu)     [ "$#" -ge 2 ] || { echo "ovs-vmswitch: --mtu requires a value" >&2; exit 2; }; MTU="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "ovs-vmswitch: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

[ -n "$SWITCH" ] || { echo "ovs-vmswitch: --switch is required" >&2; exit 2; }
[ -n "$PORT" ] || { echo "ovs-vmswitch: --port is required" >&2; exit 2; }
[ -n "$NETWORK" ] || NETWORK="${SWITCH}-network"

case "$MTU" in ''|*[!0-9]*) echo "ovs-vmswitch: invalid MTU: $MTU" >&2; exit 2 ;; esac

# Linux interface names are limited to 15 characters.
for name in "$SWITCH" "$PORT"; do
    if [ "${#name}" -gt 15 ]; then
        echo "ovs-vmswitch: interface name too long: $name" >&2
        exit 2
    fi
    case "$name" in
        *[!A-Za-z0-9_.:-]*) echo "ovs-vmswitch: invalid interface name: $name" >&2; exit 2 ;;
    esac
done

command -v ovs-vsctl >/dev/null || { echo "ovs-vmswitch: ovs-vsctl not found" >&2; exit 1; }
command -v virsh >/dev/null || { echo "ovs-vmswitch: virsh not found" >&2; exit 1; }
command -v networkctl >/dev/null || { echo "ovs-vmswitch: networkctl not found" >&2; exit 1; }

if ! ovs-vsctl --timeout=5 show >/dev/null 2>&1; then
    echo "ovs-vmswitch: Open vSwitch is not available" >&2
    exit 1
fi

# Refuse to trample an existing bridge or port.
if ovs-vsctl br-exists "$SWITCH" 2>/dev/null; then
    echo "ovs-vmswitch: OVS bridge already exists: $SWITCH" >&2
    exit 1
fi
if ip link show "$PORT" >/dev/null 2>&1; then
    echo "ovs-vmswitch: interface already exists: $PORT" >&2
    exit 1
fi

mkdir -p "$XMLDIR" "$NETWORKDIR"

XML="${XMLDIR}/${SWITCH}.xml"
SWITCH_NETWORK="${NETWORKDIR}/50-${SWITCH}.network"
PORT_NETWORK="${NETWORKDIR}/60-${PORT}.network"

echo "Creating OVS VM switch:"
echo "  switch : $SWITCH"
echo "  port   : $PORT"
echo "  network: $NETWORK"
echo "  MTU    : $MTU"
[ -n "$IPV4" ] && echo "  IPv4   : $IPV4"
[ -n "$IPV6" ] && echo "  IPv6   : $IPV6"
echo

# Create bridge and internal port ATOMICALLY: PORT must be declared
# type=internal in the same transaction in which it is attached.
ovs-vsctl \
    add-br "$SWITCH" \
    -- add-port "$SWITCH" "$PORT" \
    -- set Interface "$PORT" type=internal \
    -- set Interface "$SWITCH" mtu_request="$MTU" \
    -- set Interface "$PORT" mtu_request="$MTU"

# The OVS bridge itself carries no addresses.
cat > "$SWITCH_NETWORK" <<EOF
# Generated by ovs-vmswitch
# OVS bridge: $SWITCH

[Match]
Name=$SWITCH

[Link]
MTUBytes=$MTU
RequiredForOnline=no
ActivationPolicy=up

[Network]
DHCP=no
LinkLocalAddressing=no
IPv6AcceptRA=no
ConfigureWithoutCarrier=yes
EOF

# The internal gateway port may carry IPv4 and/or IPv6.
{
    cat <<EOF
# Generated by ovs-vmswitch
# OVS internal gateway port: $PORT

[Match]
Name=$PORT

[Link]
MTUBytes=$MTU
RequiredForOnline=no
ActivationPolicy=up

[Network]
DHCP=no
IPv6AcceptRA=no
ConfigureWithoutCarrier=yes
EOF
    [ -n "$IPV4" ] && echo "Address=$IPV4"
    [ -n "$IPV6" ] && echo "Address=$IPV6"
} > "$PORT_NETWORK"

# Persistent libvirt network definition.
cat > "$XML" <<EOF
<network>
  <name>${NETWORK}</name>
  <forward mode='bridge'/>
  <bridge name='${SWITCH}'/>
  <virtualport type='openvswitch'/>
  <portgroup name='${NETWORK}' default='yes'/>
</network>
EOF

# Let networkd pick up the newly-created interfaces and configuration.
networkctl reload
networkctl reconfigure "$SWITCH" 2>/dev/null || true
networkctl reconfigure "$PORT" 2>/dev/null || true

# Define the libvirt network from the persistent XML file.
virsh net-define "$XML"

if ! virsh net-info "$NETWORK" 2>/dev/null | grep -q '^Active:.*yes'; then
    virsh net-start "$NETWORK"
fi

virsh net-autostart "$NETWORK"

echo
echo "OVS VM switch created:"
echo
echo "  Bridge             : $SWITCH"
echo "  Gateway port       : $PORT"
echo "  Libvirt network    : $NETWORK"
echo "  MTU                : $MTU"
echo "  XML                : $XML"
echo "  Bridge networkd    : $SWITCH_NETWORK"
echo "  Port networkd      : $PORT_NETWORK"
[ -n "$IPV4" ] && echo "  IPv4               : $IPV4"
[ -n "$IPV6" ] && echo "  IPv6               : $IPV6"
echo
echo "Interface state:"
ip -br link show "$SWITCH"
ip -br link show "$PORT"
echo
echo "OVS:"
ovs-vsctl show
echo
echo "Libvirt:"
virsh net-info "$NETWORK"
