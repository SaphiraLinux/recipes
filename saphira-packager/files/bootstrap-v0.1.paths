# Saphira v0.1 foundational bootstrap seed for a v0.2 disposable root.
#
# This is deliberately not a package dependency list.  "path" copies one
# file or symlink and "tree" copies only the named foundational header tree.
# Package development headers, pkg-config data, Python modules, and /lib64
# are intentionally outside this boundary.

path /lib/ld-musl-x86_64.so.1
path /lib/libc.so
path /usr/lib/libc.so
path /usr/lib/libc.a
path /usr/lib/libdl.a
path /usr/lib/libm.a
path /usr/lib/libpthread.a
path /usr/lib/libresolv.a
path /usr/lib/librt.a
path /usr/lib/libutil.a
path /usr/lib/libxnet.a
# Temporary generation-zero runtimes for trusted v0.1 repository tools.
# Perl requires libcrypt.so.2 and binutils requires libfl.so.2, but the
# established repository currently has no APK producer for either library.
path /usr/lib/libcrypt.so.2
path /usr/lib/libcrypt.so.2.0.0
path /usr/lib/libfl.so.2
path /usr/lib/libfl.so.2.0.0
path /usr/lib/crt1.o
path /usr/lib/Scrt1.o
path /usr/lib/rcrt1.o
path /usr/lib/crti.o
path /usr/lib/crtn.o

tree /usr/include/arpa
tree /usr/include/asm
tree /usr/include/asm-generic
tree /usr/include/bits
tree /usr/include/linux
tree /usr/include/net
tree /usr/include/netinet
tree /usr/include/netpacket
tree /usr/include/scsi
tree /usr/include/sys

