#!/usr/bin/python3

"""Construct unsigned APKs from one normalized staged-tree manifest."""

from __future__ import annotations

import hashlib
import json
import os
import posixpath
import re
import shutil
import stat as stat_module
import subprocess
import sys
import tempfile
from pathlib import Path, PurePosixPath
from typing import NoReturn


CONFIG_KEYS = (
    "SAPHIRA_BUILD_ROOT",
    "SAPHIRA_PACKAGE_TMP",
    "SAPHIRA_INCOMING_DIR",
    "SAPHIRA_ARCH",
    "SAPHIRA_APK",
)
PACKAGE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*$")
ACCOUNT_NAME_RE = re.compile(r"^[A-Za-z0-9_.][A-Za-z0-9_.-]*$")
ACCOUNT_ID_RE = re.compile(r"^[0-9]+$")
ACCOUNT_MODE_RE = re.compile(r"^0*[1-7][0-7]{2,3}$")
# root, wheel, spokes, and IDs 0-2 are foundation reservations, typed
# by kind: the USER root and UID 0 are refused; the GROUPS root, wheel
# and spokes and GIDs 0, 1 and 2 are refused, as is anchoring any
# service user to those groups as primary. (spokes is group-only: a
# user merely named spokes is not forbidden.) Root provisioning
# belongs exclusively to the base seed and firstboot. The helper and
# the publish gate re-check this independently (defense in depth).
RESERVED_USER_NAMES = frozenset({"root"})
RESERVED_GROUP_NAMES = frozenset({"root", "wheel", "spokes"})
RESERVED_GIDS = frozenset({0, 1, 2})
ACCOUNTS_DIR = PurePosixPath("usr/share/saphira/accounts.d")
IDENTITY_HELPER = "/usr/libexec/saphira/ensure-identity.sh"
IDENTITY_PROVIDER = "saphira-baselayout"
# UID/GID namespace policy (operator-locked):
#   0..199    preferred packaged system/service identities.
#   200..887  reserved package/system expansion and documented legacy
#             exceptions: accepted, but the build emits a notice and the
#             fragment must document the exception (comment + recipe note).
#   888..999  reserved for locally-compiled user services (useradd and
#             hand-provisioned fixed IDs such as qmail's live here; the
#             repository never hands these out, and the live reconciler
#             never creates in them - but a pre-existing local account
#             with attributes matching a declaration converges silently
#             instead of blocking the install).
#   1000..    human users (firstboot territory, never packages).
# Fixed IDs are the norm, not an exception: a recipe declares whatever
# stable ID its service needs inside 0..199 (or a documented 200..887
# exception), and the publish gate keeps the union collision-free. The
# gate re-checks these tiers (defense in depth); makepkg fails the
# build fast on anything outside 0..887.
MAX_PACKAGED_ID = 887
PREFERRED_MAX_ID = 199
# The generated scripts exec the platform reconciler under /bin/sh and use
# coreutils (stat/mkdir/chown/chmod/dirname); apk installs dependencies
# first, so declaring these orders the shell and tools before any script
# can run — including mid-assembly, where the target has no shell yet.
IDENTITY_DEPS = ("saphira-baselayout", "bash", "coreutils")


def parse_accounts_fragment(path: Path) -> tuple[dict[str, list[dict[str, str]]], list[str]]:
    """Strictly validate a package account declaration fragment.

    Recipe authors declare identities only; makepkg generates the
    install scripts from this. Anything malformed fails the build.
    Returns the parsed declaration plus range notices (200..887
    expansion IDs must be documented exceptions - the notice names
    them so the build log carries the reminder).
    """
    users: list[dict[str, str]] = []
    groups: list[dict[str, str]] = []
    dirs: list[dict[str, str]] = []
    notices: list[str] = []
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        die(f"cannot read account fragment: {path}")
        raise AssertionError("unreachable")
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        kind = parts[0]
        if kind == "group" and len(parts) == 3:
            name, gid = parts[1], parts[2]
            if not ACCOUNT_NAME_RE.fullmatch(name):
                die(f"account fragment {path}:{lineno}: invalid group name")
            if not ACCOUNT_ID_RE.fullmatch(gid) or not 0 <= int(gid) <= MAX_PACKAGED_ID:
                die(f"account fragment {path}:{lineno}: GID must be 0..{MAX_PACKAGED_ID} (preferred 0..{PREFERRED_MAX_ID}; 888..999 are local-user-service territory, 1000+ human)")
            if name in RESERVED_GROUP_NAMES or int(gid) in RESERVED_GIDS:
                die(f"account fragment {path}:{lineno}: group '{name}'/{int(gid)} is a reserved foundation identity and must never be package-declared")
            if not ACCOUNT_ID_RE.fullmatch(gid) or not 0 <= int(gid) <= MAX_PACKAGED_ID:
                die(f"account fragment {path}:{lineno}: GID must be 0..{MAX_PACKAGED_ID} (preferred 0..{PREFERRED_MAX_ID}; 888..999 are local-user-service territory, 1000+ human)")
            if int(gid) > PREFERRED_MAX_ID:
                notices.append(f"account fragment {path}:{lineno}: GID {int(gid)} is in the 200..887 expansion range (preferred 0..{PREFERRED_MAX_ID}; expansion IDs must be documented exceptions)")
            groups.append({"name": name, "gid": str(int(gid))})
        elif kind == "user" and len(parts) == 6:
            _, name, uid, primary, home, shell = parts
            if not ACCOUNT_NAME_RE.fullmatch(name):
                die(f"account fragment {path}:{lineno}: invalid user name")
            if not ACCOUNT_NAME_RE.fullmatch(primary):
                die(f"account fragment {path}:{lineno}: invalid primary group")
            if not ACCOUNT_ID_RE.fullmatch(uid) or not 0 <= int(uid) <= MAX_PACKAGED_ID:
                die(f"account fragment {path}:{lineno}: UID must be 0..{MAX_PACKAGED_ID} (preferred 0..{PREFERRED_MAX_ID}; 888..999 are local-user-service territory, 1000+ human)")
            if name in RESERVED_USER_NAMES or int(uid) == 0:
                die(f"account fragment {path}:{lineno}: user '{name}' is a reserved system identity (root/UID 0) and must never be package-declared")
            if primary in RESERVED_GROUP_NAMES:
                die(f"account fragment {path}:{lineno}: primary group '{primary}' is a reserved foundation group; service users must not be anchored to it")
            if not ACCOUNT_ID_RE.fullmatch(uid) or not 0 <= int(uid) <= MAX_PACKAGED_ID:
                die(f"account fragment {path}:{lineno}: UID must be 0..{MAX_PACKAGED_ID} (preferred 0..{PREFERRED_MAX_ID}; 888..999 are local-user-service territory, 1000+ human)")
            if int(uid) > PREFERRED_MAX_ID:
                notices.append(f"account fragment {path}:{lineno}: UID {int(uid)} is in the 200..887 expansion range (preferred 0..{PREFERRED_MAX_ID}; expansion IDs must be documented exceptions)")
            if not home.startswith("/") or not shell.startswith("/"):
                die(f"account fragment {path}:{lineno}: home and shell must be absolute")
            users.append({"name": name, "uid": str(int(uid)), "primary": primary,
                          "home": home, "shell": shell})
        elif kind == "dir" and len(parts) == 5:
            _, dirpath, mode, owner, group = parts
            if not dirpath.startswith("/"):
                die(f"account fragment {path}:{lineno}: dir path must be absolute")
            if not ACCOUNT_MODE_RE.fullmatch(mode):
                die(f"account fragment {path}:{lineno}: invalid mode")
            dirs.append({"path": dirpath, "mode": mode, "owner": owner, "group": group})
        else:
            die(f"account fragment {path}:{lineno}: malformed stanza")
    return ({"users": users, "groups": groups, "dirs": dirs}, notices)


def identity_scripts(fragment_rel: str, temp_root: Path, name: str,
                       fragment_text: str) -> tuple[list[str], Path, Path, Path]:
    """Generate the thin install/upgrade/deinstall callers for a fragment.

    Package scripts may only invoke the platform reconciler; the
    declaration fragment is the single source of truth. The
    post-deinstall caller embeds the validated declaration text
    because apk runs it after the payload (including the fragment
    file itself) has been removed.
    """
    body = (f"#!/bin/sh\n"
            f"# Generated by saphira makepkg from {fragment_rel}.\n"
            f"# Package scripts may only invoke the platform identity reconciler.\n"
            f"set -eu\n"
            f"exec {IDENTITY_HELPER} \"/{fragment_rel}\"\n")
    post_install = temp_root / f"post-install-{name}"
    post_upgrade = temp_root / f"post-upgrade-{name}"
    post_install.write_text(body, encoding="utf-8")
    post_upgrade.write_text(body, encoding="utf-8")
    post_install.chmod(0o755)
    post_upgrade.chmod(0o755)
    marker = "SAPHIRA_IDENTITY_EOF"
    if marker in fragment_text:
        die(f"account fragment embeds the reserved marker: {marker}")
    if not fragment_text.endswith("\n"):
        fragment_text += "\n"
    deinstall_body = (f"#!/bin/sh\n"
                      f"# Generated by saphira makepkg from {fragment_rel}.\n"
                      f"# Package scripts may only invoke the platform identity reconciler.\n"
                      f"# The declaration is embedded: apk runs post-deinstall after\n"
                      f"# the payload fragment file itself has been removed.\n"
                      f"set -eu\n"
                      f"fragment=$(mktemp \"${{TMPDIR:-/tmp}}/saphira-identity.XXXXXX\") || exit 1\n"
                      f"trap 'rm -f -- \"$fragment\"' EXIT HUP INT TERM\n"
                      f"cat > \"$fragment\" <<'{marker}'\n"
                      f"{fragment_text}"
                      f"{marker}\n"
                      f"exec {IDENTITY_HELPER} --disable \"$fragment\"\n")
    post_deinstall = temp_root / f"post-deinstall-{name}"
    post_deinstall.write_text(deinstall_body, encoding="utf-8")
    post_deinstall.chmod(0o755)
    return (["-s", f"post-install:{post_install}", "-s", f"post-upgrade:{post_upgrade}",
             "-s", f"post-deinstall:{post_deinstall}"],
            post_install, post_upgrade, post_deinstall)


class PackageError(RuntimeError):
    pass


def die(message: str) -> NoReturn:
    raise PackageError(message)


def run(command: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(command, check=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except FileNotFoundError:
        die(f"required controller tool is missing: {command[0]}")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "").strip()
        die(f"command failed: {command[0]}: {detail or exc.returncode}")


def load_config() -> dict[str, str]:
    config_path = os.environ.get("SAPHIRA_CONFIG_FILE", "/etc/saphira/package_builder.sh")
    script = r'''
set -eu
set -a
. "$1"
shift
for name do
    value=${!name-}
    builtin printf '%s\0%s\0' "$name" "$value"
done
'''
    result = subprocess.run(
        ["/bin/bash", "--noprofile", "--norc", "-c", script, "makepkg-config", config_path, *CONFIG_KEYS],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    parts = result.stdout.split(b"\0")
    values = {parts[index].decode(): parts[index + 1].decode() for index in range(0, len(parts) - 1, 2)}
    missing = [key for key in CONFIG_KEYS if not values.get(key)]
    if missing:
        die(f"configuration fields are empty: {', '.join(missing)}")
    return values


def contained_path(parent: Path, relative: str, label: str) -> Path:
    pure = PurePosixPath(relative)
    if pure.is_absolute() or not pure.parts or any(part in ("", ".", "..") for part in pure.parts):
        die(f"invalid {label} path: {relative}")
    candidate = parent.joinpath(*pure.parts)
    current = parent
    for part in pure.parts:
        current = current / part
        if current.is_symlink():
            die(f"{label} path traverses a symlink: {relative}")
    return candidate


def validate_symlink(payload: Path, link: Path) -> None:
    target = os.readlink(link)
    if "\0" in target:
        die(f"payload symlink contains NUL: {link}")
    relative_link = link.relative_to(payload).as_posix()
    if target.startswith("/"):
        normalized = posixpath.normpath(target).lstrip("/")
    else:
        normalized = posixpath.normpath(posixpath.join(posixpath.dirname(relative_link), target))
    if normalized == ".." or normalized.startswith("../"):
        die(f"payload symlink escapes transaction: {relative_link} -> {target}")
    if "lib64" in PurePosixPath(normalized).parts:
        die(f"payload symlink violates Saphira /lib-only layout: {relative_link} -> {target}")


def validate_payload(payload: Path) -> None:
    if not payload.is_dir():
        die(f"payload directory does not exist: {payload}")
    found = False
    for root, directories, files in os.walk(payload, topdown=True, followlinks=False):
        root_path = Path(root)
        for name in sorted(directories + files):
            found = True
            path = root_path / name
            relative = path.relative_to(payload)
            if "lib64" in relative.parts:
                die(f"payload violates Saphira /lib-only layout: {relative}")
            if path.is_symlink():
                validate_symlink(payload, path)
    if not found:
        die(f"payload is empty: {payload}")


def metadata_from_apk(apk: str, artifact: Path) -> tuple[dict[str, str], list[str]]:
    dump = run([apk, "adbdump", str(artifact)]).stdout
    metadata: dict[str, str] = {}
    dependencies: list[str] = []
    reading_dependencies = False
    dump_lines = dump.splitlines()
    i = 0
    n = len(dump_lines)
    while i < n:
        line = dump_lines[i]
        i += 1
        if line.startswith("paths:"):
            break
        if line.startswith("  depends:"):
            reading_dependencies = True
            continue
        if reading_dependencies and line.startswith("    - "):
            dependencies.append(line[len("    - "):])
            continue
        if reading_dependencies and line.startswith("  ") and not line.startswith("    "):
            reading_dependencies = False
        match = re.match(r"  (name|version|arch|description|license|origin|url|build-time): (.*)", line)
        if match:
            value = match.group(2)
            # adb writers quote or fold values containing reserved
            # punctuation: short ones stay inline inside single quotes,
            # long/multiline ones become a '|' block scalar whose body is
            # the following more-indented lines.
            if len(value) >= 2 and value[0] == "'" and value[-1] == "'":
                value = value[1:-1]
            elif value == "|":
                block = []
                while i < n and dump_lines[i].startswith("    "):
                    block.append(dump_lines[i][4:])
                    i += 1
                value = "\n".join(block)
            metadata[match.group(1)] = value
    for line in dump.splitlines():
        if line.strip().startswith(("user:", "group:")) and not line.rstrip().endswith("root"):
            die(f"APK payload ownership is not root:root: {artifact}")
    return metadata, dependencies


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def copy_payload(payload: Path, destination: Path) -> None:
    """Copy the staged payload, PRESERVING hardlinks.

    shutil.copytree silently splits hardlink groups into independent
    files (upstream make-install links tool drivers together - binutils'
    objdump/ld/... and gcc's driver set), which duplicated hundreds of
    MiB per package. First occurrence of an inode is copied, further
    occurrences are linked back to it; symlinks are preserved as-is.
    """
    destination.mkdir(parents=True, exist_ok=True)
    seen: dict[tuple[int, int], Path] = {}
    for src in sorted(payload.rglob("*")):
        rel = src.relative_to(payload)
        dst = destination / rel
        if src.is_symlink():
            dst.symlink_to(src.readlink())
        elif src.is_dir():
            dst.mkdir(parents=True, exist_ok=True)
            # mkdir applies the process umask, which silently dropped
            # directory permission bits (a 2775 shared dir shipped as
            # 0755). File modes survive through the hardlink inodes, so
            # directories are the only gap; carry the exact mode over.
            os.chmod(dst, stat_module.S_IMODE(src.stat().st_mode))
        else:
            st = src.stat()
            key = (st.st_dev, st.st_ino)
            first = seen.get(key)
            if first is not None:
                try:
                    os.link(first, dst)
                    continue
                except OSError:
                    pass
            try:
                os.link(src, dst)
            except OSError:
                shutil.copy2(src, dst, follow_symlinks=False)
            seen[key] = dst


def strip_payload(payload: Path) -> int:
    """Strip debug sections from ELF content in the payload.

    The toolchain builds with -g by default, so unstripped payloads ship
    hundreds of MiB of DWARF per binary (gcc's cc1 alone carried ~280 MiB).
    Binaries and shared libraries get --strip-unneeded; static archives get
    --strip-debug (symbol index preserved). Skipped entirely when strip is
    unavailable (payloads built without binutils).
    """
    strip = shutil.which("strip")
    if not strip:
        return 0
    count = 0
    for path in sorted(payload.rglob("*")):
        if not path.is_file() or path.is_symlink():
            continue
        try:
            with path.open("rb") as f:
                if f.read(4) != b"\x7fELF":
                    continue
        except OSError:
            continue
        # Kernel modules: never strip until module safety is explicitly
        # verified (operator directive - saphira-kernel/saphira-zfs stay
        # out of the first strip pass).
        if path.suffix in (".ko", ".ko.xz", ".ko.zst"):
            continue
        args = [strip, "--strip-unneeded", str(path)]
        if path.suffix == ".a":
            args = [strip, "--strip-debug", str(path)]
        # Tolerant: an odd ELF file must never fail the whole build.
        subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        count += 1
    return count


def construct(apk: str, payload: Path, arguments: list[str], producer: str) -> str:
    # apk-tools 3 reads payload ownership through statx, which the musl
    # libfakeroot build does not intercept, so fakeroot would silently
    # record the invoking user.  Construct instead inside an isolated user
    # namespace with a real mapped root: the chown is genuine, the process
    # stays unprivileged on the host, and ownership is correct by
    # construction rather than by interception.
    del producer
    # The kernel clears setuid/setgid bits on any chown, so the -R 0:0
    # would silently strip them from the payload (sudo lost its setuid
    # bit this way - see the hatchling sudo incident).  Record the
    # special bits before the chown and restore them afterwards.
    # Directories are included too: a setgid directory (drwxrwsr-x)
    # loses its bit just the same.  Only symlinks are skipped - chmod
    # on a symlink would follow it and mutate the target.
    special: list[str] = []
    for path in sorted(payload.rglob("*")):
        if path.is_symlink():
            continue
        mode = path.stat().st_mode & 0o7777
        if mode & 0o7000:
            special.append(f"{oct(mode)[2:]} {path}")
    modes_file = payload.parent / f".special-modes-{payload.name}"
    modes_file.write_text("\n".join(special) + ("\n" if special else ""), encoding="utf-8")
    shell_script = (
        'payload=$1; modes=$2; shift 2; chown -R 0:0 "$payload"; '
        'while IFS=" " read -r mode path; do '
        '[ -n "$path" ] || continue; chmod "$mode" "$path" || exit 1; done < "$modes"; '
        'rm -f "$modes"; exec "$@"'
    )
    command_tail = [apk, "mkpkg", "-F", str(payload), *arguments]
    unshare = shutil.which("unshare")
    if not unshare:
        die("unshare is required for rootless payload ownership")
    run([
        unshare, "--user", "--map-root-user", "/bin/sh", "-c", shell_script,
        "makepkg", str(payload), str(modes_file), *command_tail,
    ])
    import subprocess as sp
    r = sp.run(["stat","-c","%a",str(payload/"usr/bin/sudo")],capture_output=True,text=True)
    print(f"DEBUG post-construct sudo mode={r.stdout.strip()}", file=sys.stderr)
    modes_file.unlink(missing_ok=True)
    return "userns-maproot"


def real_root() -> bool:
    """True only for genuine host root; a mapped uid 0 inside an
    unprivileged user namespace is still an unprivileged controller."""
    if os.geteuid() != 0:
        return False
    try:
        with open("/proc/self/uid_map", encoding="utf-8") as stream:
            row = stream.readline().split()
    except OSError:
        return True
    return row == ["0", "0", "1"]


def main() -> int:
    if real_root():
        print("makepkg: must run as an unprivileged controller", file=sys.stderr)
        return 1
    if len(sys.argv) != 2 or not PACKAGE_RE.fullmatch(sys.argv[1]):
        print(f"usage: {sys.argv[0]} PACKAGE", file=sys.stderr)
        return 1
    producer = sys.argv[1]
    try:
        config = load_config()
        stage_root = contained_path(Path(config["SAPHIRA_BUILD_ROOT"]), producer, "stage")
        manifest_path = stage_root / "manifest.json"
        with manifest_path.open(encoding="utf-8") as stream:
            manifest = json.load(stream)
        if manifest.get("schema") != "saphira-stage-manifest/v1" or manifest.get("name") != producer:
            die(f"invalid normalized stage manifest: {manifest_path}")
        for key in ("version", "arch", "license", "origin", "url", "build_time", "outputs"):
            if key not in manifest:
                die(f"stage manifest field is missing: {key}")
        if manifest["arch"] not in (config["SAPHIRA_ARCH"], "noarch"):
            die(f"stage architecture does not match transaction: {manifest['arch']}")

        artifact_dir = Path(config["SAPHIRA_INCOMING_DIR"]) / config["SAPHIRA_ARCH"]
        artifact_dir.mkdir(parents=True, exist_ok=True)
        package_tmp = Path(config["SAPHIRA_PACKAGE_TMP"])
        package_tmp.mkdir(parents=True, exist_ok=True)
        temp_root = Path(tempfile.mkdtemp(prefix=f"makepkg-{producer}-", dir=package_tmp))
        receipts = []
        try:
            for output in manifest["outputs"]:
                name = output.get("name", "")
                if not PACKAGE_RE.fullmatch(name):
                    die(f"invalid output name in stage manifest: {name}")
                payload = contained_path(stage_root, output.get("payload", ""), "payload")
                validate_payload(payload)
                payload_copy = temp_root / f"payload-{name}"
                copy_payload(payload, payload_copy)
                stripped = strip_payload(payload_copy)
                # Account identities: a fragment accounts.d/<output-name>
                # is the recipe's whole declaration. makepkg validates it,
                # generates the thin install/upgrade callers, and adds the
                # helper dependency. Stray fragments (owned by nobody or by
                # another output) fail the build: one package owns each
                # declared identity.
                payload_accounts = payload_copy / ACCOUNTS_DIR
                stray = []
                if payload_accounts.is_dir():
                    for entry in sorted(payload_accounts.iterdir()):
                        if entry.is_file() and entry.name != name:
                            stray.append(entry.name)
                if stray:
                    die(f"payload carries foreign account fragments: {', '.join(stray)}")
                fragment_rel = (ACCOUNTS_DIR / name).as_posix()
                fragment_path = payload_copy / fragment_rel
                accounts: dict[str, list[dict[str, str]]] = {"users": [], "groups": [], "dirs": []}
                script_arguments: list[str] = []
                if fragment_path.is_file():
                    accounts, range_notices = parse_accounts_fragment(fragment_path)
                    for notice in range_notices:
                        print(f"makepkg: notice: {notice}")
                    try:
                        fragment_text = fragment_path.read_text(encoding="utf-8")
                    except OSError:
                        die(f"cannot read account fragment: {fragment_path}")
                    script_arguments, _, _, _ = identity_scripts(
                        fragment_rel, temp_root, name, fragment_text)
                artifact = artifact_dir / f"{name}-{manifest['version']}.apk"
                if artifact.exists() or artifact.is_symlink():
                    die(f"artifact already exists in private transaction: {artifact}")
                temporary_artifact = temp_root / artifact.name
                arguments = [
                    "--info", f"name:{name}",
                    "--info", f"version:{manifest['version']}",
                    "--info", f"arch:{manifest['arch']}",
                    "--info", f"description:{output['description']}",
                    "--info", f"license:{manifest['license']}",
                    "--info", f"origin:{manifest['origin']}",
                    "--info", f"url:{manifest['url']}",
                    "--info", f"build-time:{manifest['build_time']}",
                ]
                dependencies = output.get("dependencies", [])
                if accounts["users"] or accounts["groups"]:
                    # The generated scripts exec the baselayout helper, so
                    # its provider plus a shell and coreutils must be
                    # installed first: apk orders by dependency, and the
                    # scripts fail closed without them.
                    for requirement in IDENTITY_DEPS:
                        if name != requirement and requirement not in dependencies:
                            dependencies = [*dependencies, requirement]
                if dependencies:
                    arguments.extend(("--info", f"depends:{' '.join(dependencies)}"))
                replaces = manifest.get("replaces") or []
                if replaces:
                    # Space-separated like depends=: apk splits replaces
                    # items on whitespace (verified: comma-joined multi
                    # names collapse into one unmatchable token and the
                    # takeover silently fails - see grub r4).
                    arguments.extend(("--info", f"replaces:{' '.join(replaces)}"))
                arguments.extend(("-o", str(temporary_artifact)))
                arguments.extend(script_arguments)
                backend = construct(config["SAPHIRA_APK"], payload_copy, arguments, producer)
                run([config["SAPHIRA_APK"], "verify", "--allow-untrusted", str(temporary_artifact)])
                metadata, recorded_dependencies = metadata_from_apk(config["SAPHIRA_APK"], temporary_artifact)
                dump = run([config["SAPHIRA_APK"], "adbdump", str(temporary_artifact)]).stdout
                if accounts["users"] or accounts["groups"]:
                    for script in ("post-install", "post-upgrade", "post-deinstall"):
                        if script not in dump:
                            die(f"constructed APK is missing generated identity script {script}: {temporary_artifact}")
                expected = {
                    "name": name,
                    "version": manifest["version"],
                    "arch": manifest["arch"],
                    "description": output["description"],
                    "license": manifest["license"],
                    "origin": manifest["origin"],
                    "url": manifest["url"],
                    "build-time": str(manifest["build_time"]),
                }
                if any(metadata.get(key) != value for key, value in expected.items()):
                    die(f"constructed APK metadata differs from normalized manifest: {temporary_artifact}")
                if sorted(recorded_dependencies) != sorted(dependencies):
                    die(f"constructed APK dependencies differ from normalized manifest: {temporary_artifact}")
                os.replace(temporary_artifact, artifact)
                digest = sha256_file(artifact)
                receipts.append({"name": name, "artifact": str(artifact), "sha256": digest,
                                 "backend": backend, "accounts": accounts})
        finally:
            shutil.rmtree(temp_root)

        receipt_path = stage_root / "artifact-manifest.json"
        with receipt_path.open("x", encoding="utf-8") as stream:
            json.dump({
                "schema": "saphira-artifact-manifest/v1",
                "constructor": "makepkg",
                "producer": producer,
                "artifacts": receipts,
            }, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
        print(f"makepkg: created {len(receipts)} unsigned APK(s) for {producer}")
        return 0
    except (OSError, ValueError, json.JSONDecodeError, PackageError) as exc:
        print(f"makepkg: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
