def layout_allowed(relative_posix: str, producer: str) -> bool:
    """True when a payload path is covered by an explicit exception."""
    for allowed_path, owner in LAYOUT_ALLOW.items():
        if owner != producer:
            continue
        if relative_posix == allowed_path:
            return True
        if allowed_path.startswith(relative_posix + "/"):
            return True
    return False
