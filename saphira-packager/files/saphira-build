# --- Optional MCP journal bridge (fail-open, non-blocking) -----------------
#
# saphira-build is independent: it never requires the MCP journal to exist,
# be writable, or be schema-compatible. When the journal database IS present
# (SBM_NOTES_DB, else STATE/notes.db - the MCP's own database), the builder
# opportunistically records outstanding-work transitions as session_events
# rows so the agent learns of failures without polling.
#
# Rules, all load-bearing:
# - Never create the journal file. sqlite3.connect() creates on open, so the
#   path must pass is_file() first. No journal, no bridge, build unaffected.
# - Negligible delay only: timeout=0 (never wait on a lock). On contention,
#   missing file, read-only dir, schema mismatch, or ANY error: skip and
#   return False. Recovery is the MCP's startup reconciliation, never a
#   builder retry. The builder's own builds-table commit always precedes any
#   bridge attempt and never depends on its outcome.
# - Exact-match identity only, never LIKE: title is the stable key
#   "bridge:<builder>:<build_id>:<event>:<seq>", checked with `=`. The body
#   carries the full JSON detail (bridge_v, builder, build_id, seq, event,
#   nvr, state, stage/detail, hashes, log dir, timestamps).
# - One event per transition: terminal FAIL/INTERRUPTED use seq 1 (the row
#   never transitions again; retries create new rows). BLOCKED uses a
#   per-row blocked_seq stored in result_json["bridge"] so re-entries with
#   identical blockers still distinguish transitions. STALLED/AWAITING use
#   age buckets in the event name (build.stalled.6h) so each bucket emits
#   at most once per row.
BRIDGE_VERSION = 1
BRIDGE_REQUIRED_COLUMNS = {
    "event", "package", "label", "title", "body",
    "author", "recorder", "created_at",
}
STALLED_AFTER_S = 3600
AWAITING_AFTER_S = 86400


def builder_id():
    """Stable builder identity: explicit env wins, else the builder hostname.

    Survives reboots (unlike pid/boot_id) and distinguishes builders sharing
    one journal (Egg vs armer via hostname). Deliberately reconstructible
    from builds.builder_host so MCP reconciliation computes identical event
    keys without the builder present. Never requires the MCP to exist."""

    explicit = os.environ.get("SAPHIRA_BUILDER_ID")
    if explicit:
        return explicit
    explicit = os.environ.get("SAPHIRA_BUILDER_NAME")
    if explicit:
        return explicit
    try:
        return socket.gethostname()
    except OSError:
        return "unknown-builder"


def bridge_journal_path():
    """Journal path the bridge may write, or None when bridging is off."""
    override = os.environ.get("SBM_NOTES_DB")
    if override:
        return Path(override)
    return STATE / "notes.db"


def bridge_emit(event, pkg, nvr, build_id, seq, detail):
    """Opportunistically insert one session_events row. Never raises.

    Returns True when the event is present (already there or just inserted),
    False when bridging was skipped (no journal, locked, schema mismatch,
    any error). Callers must never branch build logic on the outcome."""
    try:
        path = bridge_journal_path()
        if not path.is_file():
            return False
        key = f"bridge:{builder_id()}:{int(build_id)}:{event}:{int(seq)}"
        body = json.dumps({
            "bridge_v": BRIDGE_VERSION,
            "builder": builder_id(),
            "build_id": int(build_id),
            "seq": int(seq),
            "event": event,
            "package": pkg,
            "nvr": nvr,
            "detail": detail,
        }, sort_keys=True)
        conn = sqlite3.connect(str(path), timeout=0)
        try:
            cols = {r[1] for r in conn.execute("PRAGMA table_info(session_events)")}
            if not BRIDGE_REQUIRED_COLUMNS.issubset(cols):
                return False
            hit = conn.execute(
                "SELECT 1 FROM session_events WHERE event=? AND title=?",
                (event, key),
            ).fetchone()
            if hit:
                return True
            conn.execute(
                "INSERT OR IGNORE INTO session_events"
                "(event,package,label,title,body,author,recorder,created_at)"
                " VALUES(?,?,?,?,?,?,?,?)",
                (event, pkg, nvr or "", key, body,
                 "saphira-build", "builder-bridge", now()),
            )
            conn.commit()
            return True
        finally:
            conn.close()
    except Exception:
        return False


def bridge_row_seq(result, field="seq"):
    """Current per-row bridge sequence number stored in result_json."""
    try:
        return int(result.get("bridge", {}).get(field, 0))
    except (ValueError, TypeError, AttributeError):
        return 0


def bridge_bump_seq(result, field="seq"):
    """Increment and return the per-row bridge sequence number."""
    seq = bridge_row_seq(result, field) + 1
    bridge = dict(result.get("bridge") or {})
    bridge[field] = seq
    result["bridge"] = bridge
    return seq


def nvr_is_published(pkg, ver_rel):
    """True when the exact NVR exists in the live repository.

    A published NVR is succeeded work even when an older queue row for the
    package reads BLOCKED or FAIL: the revision the queue was working toward
    is already in the repo. Callers use the ROW's NVR, never the recipe's,
    so a failed r4 is never hidden by a published r1."""
    if not ver_rel:
        return False
    try:
        return ver_rel in published_versions(pkg)
    except Exception:
        return False


def row_nvr(row):
    """'version-r revision' for a builds row, or '' when unknown."""
    try:
        ver = row["version"] if isinstance(row, sqlite3.Row) else row.get("version")
        rev = row["revision"] if isinstance(row, sqlite3.Row) else row.get("revision")
    except Exception:
        return ""
    parts = [p for p in (ver, ("r" + str(rev)) if rev else "") if p and p != "r"]
    return "-".join(parts)


def effective_state(conn, row, req_nvr, repo_nvrs):
    """Current effective state for a latest-per-package queue row.

    Determined from the requested recipe NVR, actual repository
    publication and the row's own attempt - never from the latest row
    alone: a FAILED r4 with a published r1 behind it is still FAILED
    (the requested work failed), while any exact-NVR match in the repo
    is succeeded work even when the row reads BLOCKED/FAIL (stale
    queue state must never shadow a satisfied revision). Returns
    (state_text, note). STALE means the recipe moved past this attempt:
    kept visible for history, excluded from needs-attention counts.
    """
    row_ver_rel = row_nvr(row)
    state = row["state"]
    if row_ver_rel and row_ver_rel in repo_nvrs:
        return "PUBLISHED", "succeeded (NVR published)"
    if state in ("QUEUED", "BUILDING"):
        return state, ""
    if state == "BLOCKED":
        return state, ""
    if state == "INTERRUPTED":
        return state, ""
    if state == "FAIL":
        if req_nvr and row_ver_rel and req_nvr != row_ver_rel:
            return "STALE", f"failed {row_ver_rel}; recipe now {req_nvr}"
        return state, ""
    if state == "PASS":
        if row["published_at"]:
            return "PUBLISHED", ""
        return "AWAITING SIGNING", ""
    return state, ""


def _packager_conf(name, default):
    """Read one packager config value: explicit env wins, else the
    SAPHIRA_CONFIG_FILE default chain (/etc/saphira/package_builder.sh),
    else the compiled-in default. Pure assignments file, safe to source."""
    if name in os.environ:
        return os.environ[name]
    cfg = os.environ.get("SAPHIRA_CONFIG_FILE", "/etc/saphira/package_builder.sh")
    try:
        out = subprocess.run(
            ["bash", "-c", "source /dev/stdin >/dev/null 2>&1; printf '%s' \"${" + name + ":-" + default + "}\""],
            input=open(cfg).read() if os.path.isfile(cfg) else "",
            capture_output=True, text=True, timeout=10)
        if out.returncode == 0 and out.stdout:
            return out.stdout
    except Exception:
        pass
    return default


def _live_repo_dir():
    """Live generation repository: the LAST SAPHIRA_REPO_NAMES entry
    (checkpkg rule). Explicit SAPHIRA_REPO stays a full-path escape
    hatch (used by the test suites)."""
    if "SAPHIRA_REPO" in os.environ:
        return Path(os.environ["SAPHIRA_REPO"])
    names = _packager_conf("SAPHIRA_REPO_NAMES", "hatchling").split()
    live = names[-1] if names else "hatchling"
    arch = _packager_conf("SAPHIRA_ARCH", "x86_64")
    return Path(_packager_conf("SAPHIRA_REPO_DIR", "/out/stage4/packages")) / live / arch


def _incoming_dir():
    if "SAPHIRA_INCOMING" in os.environ:
        return Path(os.environ["SAPHIRA_INCOMING"])
    arch = _packager_conf("SAPHIRA_ARCH", "x86_64")
    return Path(_packager_conf("SAPHIRA_INCOMING_DIR", "/out/stage4/incoming")) / arch


