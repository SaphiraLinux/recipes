BOOT_ID_PATH = Path("/proc/sys/kernel/random/boot_id")


def boot_id():
    """Identity of the current boot.

    This is what makes an interrupted build distinguishable from a running
    one across a reboot: a row written before the reboot records a different
    boot id, so it cannot be mistaken for work the current daemon is doing.
    A sentinel keeps the comparison meaningful where /proc is unavailable
    (the test hermetic roots), rather than silently treating 'unknown' as a
    match.
    """
    try:
        return BOOT_ID_PATH.read_text().strip() or "unknown-boot"
    except OSError:
        return "unknown-boot"


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
    except (OSError, ValueError, TypeError):
        return False
    return True

LOGNAME_RE = re.compile(r"^(?P<name>[A-Za-z0-9._+-]+)-(?P<ver>[0-9][^-]*)-r(?P<rel>[0-9]+)\.apk$")


def db():
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "logs").mkdir(exist_ok=True)
    conn = sqlite3.connect(STATE / "queue.db")
    conn.row_factory = sqlite3.Row
    conn.execute(
        """CREATE TABLE IF NOT EXISTS builds(
            id INTEGER PRIMARY KEY,
            package TEXT NOT NULL,
            version TEXT, revision TEXT,
            recipe_hash TEXT NOT NULL,
            state TEXT NOT NULL,
            result_json TEXT NOT NULL DEFAULT '{}',
            log_dir TEXT,
            commit_hash TEXT,
            queued_at TEXT, started_at TEXT, finished_at TEXT,
            published_at TEXT,
            builder_pid INTEGER, boot_id TEXT
        )"""
    )
    # Additive migration: the provenance columns arrived after rows already
    # existed. ALTER TABLE ADD COLUMN is a no-op-safe way to bring an
    # existing queue.db forward without touching its rows.
    have = {r["name"] for r in conn.execute("PRAGMA table_info(builds)")}
    for column, decl in (("builder_pid", "INTEGER"), ("boot_id", "TEXT"),
                         ("duration_s", "REAL"), ("cpu_s", "REAL"),
                         ("peak_rss_mb", "REAL"), ("timings_json", "TEXT"),
                         ("arch", "TEXT"), ("builder_host", "TEXT")):
        if column not in have:
            conn.execute(f"ALTER TABLE builds ADD COLUMN {column} {decl}")
    # Backfill wall durations for rows finished before the columns existed.
    # CPU/RSS are unrecoverable historically and stay NULL; SBU ratios are
    # a reporting layer added once the reference workload is defined.
    conn.execute(
        "UPDATE builds SET duration_s = "
        "(strftime('%s', finished_at) - strftime('%s', started_at)) "
        "WHERE finished_at IS NOT NULL AND started_at IS NOT NULL "
        "AND duration_s IS NULL"
    )
    # SBU reference baselines: one active row per (package, arch,
    # builder_host). History is retained; only the active row is read
    # for ratios. Raw seconds in builds stay authoritative regardless.
    conn.execute(
        "CREATE TABLE IF NOT EXISTS sbu_baseline("
        "id INTEGER PRIMARY KEY, package TEXT NOT NULL,"
        " version TEXT, revision TEXT, recipe_commit TEXT,"
        " arch TEXT, builder_host TEXT, cache_policy TEXT NOT NULL,"
        " wall_s REAL NOT NULL, cpu_s REAL,"
        " active INTEGER NOT NULL DEFAULT 0, calibrated_at TEXT NOT NULL)"
    )
    conn.commit()
    return conn


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def run(cmd, log=None, env=None):
    e = dict(os.environ)
    if env:
        e.update(env)
    if log:
        log.parent.mkdir(parents=True, exist_ok=True)
        with open(log, "ab") as f:
            f.write(f"\n$ {' '.join(map(str, cmd))}\n".encode())
            return subprocess.run(list(map(str, cmd)), stdout=f, stderr=subprocess.STDOUT, env=e).returncode
    return subprocess.run(list(map(str, cmd)), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=e).returncode


def run_out(cmd, env=None):
    e = dict(os.environ)
    if env:
        e.update(env)
    return subprocess.run(list(map(str, cmd)), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=e, text=True)


def recipe_dirs():
    out = []
    if not RECIPES.is_dir():
        return out
    for d in sorted(RECIPES.iterdir()):
        if (d / "recipe.sh").is_file():
            out.append(d)
    return out


def recipe_info(pkgdir):
    # subpackages are OUTPUTS, not inputs, and must not enter the dependency
    # list. norm_dep() reduces "-dev"/"-doc" to the base name, so declaring
    # subpackages="mhash-dev" made mhash depend on "mhash" - i.e. on itself.
    # A package that has never been published then deadlocks permanently: it
    # is BLOCKED waiting for a subpackage that only its own build can produce,
    # so it can never run, so it is never published. mhash sat in exactly
    # that state and blocked 23 packages behind it. A published package
    # escaped only because dep_state() is satisfied by a published version,
    # which is why this looked like it only affected new recipes.
    #
    # A genuine build-time need for another package's -dev output belongs in
    # makedepends explicitly, where it is stated rather than inferred.
    script = (
        '. "$1" >/dev/null 2>&1\n'
        'printf "%s\\n" "name=$pkgname" "ver=$pkgver" "rel=$pkgrel"'
        ' "disabled=${disabled-}" "reason=${disabled_reason-}"\n'
        'printf "deps=%s\\n" "$depends $makedepends"\n'
    )
    r = run_out(["/bin/sh", "-c", script, "sh", str(pkgdir / "recipe.sh")])
    info = {"pkgdir": str(pkgdir), "deps": []}
    for line in r.stdout.splitlines():
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        if k == "deps":
            info["deps"] = v.split()
        elif k == "ver":
            info["version"] = v
        elif k == "rel":
            info["revision"] = v
        elif k == "disabled":
            info["disabled"] = v
        elif k == "reason":
            info["reason"] = v
        elif k == "name" and v:
            info["name"] = v
    info.setdefault("name", pkgdir.name)
    return info


# Material that cannot affect the package artefact, so a change to it must not
# force a rebuild of that package.
#
# The rule is defined by DIRECTORY, not by file suffix, because a suffix rule
# would be wrong in both directions here: nftables installs
# files/saphira-classification-README.md into its payload, so a `.md` under
# files/ is a real build input, while a `.md` at a recipe's top level is not.
#
#   tests/, acceptance/  verification material. No recipe_build or
#                        recipe_install reads it; the suites read it from the
#                        tree directly.
#   *.sha256 sidecars    integrity metadata describing files/ content that is
#                        already hashed below. A retouched sidecar is not a
#                        change to any input.
#   editor/VCS droppings by name: a merge left one behind, it is not an input.
#
# Everything else is INCLUDED, and that is deliberate: under-inclusion means a
# rebuilt package that silently does not contain the change it was rebuilt
# for, while over-inclusion only costs one wasted build cycle. Where those two
# are in tension - a top-level README.md, say - inclusion wins.
HASH_EXCLUDED_DIRS = ("tests", "acceptance")
HASH_EXCLUDED_SUFFIXES = (".sha256",)
# fnmatch has no escape character, so these are literal patterns: "*~" is a
# backup, ".#*" and "#*#" are emacs lock and auto-save files.
HASH_EXCLUDED_NAMES = ("*~", "*.orig", "*.rej", "*.swp", "*.bak", ".#*", "#*#", ".DS_Store")


def hash_excluded(rel: Path) -> bool:
    if any(part in HASH_EXCLUDED_DIRS for part in rel.parts[:-1]):
        return True
    if rel.suffix in HASH_EXCLUDED_SUFFIXES:
        return True
    import fnmatch
    return any(fnmatch.fnmatch(rel.name, pattern) for pattern in HASH_EXCLUDED_NAMES)


def recipe_hash(pkgdir):
    """Identity of a recipe's build-relevant inputs.

    scan() uses this to decide whether a package needs building, so it must
    track the ARTEFACT and nothing else. Hashing the whole directory instead
    made an unrelated commit cost a build cycle: editing
    saphira-packager/tests/recipe-rules.sh requeued saphira-packager, and that
    package was rebuilt every scan for as long as the tree moved - which is
    also what produced the un-publishable-NVR churn recorded with it.
    """
    h = hashlib.sha256()
    included = 0
    for f in sorted(p for p in pkgdir.rglob("*") if p.is_file()):
        rel = f.relative_to(pkgdir)
        if hash_excluded(rel):
            continue
        included += 1
        h.update(str(rel).encode() + b"\0" + f.read_bytes() + b"\0")
    # The count is part of the identity, so adding or removing an included
    # input changes the hash even when no included byte differs.
    h.update(f"\0count={included}\0".encode())
    return h.hexdigest()[:16]


def norm_dep(tok):
    tok = re.split(r"[<>=]", tok)[0]
    for suf in ("-dev", "-doc", "-static", "-openrc", "-lang"):
        if tok.endswith(suf):
            return tok[: -len(suf)]
    return tok


def published_versions(pkg):
    if not REPO.is_dir():
        return set()
    out = set()
    for f in REPO.glob(f"{pkg}-*"):
        m = LOGNAME_RE.match(f.name)
        if m and m.group("name") == pkg:
            out.add(f"{m.group('ver')}-r{m.group('rel')}")
    return out


def latest(conn, pkg):
    return conn.execute(
        "SELECT * FROM builds WHERE package=? ORDER BY id DESC LIMIT 1", (pkg,)
    ).fetchone()


def commit_hash():
    r = run_out(["git", "-C", RECIPES, "rev-parse", "--short", "HEAD"])
    return r.stdout.strip() if r.returncode == 0 else ""


def sync_published(conn):
    """Backfill published_at for PASS rows already live in the repository.

    Publication normally runs through `saphira-build publish`, which stamps
    the row. But operators also run `sudo sign-apk-repo` directly (the
    documented human signing step), which regenerates indexes without
    touching the queue: the row then reads AWAITING SIGNING forever while
    its exact NVR is live (observed: grub/lvm2 r3 in the repo since Oct
    26/27, rows still AWAITING). This reconciles from repository.db,
    authoritative for what is published, using the repo's own
    published_at timestamp - never fabricated, never backdated to now.
    Exact-NVR only; fail-open (missing/unreadable repo DB skips silently).
    Returns the number of rows stamped.
    """
    try:
        import sqlite3 as _sq
        repodb = REPO / "repository.db"
        if not repodb.is_file():
            return 0
        rconn = _sq.connect(f"file:{repodb}?mode=ro", uri=True, timeout=0)
        try:
            rows = conn.execute(
                "SELECT id,package,version,revision FROM builds"
                " WHERE state='PASS' AND published_at IS NULL"
            ).fetchall()
            fixed = 0
            for r in rows:
                rel = ("r" + str(r["revision"])) if r["revision"] else ""
                ver_rel = "-".join(
                    x for x in (r["version"], rel) if x and x != "r")
                if not ver_rel:
                    continue
                hit = rconn.execute(
                    "SELECT published_at FROM packages WHERE name=? AND nvr=?",
                    (r["package"], f"{r['package']}-{ver_rel}"),
                ).fetchone()
                if hit and hit[0]:
                    conn.execute(
                        "UPDATE builds SET published_at=? WHERE id=?",
                        (hit[0], r["id"]),
                    )
                    fixed += 1
            conn.commit()
            return fixed
        finally:
            rconn.close()
    except Exception:
        return 0


def dep_state(conn, dep):
    """-> (satisfied: bool, blocker: bool, reason: str)"""
    rdir = RECIPES / dep
    if (rdir / "recipe.sh").is_file():
        row = latest(conn, dep)
        if row is not None and row["state"] == "PASS":
            return True, False, ""
        # Repository-first: a dep whose recipe is already published in the
        # repository satisfies consumers even when its queue row is stale,
        # BLOCKED or FAIL. The actual version-constraint check happens in
        # resolvepkg at build time (fail-closed with a visible error), so
        # the queue must not block forever on stale rows.
        if published_versions(dep):
            return True, False, ""
        if row is None:
            return False, False, f"{dep}: recipe queued but not yet built"
        if row["state"] == "FAIL":
            return False, True, f"{dep}: last build FAILED"
        if row["state"] == "BLOCKED":
            return False, True, f"{dep}: BLOCKED"
        return False, False, f"{dep}: {row['state']}"
    if published_versions(dep):
        return True, False, ""
    return False, False, f"{dep}: no recipe and no repository package"


def reconcile_interrupted(conn):
    """Retire BUILDING rows no live builder owns, explicitly.

    A build that was in flight when the machine died, or when the daemon was
    killed, or when the daemon was simply never restarted after a reboot,
    leaves its row in BUILDING forever.

    The harm is not cosmetic. cmd_retry() only requeues a row that is FAIL or
    BLOCKED, so a package whose most recent attempt died mid-build is
    permanently un-retryable: the one attempt that would have produced a FAIL
    row never happened, the row says BUILDING, and every future `retry` is
    refused with "is BUILDING, not FAIL/BLOCKED". Nothing in the system ever
    moves it. The queue database asserts, indefinitely, that work is in
    progress which is not in progress - the same failure shape as a
    persistence layer that keeps answering "was running" after the process is
    gone: an unrefreshed claim masquerading as a live one.

    So the claim is retired with its reason, rather than deleted or left to rot:

      boot changed      the row was written under a different boot id, so the
                        builder that owned it cannot be running now. This is
                        the reboot case, and it is exact rather than
                        heuristic - no threshold, no age guess.
      builder pid gone  same boot, but the recorded pid is not alive.
      unowned           a legacy row with neither recorded. Only this daemon
                        writes BUILDING, and reconcile runs before the loop
                        starts any build, so a row we did not write is a row
                        nobody is building.

    A row whose recorded pid is THIS process is never touched, so reconcile
    is safe to run against a live daemon, and a row owned by some other live
    builder is left alone too.

    Provenance is preserved, not discarded: the previous state, reason, pid,
    boot id, start time and log directory are all written into result_json
    under an `interrupted` block, and every stage that ran before the crash
    is kept. Only the BUILD verdict itself is replaced, because "pending"
    after a dead builder is precisely the untrue claim. The retained
    workspace and its logs remain the evidence.

    Nothing is requeued. An interrupted build is re-attempted by an explicit
    `retry PACKAGE`, never automatically: a machine that just lost power has
    not thereby proven that every in-flight build needs repeating.
    """
    current = boot_id()
    rows = conn.execute(
        "SELECT * FROM builds WHERE state='BUILDING' ORDER BY id"
    ).fetchall()
    retired = []
    for row in rows:
        if row["builder_pid"] and int(row["builder_pid"]) == os.getpid():
            continue  # ours, in this process: not stale
        if row["boot_id"] and row["boot_id"] != current:
            reason = "boot changed"
        elif row["builder_pid"] and not pid_alive(row["builder_pid"]):
            reason = "builder pid gone"
        elif row["builder_pid"] is None:
            reason = "unowned (no recorded builder)"
        else:
            continue  # a live builder owns it; not ours to retire
        result = json.loads(row["result_json"] or "{}")
        result.setdefault("stages", {})
        detail = (
            f"{reason}: pid={row['builder_pid']} boot={row['boot_id']} "
            f"started={row['started_at']} logs={row['log_dir']}"
        )
        result["stages"]["BUILD"] = {"status": "interrupted", "detail": detail}
        result["interrupted"] = {
            "previous_state": "BUILDING",
            "reason": reason,
            "builder_pid": row["builder_pid"],
            "boot_id": row["boot_id"],
            "started_at": row["started_at"],
            "log_dir": row["log_dir"],
        }
        finished = now()
        conn.execute(
            "UPDATE builds SET state='INTERRUPTED', finished_at=?, result_json=?,"
            " duration_s=CASE WHEN started_at IS NOT NULL"
            " THEN (strftime('%s', ?) - strftime('%s', started_at)) END,"
            " arch=?, builder_host=? WHERE id=?",
            (finished, json.dumps(result), finished,
             os.environ.get("SAPHIRA_ARCH", platform.machine()),
             os.environ.get("SAPHIRA_BUILDER_NAME", socket.gethostname()),
             row["id"]),
        )
        retired.append((row["package"], row["version"], reason))
        nvr_i = "-".join(x for x in (row["version"], ("r" + str(row["revision"])) if row["revision"] else "") if x and x != "r")
        bridge_emit("build.interrupted", row["package"], nvr_i, row["id"], 1,
                    {"state": "INTERRUPTED", "reason": reason,
                     "started_at": row["started_at"], "log_dir": row["log_dir"]})
    if retired:
        conn.commit()
    for pkg, ver, reason in retired:
        print(
            f"reconcile: {pkg} {ver or ''} BUILDING -> INTERRUPTED ({reason}); "
            "not requeued, retry it explicitly if the build still matters"
        )
    return retired


def recompute_blocking(conn):
    for row in conn.execute(
        "SELECT * FROM builds WHERE state IN ('QUEUED','BLOCKED')"
    ).fetchall():
        info = recipe_info(RECIPES / row["package"])
        blockers = []
        for d in info["deps"]:
            ok, hard, why = dep_state(conn, norm_dep(d))
            if not ok:
                blockers.append(why)
                if hard:
                    break
        if blockers:
            res = json.loads(row["result_json"])
            old_detail = (res.get("stages", {}).get("DEPENDENCIES", {})
                          .get("detail"))
            res.setdefault("stages", {})["DEPENDENCIES"] = {
                "status": "blocked", "detail": blockers,
            }
            if row["state"] != "BLOCKED" or old_detail != blockers:
                seq = bridge_bump_seq(res, "blocked_seq")
            else:
                seq = bridge_row_seq(res, "blocked_seq") or 1
                if "bridge" not in res:
                    res["bridge"] = {"blocked_seq": seq}
            conn.execute(
                "UPDATE builds SET state='BLOCKED', result_json=? WHERE id=?",
                (json.dumps(res), row["id"]),
            )
            nvr = "-".join(x for x in (row["version"], ("r" + str(row["revision"])) if row["revision"] else "") if x and x != "r")
            bridge_emit("build.blocked", row["package"], nvr, row["id"], seq,
                        {"state": "BLOCKED", "blockers": blockers,
                         "recipe_hash": row["recipe_hash"]})
        elif row["state"] == "BLOCKED":
            res = json.loads(row["result_json"])
            seq = bridge_row_seq(res, "blocked_seq") or 1
            conn.execute("UPDATE builds SET state='QUEUED' WHERE id=?", (row["id"],))
            nvr = "-".join(x for x in (row["version"], ("r" + str(row["revision"])) if row["revision"] else "") if x and x != "r")
            bridge_emit("build.unblocked", row["package"], nvr, row["id"], seq,
                        {"state": "QUEUED", "previous": "BLOCKED"})
    conn.commit()


def bridge_sweep_outstanding(conn):
    """Best-effort sweep for STALLED and stale AWAITING SIGNING rows.

    Called only from daemon-side paths (scan/run/daemon), never from
    read-only reporting (status/queue/log). Every attempt is opportunistic
    (bridge_emit never raises, timeout=0); anything skipped here is
    recovered by MCP startup reconciliation. Emits at most one row per
    (build, bucket); buckets distinguish transitions while exact-title
    dedup prevents duplicate delivery."""
    try:
        rows = conn.execute(
            "SELECT * FROM builds WHERE finished_at IS NULL"
            " OR (state='PASS' AND published_at IS NULL)"
        ).fetchall()
    except Exception:
        return
    for row in rows:
        try:
            nvr = "-".join(x for x in (row["version"], ("r" + str(row["revision"])) if row["revision"] else "") if x and x != "r")
            if row["state"] in ("QUEUED", "BUILDING"):
                try:
                    ref = row["queued_at"] or row["started_at"]
                    age = (calendar.timegm(time.strptime(now(), "%Y-%m-%dT%H:%M:%SZ"))
                           - calendar.timegm(time.strptime(ref, "%Y-%m-%dT%H:%M:%SZ"))) if ref else 0
                except Exception:
                    age = 0
                if age >= STALLED_AFTER_S:
                    bucket = "24h" if age >= 86400 else ("6h" if age >= 21600 else "1h")
                    bridge_emit(f"build.stalled.{bucket}", row["package"], nvr,
                                row["id"], 1,
                                {"state": row["state"], "age_s": age,
                                 "bucket": bucket})
            elif row["state"] == "PASS" and not row["published_at"]:
                try:
                    ref = row["finished_at"]
                    age = (calendar.timegm(time.strptime(now(), "%Y-%m-%dT%H:%M:%SZ"))
                           - calendar.timegm(time.strptime(ref, "%Y-%m-%dT%H:%M:%SZ"))) if ref else 0
                except Exception:
                    age = 0
                if age >= AWAITING_AFTER_S:
                    bridge_emit("build.awaiting_signing", row["package"], nvr,
                                row["id"], 1,
                                {"state": "PASS", "age_s": age,
                                 "finished_at": row["finished_at"]})
        except Exception:
            continue


REQUEUE_WARN_THRESHOLD = 5


def cmd_scan(args):
    conn = db()
    ch = commit_hash()
    requeue_failed = "--requeue-failed" in args
    queued = failed = skipped = 0
    for d in recipe_dirs():
        info = recipe_info(d)
        if info.get("disabled") == "yes":
            reason = info.get("reason") or "no reason given"
            print(f"scan: skipping disabled {info['name']}: {reason}")
            skipped += 1
            continue
        # An exact NVR already in the live repository is not work. Publishing
        # it again is impossible - sign-apk-repo refuses a rebuild whose NVR is
        # already there, by the immutable-filename rule - so queueing it can
        # only ever produce a FAIL row and a retained workspace.
        #
        # This was not hypothetical: saphira-packager 1.0-r70 is published and
        # installed on Egg, and scan queued it anyway, so the daemon burned a
        # build cycle on it about every 76 seconds - five attempts between
        # 18:06 and 18:11, five retained workspaces, five FAIL rows, forever.
        # The hash check below cannot catch it, because a recipe whose bytes
        # did not change keeps its hash and is only queued when something
        # ELSE in its tree moved.
        recipe_nvr = "-".join(
            part for part in (info.get("version"), "r" + str(info["revision"])) if part
        )
        if recipe_nvr and recipe_nvr in published_versions(info["name"]):
            skipped += 1
            continue
        h = recipe_hash(d)
        row = latest(conn, info["name"])
        if row and row["recipe_hash"] == h:
            if row["state"] in ("PASS",):
                skipped += 1
                continue
            if row["state"] == "FAIL":
                if requeue_failed:
                    conn.execute(
                        """INSERT INTO builds(package,version,revision,recipe_hash,state,
                               commit_hash,queued_at,result_json)
                           SELECT package,version,revision,recipe_hash,'QUEUED',commit_hash,?,?
                           FROM builds WHERE id=?""",
                        (now(), json.dumps({"stages": {}, "requeued": "scan --requeue-failed"}), row["id"]),
                    )
                    queued += 1
                else:
                    failed += 1
                continue
            if row["state"] == "BUILDING":
                skipped += 1
                continue
            recompute_blocking(conn)
            continue
        conn.execute(
            """INSERT INTO builds(package,version,revision,recipe_hash,state,
                   commit_hash,queued_at,result_json)
               VALUES(?,?,?,?,?,?,?,?)""",
            (
                info["name"], info.get("version"), info.get("revision"), h,
                "QUEUED", ch, now(),
                json.dumps({"stages": {"DEPENDENCIES": {"status": "pending"}}}),
            ),
        )
        queued += 1
    recompute_blocking(conn)
    sync_published(conn)
    bridge_sweep_outstanding(conn)
    print(f"scan: {queued} newly queued, {failed} left failed, {skipped} already proven/current")
    q = conn.execute("SELECT count(*) c FROM builds WHERE state='QUEUED'").fetchone()["c"]
    b = conn.execute("SELECT count(*) c FROM builds WHERE state='BLOCKED'").fetchone()["c"]
    print(f"queue: {q} ready, {b} blocked")
    for r in conn.execute(
        """SELECT package, count(DISTINCT version || ':' || revision) c FROM builds
           WHERE queued_at >= datetime('now', '-1 day')
           GROUP BY package HAVING c >= ? ORDER BY c DESC""",
        (REQUEUE_WARN_THRESHOLD,),
    ).fetchall():
        print(
            f"churn warning: {r['package']} queued {r['c']} distinct revisions in 24h "
            f"(>= {REQUEUE_WARN_THRESHOLD}) - verify each pkgrel bump fixes "
            "a proven defect; this is the r55555 smell"
        )


def pick_next(conn):
    for row in conn.execute(
        "SELECT * FROM builds WHERE state='QUEUED' ORDER BY id"
    ).fetchall():
        info = recipe_info(RECIPES / row["package"])
        ready = True
        for d in info["deps"]:
            ok, _, _ = dep_state(conn, norm_dep(d))
            if not ok:
                ready = False
                break
        if ready:
            return row, info
    return None, None


def ready_apk(ready_dir, pkg, ver_rel):
    # Candidate set: every artefact belonging to this package name, which is
    # the main package plus any splits.
    cands = list(ready_dir.glob(f"{pkg}-*.apk"))
    if not cands:
        cands = [p for p in ready_dir.glob("*.apk")]
    # Prefer the MAIN package over splits.
    #
    # This is not a preference between equals. A split such as
    # saphira-router-doc-0.1.0-r12 depends on saphira-router=0.1.0-r12, so
    # installing the split on its own can never satisfy its own versioned
    # parent dep: apk reports "unable to select packages: saphira-router (no
    # such package)" and the INSTALL stage fails for a reason that has
    # nothing to do with the package under test.
    #
    # The main package is named exactly "<pkg>-<ver_rel>.apk", with NO middle
    # component, so the previous glob "<pkg>-*-<ver_rel>.apk" could not match
    # it -- that pattern requires a component between the dashes. It matched
    # only the splits, which made the exact-name preference below dead code and
    # guaranteed the wrong artefact was chosen whenever a split existed.
    #
    # Splits ride the same transaction and publish with it; they are not
    # separately install-tested.
    if ver_rel:
        main = ready_dir / f"{pkg}-{ver_rel}.apk"
        if main.is_file():
            return main
        for p in cands:
            if p.name == f"{pkg}-{ver_rel}.apk":
                return p
    return cands[0] if cands else None


def evaluate_stages(root, payload, recipe_dir, log_dir):
    stages = {}

    lib_index = set()
    for base in ("lib", "usr/lib"):
        p = root / base
        if p.is_dir():
            lib_index |= {f.name for f in p.rglob("*") if f.is_file()}
    lib_index |= {
        "ld-musl-x86_64.so.1", "libc.musl-x86_64.so.1", "linux-vdso.so.1",
        "libc.so",
    }

    missing = []
    elfs = 0
    for rel in payload:
        f = root / rel
        try:
            if not f.is_file() or f.read_bytes()[:4] != b"\x7fELF":
                continue
        except OSError:
            continue
        elfs += 1
        r = run_out(["readelf", "-d", f])
        for m in re.finditer(r"\(NEEDED\).*\[(.+?)\]", r.stdout):
            if m.group(1) not in lib_index:
                missing.append(f"{rel}: {m.group(1)}")
    stages["RUNTIME"] = (
        {"status": "fail", "detail": missing[:10]}
        if missing else {"status": "pass", "detail": f"{elfs} ELF files, closure resolved"}
    )

    bad = []
    for rel in payload:
        if "/lib64/" in f"/{rel}" or rel.startswith("lib64/") or rel.startswith("usr/lib64/"):
            bad.append(f"forbidden layout path: {rel}")
            continue
        f = root / rel
        try:
            if not f.is_file() or f.stat().st_size == 0:
                continue
            chunk = f.read_bytes()[:524288]
        except OSError:
            continue
        if b"\x00" in chunk:
            continue
        # Needle built from parts: the contiguous bytes must not
        # appear in this checker itself, or every controller payload
        # carrying this code self-flags (Saphira is non-usrmerged:
        # the shell lives in /bin, never under /usr/bin).
        if b"/usr" + b"/bin/sh" in chunk:
            bad.append(f"{'/usr'}/bin/sh reference: {rel}")
    stages["POLICY"] = (
        {"status": "fail", "detail": bad[:10]} if bad else {"status": "pass"}
    )

    has_openrc = any(rel.startswith("etc/init.d/") for rel in payload)
    has_systemd = any(
        rel.startswith("usr/lib/systemd/system/") and rel.endswith((".service", ".socket", ".timer", ".path", ".mount"))
        for rel in payload
    )
    stages["OPENRC"] = (
        {"status": "pass", "detail": str(sorted(r.split("/")[-1] for r in payload if r.startswith("etc/init.d/")))}
        if has_openrc else {"status": "na"}
    )
    stages["SYSTEMD"] = (
        {"status": "pass", "detail": f"{sum(1 for r in payload if r.startswith('usr/lib/systemd/system/'))} units"}
        if has_systemd else {"status": "na"}
    )

    sysusers = sorted((root / "usr/lib/sysusers.d").glob("*.conf")) if (root / "usr/lib/sysusers.d").is_dir() else []
    if not sysusers:
        stages["IDENTITY"] = {"status": "na", "detail": "no sysusers.d in installed closure"}
    else:
        bin_host = shutil.which("systemd-sysusers")
        if bin_host:
            rc = run([bin_host, f"--root={root}"], log=log_dir / "identity.log")
        elif (root / "usr/bin/systemd-sysusers").is_file() and shutil.which("bwrap"):
            rc = run(["bwrap", "--bind", root, "/", "--dev", "/dev",
                      "usr/bin/systemd-sysusers"], log=log_dir / "identity.log")
        else:
            rc = -1
            stages["IDENTITY"] = {"status": "na", "detail": "no systemd-sysusers available to process declarations"}
        if rc == 0:
            passwd = (root / "etc/passwd").read_text() if (root / "etc/passwd").is_file() else ""
            group = (root / "etc/group").read_text() if (root / "etc/group").is_file() else ""
            want_u, want_g = [], []
            for conf in sysusers:
                for line in conf.read_text().splitlines():
                    line = line.split("#")[0].split()
                    if not line:
                        continue
                    if line[0] == "u":
                        want_u.append(line[1])
                    elif line[0] == "g":
                        want_g.append(line[1])
            u_miss = [u for u in want_u if f"\n{u}:" not in f"\n{passwd}" and not passwd.startswith(f"{u}:")]
            g_miss = [g for g in want_g if f"\n{g}:" not in f"\n{group}" and not group.startswith(f"{g}:")]
            mid = root / "etc/machine-id"
            mid_ok = mid.is_file() and mid.stat().st_size > 0
            if u_miss or g_miss:
                stages["IDENTITY"] = {"status": "fail", "detail": {
                    "missing_users": u_miss, "missing_groups": g_miss}}
            else:
                stages["IDENTITY"] = {"status": "pass", "detail": {
                    "users": want_u, "groups": want_g, "machine_id": mid_ok}}
        elif "IDENTITY" not in stages:
            stages["IDENTITY"] = {"status": "fail", "detail": f"systemd-sysusers rc={rc}"}

    tsh = recipe_dir / "test.sh"
    if tsh.is_file():
        rc = run(["/bin/sh", str(tsh)], log=log_dir / "test.log",
                 env={"SAPHIRA_TEST_ROOT": str(root), "SAPHIRA_PKG": recipe_dir.name})
        stages["TEST"] = {"status": "pass" if rc == 0 else "fail", "detail": f"test.sh rc={rc}"}

    return stages


def initialise_install_root(root):
    """Make the disposable install root a usable Saphira root.

    Two things are needed, and only one of them is still no package's business.

    The interpreter links. apk runs a package maintainer scripts chrooted in
    the root, and makepkg generates every one of them with a #!/bin/sh
    shebang. /bin/sh -> bash is owned by the bash package, so it normally
    arrives through the dependency closure like any other file; this function
    keeps creating it only as an ordering safety net for roots where the bash
    payload has not landed yet, and asserts the result either way. buildpkg
    does the same in a clean build root and asserts the link afterwards;
    saphira-bootstrap does the same in a target root, with the same note about
    apk executing scripts in a target that has no shell yet.

    A root that skips this can install a package but cannot RUN its scripts.
    apk reports that as `execve: No such file or directory` and 127, which
    reads like a missing helper and is not: it is a missing interpreter.
    Proven on saphira-bridge-0.1.0-r2, where the reconciler was present and
    correct - saphira-baselayout 0.1-r20 arrived through normal dependency
    resolution - and only /bin/sh was absent, so saphira-baselayout OWN
    post-install failed identically.

    The account database. Once the scripts do run, the next failure is the
    reconciler refusing with `account database is missing`, because a root
    assembled from scratch has no passwd/group/shadow. On a live system those
    come from the image; installable roots get them from the
    saphira-base-accounts package, whose hooks seed a locked root-only
    database where none exists. (The buildpkg clean-root path has its own
    rootless precedent and reasoning: the database must be COMPLETE, not
    merely resolvable, because ensure-identity.sh requires passwd, group
    AND shadow; and a LOCKED root row is the safe seed, since live
    provisioning owns real credentials and these roots are disposable and
    never reach a payload or an image.)

    The package side of the closure is already right and is deliberately not
    touched here: makepkg injects saphira-baselayout, bash and coreutils into
    every package that ships an accounts.d fragment (IDENTITY_DEPS), so the
    reconciler and the tools it uses are installed before any script runs.
    This adds only what still no package can provide (/usr/bin/env), for any
    package, plus the /bin/sh ordering safety net above. Nothing here
    is package-specific.

    Fail closed when the link target is absent: a root without bash is not a
    usable Saphira root, and creating a dangling link would only move the
    failure to the first script that runs.
    """
    root = Path(root)
    shell_link = root / "bin/sh"
    if not os.path.lexists(shell_link):
        if not (root / "bin/bash").exists():
            die(f"install root has no /bin/bash to link /bin/sh to: {root}")
        shell_link.parent.mkdir(parents=True, exist_ok=True)
        shell_link.symlink_to("bash")
    if not shell_link.is_symlink() or os.readlink(shell_link) != "bash":
        die(f"install root /bin/sh is not the expected link to bash: {shell_link}")
    env_link = root / "usr/bin/env"
    if not os.path.lexists(env_link):
        if not (root / "bin/env").exists():
            die(f"install root has no /bin/env to link /usr/bin/env to: {root}")
        env_link.parent.mkdir(parents=True, exist_ok=True)
        env_link.symlink_to("/bin/env")
    if not (env_link.is_symlink() or env_link.exists()):
        die(f"install root initialisation did not provide /usr/bin/env: {env_link}")

    # Minimal but COMPLETE account database, matching buildpkg's clean-root
    # seed. Appended only when absent, so a root that already carries one is
    # left exactly as it is.
    etc = root / "etc"
    etc.mkdir(parents=True, exist_ok=True)

    def has_row(database, prefix):
        if not database.exists():
            return False
        text = database.read_text(encoding="utf-8", errors="replace")
        if prefix == "root:x:0:0":
            return "root:x:0:0" in text
        return any(line.startswith(prefix) for line in text.splitlines())

    passwd = etc / "passwd"
    if not has_row(passwd, "root:x:0:0"):
        with passwd.open("a", encoding="utf-8") as stream:
            stream.write("root:x:0:0:root:/root:/bin/sh\n")
    group = etc / "group"
    if not has_row(group, "root:"):
        with group.open("a", encoding="utf-8") as stream:
            stream.write("root:x:0:\n")
    shadow = etc / "shadow"
    if not has_row(shadow, "root:"):
        with shadow.open("a", encoding="utf-8") as stream:
            stream.write("root:!:0:0:99999:7:::\n")
        shadow.chmod(0o600)
    for database in (passwd, group, shadow):
        if not database.exists():
            die(f"install root initialisation did not provide {database}")


def cmd_run(args):
    limit = 1
    for a in args:
        if a.startswith("--limit="):
            limit = int(a.split("=", 1)[1])
        elif a == "--all":
            limit = 10 ** 9
    index = REPO / "Packages.adb"
    if not index.is_file():
        # Environmental failure, not a package failure: the trusted index
        # is the plan-time trust anchor for every buildpkg run. Starting
        # builds without it only manufactures FAIL rows (and retained
        # workspaces) that succeed on retry once the index is restored, so
        # skip the phase with the queue untouched until it reappears.
        print(f"run: trusted repository index is missing or unreadable: {index}; skipping build phase (environmental, queue untouched)")
        print("run: 0 package(s) processed")
        return
    conn = db()
    done = 0
    while done < limit:
        row, info = pick_next(conn)
        if row is None:
            break
        run_one(conn, row, info)
        done += 1
    print(f"run: {done} package(s) processed")


def run_one(conn, row, info):
    """Process a single queued build through every stage and finish its
    row (state, timings, measurements, artifact handling). Shared by
    cmd_run and cmd_calibrate so a calibration build measures the
    identical pipeline an ordinary build runs. Returns overall."""
    pkg = row["package"]
    ver_rel = "-".join(x for x in (info.get("version"), "r" + str(info.get("revision"))) if x and x != "r")
    log_dir = STATE / "logs" / pkg / f"{ver_rel or 'unknown'}-{row['recipe_hash'][:8]}"
    shutil.rmtree(log_dir, ignore_errors=True)
    log_dir.mkdir(parents=True)
    conn.execute(
        "UPDATE builds SET state='BUILDING', started_at=?, log_dir=?,"
        " builder_pid=?, boot_id=? WHERE id=?",
        (now(), str(log_dir), os.getpid(), boot_id(), row["id"]),
    )
    conn.commit()
    # Provenance of what actually runs, not just what was queued: the
    # worker bind-mounts the live recipe tree, so a commit landing
    # between queue and run would otherwise build bytes the row's
    # recipe_hash never names. Record-only: informational print plus
    # result_json fields; never gates, never fails a build.
    try:
        built_hash = recipe_hash(RECIPES / pkg)
    except OSError:
        built_hash = ""
    built_commit = commit_hash()
    if built_hash and built_hash != row["recipe_hash"]:
        print(f"run: {pkg} recipe tree moved since queue "
              f"(queued {row['recipe_hash'][:8]}, building {built_hash[:8]})")
    print(f"run: {pkg} {ver_rel or '(version unknown)'} building...")
    rusage_before = resource.getrusage(resource.RUSAGE_CHILDREN)
    rc = run(BUILDCMD + [pkg], log=log_dir / "build.log",
             env={"JOBS": os.environ.get("SAPHIRA_BUILD_JOBS", "8"),
                  "SAPHIRA_TIMINGS_DIR": str(log_dir)})
    rusage_after = resource.getrusage(resource.RUSAGE_CHILDREN)
    # buildpkg rc 2 is a pre-build refusal: nothing compiled, so the
    # attempt is classified refusal (dashboards show it RED with the
    # reason; timing/SBU math excludes it). Any other nonzero rc is
    # a genuine build failure.
    result = {"attempt": "refusal" if rc == 2 else "build",
              "built_inputs": {"recipe_hash": built_hash,
                               "tree_commit": built_commit,
                               "queued_hash": row["recipe_hash"]},
              "stages": {"BUILD": {"status": "pass" if rc == 0 else "fail",
                                   "detail": f"buildpkg rc={rc}"}}}
    ready_dir = apk = None
    if rc == 0:
        cands = sorted(
            (p for p in INCOMING.glob(f"{pkg}-*-ready") if p.is_dir()),
            key=lambda p: p.stat().st_mtime,
        )
        if not cands or cands[-1].stat().st_mtime < row_start(conn, row["id"]):
            result["stages"]["BUILD"] = {"status": "fail", "detail": "no new -ready transaction in incoming"}
        else:
            ready_dir = cands[-1]
            apk = ready_apk(ready_dir, pkg, ver_rel)
            if apk is None:
                result["stages"]["BUILD"] = {"status": "fail", "detail": f"no apk in {ready_dir.name}"}
    if apk is not None:
        result["stages"]["INSTALL"] = {"status": "pending"}
        root = TEST_ROOT_PARENT / f"{pkg}-{row['recipe_hash'][:8]}"
        shutil.rmtree(root, ignore_errors=True)
        root.parent.mkdir(parents=True, exist_ok=True)
        root.mkdir()
        base_apk_args = [
            APK, "--usermode", f"--root={root}", "--initdb", "--no-network",
            "--allow-untrusted", "--force-non-repository",
            f"--repository={REPO}/Packages.adb",
        ]
        # A Saphira root is seeded from the distribution's own base
        # group, whose closure apk resolves from metadata: it brings
        # bash, coreutils and saphira-baselayout (and therefore
        # /usr/libexec/saphira/ensure-identity.sh) through the normal
        # package relationship rather than a hand-picked list.
        #
        # The seed is installed --no-scripts, and that is not a shortcut:
        # apk runs maintainer scripts chrooted in the root, every
        # generated one starts with #!/bin/sh, and /bin/sh is owned by NO
        # package, so a root assembled from scratch cannot run any script
        # until the link exists. This is the documented recovery shape
        # (RECIPE_RULES: `apk add --no-scripts`, initialise, `apk fix`) and
        # is what saphira-bootstrap does for the same reason. The scripts
        # this stage actually verifies - the package under test's - DO
        # run, in the install immediately below.
        run(base_apk_args + ["add", "--no-scripts", "saphira-base"],
            log=log_dir / "install.log")
        # Then the part no package can provide, exactly as buildpkg does
        # in a clean build root and saphira-bootstrap in a target root.
        initialise_install_root(root)
        irc = run(
            base_apk_args + ["add", apk],
            log=log_dir / "install.log",
        )
        if irc != 0:
            result["stages"]["INSTALL"] = {"status": "fail", "detail": f"apk add rc={irc}"}
        else:
            result["stages"]["INSTALL"] = {"status": "pass"}
            pl = run_out([APK, f"--root={root}", "info", "-L", pkg])
            payload = [
                ln.strip() for ln in pl.stdout.splitlines()
                if ln.strip() and not ln.endswith("contains:")
            ]
            result["stages"].update(
                evaluate_stages(root, payload, RECIPES / pkg, log_dir)
            )
            shutil.rmtree(root, ignore_errors=True)
    stages = result["stages"]
    overall = "PASS" if all(s["status"] != "fail" for s in stages.values()) else "FAIL"
    if overall == "FAIL":
        failed_deps = [
            (dep, why) for dep in {
                norm_dep(d) for d in recipe_info(RECIPES / pkg)["deps"]
            }
            for ok, hard, why in (dep_state(conn, dep),)
            if not ok and why
        ]
        result["blockers"] = [w for _, w in failed_deps]
    finished = now()
    start_epoch = row_start(conn, row["id"])
    timings_path = log_dir / "timings.json"
    try:
        timings_text = timings_path.read_text(encoding="utf-8") if timings_path.is_file() else None
    except OSError:
        timings_text = None
    if timings_text is not None:
        try:
            json.loads(timings_text)
        except ValueError:
            timings_text = None
    conn.execute(
        "UPDATE builds SET state=?, finished_at=?, result_json=?, version=?, revision=?,"
        " duration_s=?, cpu_s=?, peak_rss_mb=?, timings_json=?, arch=?, builder_host=? WHERE id=?",
        (overall, finished, json.dumps(result), info.get("version"), info.get("revision"),
         round(calendar.timegm(time.strptime(finished, "%Y-%m-%dT%H:%M:%SZ")) - start_epoch, 3)
         if start_epoch else None,
         round((rusage_after.ru_utime - rusage_before.ru_utime)
               + (rusage_after.ru_stime - rusage_before.ru_stime), 3),
         round(rusage_after.ru_maxrss / 1024, 1),
         timings_text,
         os.environ.get("SAPHIRA_ARCH", platform.machine()),
         os.environ.get("SAPHIRA_BUILDER_NAME", socket.gethostname()),
         row["id"]),
    )
    conn.commit()
    if overall == "FAIL":
        fail_stage = next(
            (k for k, v in stages.items()
             if isinstance(v, dict) and v.get("status") == "fail"),
            "BUILD",
        )
        bridge_emit("build.failed", pkg, ver_rel, row["id"], 1,
                    {"state": "FAIL", "stage": fail_stage,
                     "detail": (stages.get(fail_stage, {}) or {}).get("detail", ""),
                     "recipe_hash": row["recipe_hash"],
                     "log_dir": str(log_dir)})
    recompute_blocking(conn)
    if ver_rel and ver_rel in published_versions(pkg) and ready_dir is not None:
        discarded = INCOMING / ".validation-discarded"
        discarded.mkdir(parents=True, exist_ok=True)
        os.replace(ready_dir, discarded / ready_dir.name)
        result["artifact"] = (
            "discarded: recipe version already published; rebuild kept for "
            "validation only (immutable-filename rule)"
        )
        conn.execute("UPDATE builds SET result_json=? WHERE id=?",
                     (json.dumps(result), row["id"]))
        conn.commit()
    stage_summary = ", ".join(
        k + ":" + v["status"] for k, v in stages.items()
    )
    print(f"run: {pkg} -> {overall} ({stage_summary})")
    return overall


def cmd_calibrate(args):
    """Pin an SBU baseline: queue the reference package at its current
    tree revision, build it once through the identical run_one pipeline
    with a guaranteed-cold compiler cache, and record its wall time.
    Raw seconds in builds stay authoritative; ratios are computed at
    report time by `times --sbu`. Only PASS builds calibrate: a failed
    baseline would bless broken measurements. BBU is explicitly
    unimplemented (no agreed workload) - this command does not cover it.
    Usage: calibrate [PKG] (default: musl)."""
    pkg = args[0] if args else "musl"
    if not (RECIPES / pkg / "recipe.sh").is_file():
        die(f"calibrate: no recipe for {pkg}")
    info = recipe_info(RECIPES / pkg)
    if info.get("disabled"):
        die(f"calibrate: {pkg} is disabled ({info.get('reason', 'no reason')})")
    conn = db()
    h = recipe_hash(RECIPES / pkg)
    ch = commit_hash()
    cur = conn.execute(
        "INSERT INTO builds(package,version,revision,recipe_hash,state,"
        " commit_hash,queued_at,result_json)"
        " VALUES(?,?,?,?,?,?,?,?)",
        (info["name"], info.get("version"), info.get("revision"), h,
         "QUEUED", ch, now(),
         json.dumps({"stages": {}, "calibration": True})),
    )
    rid = cur.lastrowid
    conn.commit()
    ccdir = tempfile.mkdtemp(prefix="sbu-ccache-")
    previous_ccache = os.environ.get("SAPHIRA_CCACHE_DIR")
    os.environ["SAPHIRA_CCACHE_DIR"] = ccdir
    try:
        row = conn.execute("SELECT * FROM builds WHERE id=?", (rid,)).fetchone()
        overall = run_one(conn, row, info)
    finally:
        if previous_ccache is None:
            os.environ.pop("SAPHIRA_CCACHE_DIR", None)
        else:
            os.environ["SAPHIRA_CCACHE_DIR"] = previous_ccache
        shutil.rmtree(ccdir, ignore_errors=True)
    if overall != "PASS":
        die(f"calibrate: {pkg} did not pass ({overall}); no baseline recorded")
    row = conn.execute("SELECT * FROM builds WHERE id=?", (rid,)).fetchone()
    arch = row["arch"] or os.environ.get("SAPHIRA_ARCH", platform.machine())
    builder = row["builder_host"] or os.environ.get("SAPHIRA_BUILDER_NAME", socket.gethostname())
    conn.execute(
        "UPDATE sbu_baseline SET active=0 WHERE package=? AND arch=? AND builder_host=?",
        (info["name"], arch, builder),
    )
    conn.execute(
        "INSERT INTO sbu_baseline(package,version,revision,recipe_commit,arch,builder_host,"
        " cache_policy,wall_s,cpu_s,active,calibrated_at)"
        " VALUES(?,?,?,?,?,?,?,?,?,?,?)",
        (info["name"], info.get("version"), info.get("revision"), ch,
         arch, builder, "cold (fresh SAPHIRA_CCACHE_DIR)",
         row["duration_s"], row["cpu_s"], 1, now()),
    )
    conn.commit()
    print(f"calibrate: {info['name']} {row['version'] or '?'} baseline {row['duration_s']}s "
          f"wall ({arch}/{builder}, cold cache, recipe {ch or 'uncommitted'})")


def row_start(conn, rid):
    r = conn.execute("SELECT started_at FROM builds WHERE id=?", (rid,)).fetchone()
    if not r or not r["started_at"]:
        return 0
    t = time.strptime(r["started_at"], "%Y-%m-%dT%H:%M:%SZ")
    return calendar.timegm(t)


def cmd_reconcile(args):
    """Operator-facing form of the startup recovery: retire BUILDING rows no
    live builder owns, without waiting for a daemon restart."""
    conn = db()
    retired = reconcile_interrupted(conn)
    synced = sync_published(conn)
    bridge_sweep_outstanding(conn)
    if not retired:
        print("reconcile: no interrupted build rows")
    if synced:
        print(f"reconcile: {synced} PASS row(s) stamped published from the repository")
    return 0


def cmd_status(args):
    conn = db()
    rows = conn.execute(
        """SELECT * FROM builds b WHERE id IN (
               SELECT max(id) FROM builds GROUP BY package)
           ORDER BY state, package"""
    ).fetchall()
    if not rows:
        print("status: queue empty (run scan)")
        return
    print(f"{'PACKAGE':<28} {'VERSION':<18} {'STATE':<9} {'STAGES':<34} PUB SKEW")
    for r in rows:
        res = json.loads(r["result_json"])
        st = res.get("stages", {})
        s = " ".join(
            {"pass": "+", "fail": "F", "na": "-", "pending": ".", "blocked": "B",
                    "interrupted": "X"}.get(
                v.get("status"), "?") for k, v in
            sorted(st.items(), key=lambda kv: ["BUILD", "INSTALL", "RUNTIME", "POLICY", "OPENRC", "SYSTEMD", "IDENTITY", "TEST", "DEPENDENCIES"].index(kv[0]) if kv[0] in ["BUILD", "INSTALL", "RUNTIME", "POLICY", "OPENRC", "SYSTEMD", "IDENTITY", "TEST", "DEPENDENCIES"] else 99)
        )
        info = recipe_info(RECIPES / r["package"]) if (RECIPES / r["package"] / "recipe.sh").is_file() else {}
        rv = "-".join(x for x in (info.get("version"), "r" + str(info.get("revision"))) if x and x != "r")
        pv = published_versions(r["package"])
        # Effective state: requested recipe NVR + actual repository
        # publication + this attempt - never the latest row alone.
        # Labels stay explicit: requested recipe revision, current
        # repository newest, and this row's own publication record.
        # Older BLOCKED rows stay relevant context: the daemon
        # re-derives blocking every scan, so a flip back is one scan
        # away.
        state_text, note = effective_state(conn, r, rv or "", pv)
        if state_text in ("QUEUED", "BUILDING"):
            nblocked = conn.execute(
                "SELECT COUNT(*) c FROM builds WHERE package=? AND state='BLOCKED'",
                (r["package"],),
            ).fetchone()["c"]
            if nblocked:
                note = (note + " " if note else "") + f"{nblocked} older BLOCKED row{'s' if nblocked != 1 else ''} on record"
        pub = "yes" if (r["published_at"] or state_text == "PUBLISHED") else ("built" if r["state"] == "PASS" else "no")
        skew = ""
        if rv and pv and rv not in pv and rv > max(pv):
            skew = f"recipe {rv} ahead of repo"
        repo_newest = max(pv) if pv else ""
        if repo_newest and repo_newest != (rv or ""):
            skew = (skew + " " if skew else "") + f"repo newest {repo_newest}"
        if note:
            skew = (skew + " " if skew else "") + note
        print(f"{r['package']:<28} {rv or (r['version'] or '?'):<18} {state_text:<9} {s:<34} {pub:<4} {skew}")


def cmd_times(args):
    """Report last finished attempt per package: wall/CPU durations and
    peak RSS, with revision, arch and builder provenance. Raw seconds;
    --sbu[=REF] appends ratios against the active baseline (default
    reference: musl), matched per row on arch and builder host so
    cross-hardware ratios never print silently. Rows pre-dating
    measurement carry NULL CPU/RSS (wall backfilled from timestamps
    where possible). Refusals (attempt=refusal) are listed with their
    durations but are excluded from SBU math by definition: nothing
    compiled."""
    conn = db()
    sbu_ref = None
    wanted = set()
    for a in args:
        if a == "--sbu":
            sbu_ref = "musl"
        elif a.startswith("--sbu="):
            sbfx = a.split("=", 1)[1]
            sbu_ref = sbfx if sbfx else "musl"
        else:
            wanted.add(a)
    rows = conn.execute(
        """SELECT * FROM builds b WHERE finished_at IS NOT NULL AND id IN (
               SELECT max(id) FROM builds WHERE finished_at IS NOT NULL GROUP BY package)
           ORDER BY package"""
    ).fetchall()
    if wanted:
        rows = [r for r in rows if r["package"] in wanted]
    if not rows:
        print("times: no finished builds" + (f" matching {','.join(sorted(wanted))}" if wanted else ""))
        return
    baselines = {}
    if sbu_ref is not None:
        for b in conn.execute(
                "SELECT * FROM sbu_baseline WHERE package=? AND active=1", (sbu_ref,)).fetchall():
            if b["wall_s"]:
                baselines[(b["arch"], b["builder_host"])] = b["wall_s"]

    def fmt(seconds):
        if seconds is None:
            return "-"
        total = int(round(seconds))
        if total < 120:
            return f"{total}s"
        return f"{total // 60}m{total % 60:02d}s"

    def sbu_of(row):
        if sbu_ref is None:
            return None
        try:
            refused = json.loads(row["result_json"] or "{}").get("attempt") == "refusal"
        except ValueError:
            refused = True
        if refused:
            return "-"
        base = baselines.get((row["arch"], row["builder_host"]))
        if not base or not row["duration_s"]:
            return "-"
        return f"{row['duration_s'] / base:.2f}"

    header = f"{'PACKAGE':<28} {'VERSION':<12} {'STATE':<9} {'WALL':>8} {'CPU':>8} {'RSS_MB':>8}  FINISHED"
    if sbu_ref is not None:
        if not baselines:
            print(f"times: no active {sbu_ref} baseline (run calibrate first)")
            return
        header += f"  {'SBU':>8}"
    print(header)
    for r in rows:
        ver = "-".join(x for x in (r["version"], "r" + str(r["revision"]) if r["revision"] else "") if x) or "?"
        rss = f"{r['peak_rss_mb']:.1f}" if r["peak_rss_mb"] is not None else "-"
        line = (f"{r['package']:<28} {ver:<12} {r['state']:<9} {fmt(r['duration_s']):>8} "
                f"{fmt(r['cpu_s']):>8} {rss:>8}  {r['finished_at'] or '-'}")
        if sbu_ref is not None:
            line += f"  {sbu_of(r):>8}"
        print(line)


