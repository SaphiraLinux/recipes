    for name, version, rel, pub in behind[:20]:
        print(f"  behind: {name} {version} recipe r{rel} published r{pub}")
    for name, version, rel, pub in ahead[:20]:
        print(f"  ahead:  {name} {version} recipe r{rel} published r{pub}")


def cmd_rel_bump(args):
    if not args:
        die("rel-bump: PACKAGE... or all required")
    for name, version, rel, pub in rel_rows(rel_targets(args)):
        new = max(rel, pub) + 1
        if new <= rel:
            continue
        rel_set_rel(name, rel, new, "bump", version)
        print(f"rel-bump: {name} {version} r{rel} -> r{new}")


def cmd_rel_normalize(args):
    if not args:
        die("rel-normalize: PACKAGE... or all required")
    for name, version, rel, pub in rel_rows(rel_targets(args)):
        if pub <= rel:
            continue
        rel_set_rel(name, rel, pub, "normalize", version)
        print(f"rel-normalize: {name} {version} r{rel} -> r{pub}")


def die(msg):
    print(f"saphira-build: {msg}", file=sys.stderr)
    sys.exit(2)


def main():
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except (AttributeError, ValueError):
        pass
    import signal
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass
    cmds = {
        "scan": cmd_scan, "run": cmd_run, "status": cmd_status,
        "retry": cmd_retry, "log": cmd_log, "queue": cmd_queue,
        "evaluate": cmd_evaluate, "publish": cmd_publish,
        "daemon": cmd_daemon, "reconcile": cmd_reconcile,
        "rel-plan": cmd_rel_plan, "rel-status": cmd_rel_status,
        "rel-bump": cmd_rel_bump, "rel-normalize": cmd_rel_normalize,
    }
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print(
            "usage: saphira-build "
            "scan | run [--limit=N|--all] | queue | status | reconcile | "
            "retry PACKAGE | "
            "log PACKAGE | publish [--sync] [PKG...] | evaluate ROOT PKG [RECIPE_DIR] | "
            "daemon [--interval=S] [--limit=N] [--once] | "
            "rel-plan [all|PKG...] | rel-status | rel-bump [all|PKG...] | "
            "rel-normalize [all|PKG...]",
            file=sys.stderr,
        )
        sys.exit(2)
    sys.exit(cmds[sys.argv[1]](sys.argv[2:]) or 0)


if __name__ == "__main__":
    main()
