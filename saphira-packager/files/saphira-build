def cmd_daemon(args):
    interval = 300
    limit = 1
    once = "--once" in args
    for a in args:
        if a.startswith("--interval="):
            interval = int(a.split("=", 1)[1])
        elif a.startswith("--limit="):
            limit = int(a.split("=", 1)[1])
    # Before the loop, not inside it: the claim cleanup is a startup
    # recovery, and running it once means a row this daemon builds is never
    # a candidate for its own reconcile.
    conn = db()
    retired = reconcile_interrupted(conn)
    if retired:
        print(f"daemon: recovered {len(retired)} interrupted build row(s) at startup")
    while True:
        cmd_scan([])
        cmd_run([f"--limit={limit}"])
        if once:
            break
        time.sleep(interval)


def cmd_publish(args):
    sync = "--sync" in args
    pkgs = [a for a in args if not a.startswith("--")]
    conn = db()
    rows = conn.execute(
        """SELECT * FROM builds WHERE state='PASS' AND published_at IS NULL
           AND id IN (SELECT max(id) FROM builds GROUP BY package) ORDER BY package"""
    ).fetchall()
    if pkgs:
        rows = [r for r in rows if r["package"] in pkgs]
    if not rows:
        print("publish: nothing eligible (state PASS, unpublished)")
        return
    # One sign-apk-repo run publishes every ready transaction it finds,
    # so a single batched call covers all rows (per-row calls would
    # repeat the full O(repo) publication once per package).
    rc = run(["sudo", "sign-apk-repo"])
    if rc != 0:
        for r in rows:
            res = json.loads(r["result_json"])
            res["stages"]["PUBLISH"] = {"status": "fail", "detail": f"sign-apk-repo rc={rc}"}
            conn.execute("UPDATE builds SET result_json=? WHERE id=?", (json.dumps(res), r["id"]))
        conn.commit()
        print(f"publish: {len(rows)} package(s) FAILED (sign-apk-repo rc={rc})")
        return
    for r in rows:
        conn.execute("UPDATE builds SET published_at=? WHERE id=?", (now(), r["id"]))
    conn.commit()
    print(f"publish: {len(rows)} package(s) signed+indexed")
    if sync:
        # Remote layout mirrors the local one (…/hatchling/<arch>/): derive
        # the arch from the live repo path, never hardcode it, so aarch64
        # (and later riscv64) publishes sync to their own generation dirs.
        arch = REPO.name
        rc = run(["rsync", "-a", "--delete", f"{REPO}/", f"homer:/srv/packages.saphira.vm2.uk/hatchling/{arch}/"])
        print(f"publish: homer sync rc={rc}")


RELEASE_STATE = Path(os.environ.get("SAPHIRA_RELEASE_STATE", str(STATE / "releases")))
RELEASE_POLICY = os.environ.get("SAPHIRA_RELEASE_POLICY", "monotonic")

REL_LINE_RE = re.compile(r"^pkgrel=([0-9]+)\s*$", re.MULTILINE)


def release_log(action, package, version, old, new, reason=""):
    RELEASE_STATE.mkdir(parents=True, exist_ok=True)
    entry = {
        "ts": now(), "action": action, "package": package,
        "version": version, "from": f"r{old}", "to": f"r{new}",
        "policy": RELEASE_POLICY, "reason": reason,
    }
    with (RELEASE_STATE / "releases.jsonl").open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(entry, sort_keys=True) + "\n")


def rel_targets(args):
    if not args or args == ["all"]:
        return [recipe_info(d) for d in recipe_dirs()]
    out = []
    for name in args:
        d = RECIPES / name
        if not (d / "recipe.sh").is_file():
            die(f"rel: no recipe for {name}")
        out.append(recipe_info(d))
    return out


def published_rel_for(name, version):
    best = 0
    for entry in published_versions(name):
        ver, _, rel = entry.rpartition("-r")
        if ver == version:
            best = max(best, int(rel))
    return best


def rel_rows(targets):
    rows = []
    for info in targets:
        name, version = info["name"], info.get("version", "")
        rel = int(info.get("revision") or 0)
        pub = published_rel_for(name, version)
        rows.append((name, version, rel, pub))
    return rows


def rel_set_rel(name, old, new, action, version, reason=""):
    script = RECIPES / name / "recipe.sh"
    text = script.read_text(encoding="utf-8")
    new_text, count = REL_LINE_RE.subn(f"pkgrel={new}", text, count=1)
    if count != 1:
        die(f"rel: cannot update pkgrel in {script}")
    if new_text != text:
        script.write_text(new_text, encoding="utf-8")
    release_log(action, name, version, old, new, reason)


def cmd_rel_plan(args):
    rows = rel_rows(rel_targets(args))
    print(f"{'PACKAGE':<28} {'VERSION':<16} {'RECIPE':>7} {'PUBLISHED':>10} {'NEXT':>6}")
    for name, version, rel, pub in rows:
        nxt = max(rel, pub) + 1
        pub_s = f"r{pub}" if pub else "-"
        print(f"{name:<28} {version:<16} {'r' + str(rel):>7} {pub_s:>10} {'r' + str(nxt):>5}")


