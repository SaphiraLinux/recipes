        if pkg not in pub_versions and pkg not in staged_versions:
            die(f"unsatisfied closure: {novel_idents[fname][0]}-{novel_idents[fname][1]} ({fname}) depends on '{atom}' with no published or staged provider; build it first: buildpkg {pkg}")

