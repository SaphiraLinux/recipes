#!/bin/bash

set -euo pipefail

. "${SAPHIRA_CONFIG_FILE:-/etc/saphira/package_builder.sh}"

# Shared index generation/signing (source tree and tests carry it next to
# this script; the installed packager places it in /usr/lib/saphira-packager).
lib_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$lib_dir/repo-index.sh" ]; then
	. "$lib_dir/repo-index.sh"
elif [ -f /usr/lib/saphira-packager/repo-index.sh ]; then
	. /usr/lib/saphira-packager/repo-index.sh
else
	printf 'sign-apk-repo: shared index helper repo-index.sh not found\n' >&2
	exit 1
fi

# Shared repository metadata library (SQLite, single-file). Same
# resolution rule as repo-index.sh: beside this script first (source
# tree and tests), installed location second.
repo_db_lib=$lib_dir/repo_db.py
[ -f "$repo_db_lib" ] || repo_db_lib=/usr/lib/saphira-packager/repo_db.py
[ -f "$repo_db_lib" ] || die "repository metadata library repo_db.py not found"

die()
{
	printf 'sign-apk-repo: %s\n' "$*" >&2
	exit 1
}

[ "$EUID" -eq 0 ] || die "must be run as root; use sudo explicitly"

# Ownership policy: published /out state belongs to the invoking user with
# the repository group, even when invoked through sudo. Repository
# directories are kept setgid so group inheritance holds between writes.
normalize_ownership()
{
	if [ -n "${SUDO_UID:-}" ]; then
		chown "${SUDO_UID}:${SAPHIRA_REPO_GROUP:-saphira-build}" "$@" 2>/dev/null || true
	fi
}

incoming_dir=$SAPHIRA_INCOMING_DIR/$SAPHIRA_ARCH
sign_key=$SAPHIRA_SIGN_KEY
trust_key=$SAPHIRA_TRUST_KEY
trust_dir=${trust_key%/*}

IFS=' ' read -ra repo_names <<< "$SAPHIRA_REPO_NAMES"
[ "${#repo_names[@]}" -gt 0 ] || die "SAPHIRA_REPO_NAMES is empty"
for repo_name in "${repo_names[@]}"; do
	case $repo_name in
		''|*[!A-Za-z0-9._-]*) die "invalid repository name: $repo_name" ;;
	esac
	repo_dir=$SAPHIRA_REPO_DIR/$repo_name/$SAPHIRA_ARCH
	[ -d "$repo_dir" ] || die "generation repository does not exist: $repo_dir (seed it or fix SAPHIRA_REPO_NAMES)"
done

[ -r "$sign_key" ] || die "cannot read signing key: $sign_key"
[ -r "$trust_key" ] || die "cannot read repository trust key: $trust_key"
mkdir -p "$incoming_dir" "$SAPHIRA_PACKAGE_TMP"

lock=$incoming_dir/sign-apk-repo.lock
mkdir "$lock" 2>/dev/null || die "publication lock already exists: $lock"
workspace=$(mktemp -d "$SAPHIRA_PACKAGE_TMP/sign-apk-repo-XXXXXXXX")
packages_dir=$workspace/packages
mkdir "$packages_dir"

cleanup()
{
	if [ -n "${db_lock_held-}" ]; then
		rmdir -- "$db_lock_held/repository.db.lock" 2>/dev/null || true
	fi
	rm -rf -- "$workspace"
	rmdir "$lock" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

shopt -s nullglob
ready_transactions=("$incoming_dir"/*-ready)

# Publication mode: full repository audit only on explicit request.
# Otherwise the indexed repository.db gates just the staged set (fast
# when the fingerprint is fresh; automatic full audit when stale). A
# missing or unusable database refuses with a migration pointer — bare
# signing never silently creates repository metadata.
# Positional arguments are target filters only; they never select
# the algorithm. No valid package target starts with `-`, so the
# exact-match flag below cannot collide with a filter.
force_full=0
heal_mode=0
if [ "${1:-}" = "--full-audit" ]; then
	force_full=1
	shift
fi

# Target filters only: when package names are given as arguments, only
# transactions whose target matches are published. This lets an operator
# unblock themselves without touching unrelated pending transactions.
# Without arguments, all ready transactions publish. Filters never
# select the gate algorithm; see --full-audit above.
if [ "$#" -gt 0 ]; then
	for pkg in "$@"; do
		case $pkg in
			''|*[!A-Za-z0-9._+-]*) die "invalid package name: $pkg" ;;
		esac
	done
	selected=()
	for transaction in "${ready_transactions[@]}"; do
		[ -f "$transaction/target" ] || continue
		target=$(cat "$transaction/target")
		for pkg in "$@"; do
			if [ "$target" = "$pkg" ]; then
				selected+=("$transaction")
				break
			fi
		done
	done
	[ "${#selected[@]}" -gt 0 ] ||
		die "no ready transactions target the requested packages: $* (build one first: buildpkg $1)"
	ready_transactions=("${selected[@]}")
fi

# Heal mode: --full-audit with an empty stage reconciles repository
# indexes and repository.db with disk truth (e.g. after sanctioned
# out-of-band removal of superseded artifacts) and publishes nothing.
# Without --full-audit an empty stage is still a refusal.
if [ "${#ready_transactions[@]}" -eq 0 ]; then
	if [ "$force_full" -eq 0 ]; then
		die "no complete ready transactions in $incoming_dir"
	fi
	heal_mode=1
	printf 'sign-apk-repo: no staged transactions; --full-audit heals repository indexes from disk state (no publish, retention unchanged)\n'
fi

# Fast path (default): gate only the staged set against persisted
# ownership state (no per-APK re-dump, no full re-verify of immutable
# history). Exit 9 from the gate means state is missing or stale, and
# the run falls back to the full audit below, which refreshes it. Any
# other non-zero exit is a real gate refusal and stops the run.
# Only --full-audit rescans every historical APK.

"$SAPHIRA_PYTHON" - "${ready_transactions[@]}" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

package_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*\.apk$")
for raw in sys.argv[1:]:
    transaction = Path(raw)
    if transaction.is_symlink() or not transaction.is_dir() or not transaction.name.endswith("-ready"):
        raise SystemExit(f"invalid ready transaction: {transaction}")
    required = ("target", "manifest.sha256", "artifact-manifest.json", "package-seed.json")
    for name in required:
        path = transaction / name
        if path.is_symlink() or not path.is_file():
            raise SystemExit(f"ready transaction is incomplete: {path}")
    target = (transaction / "target").read_text(encoding="utf-8").strip()
    with (transaction / "artifact-manifest.json").open(encoding="utf-8") as stream:
        artifact_manifest = json.load(stream)
    with (transaction / "package-seed.json").open(encoding="utf-8") as stream:
        seed = json.load(stream)
    if artifact_manifest.get("schema") != "saphira-build-artifacts/v1" or artifact_manifest.get("target") != target:
        raise SystemExit(f"artifact manifest identity mismatch: {transaction}")
    if artifact_manifest.get("package_seed") != seed or seed.get("schema") != "saphira-package-seed/v1":
        raise SystemExit(f"package seed receipt mismatch: {transaction}")
    constructors = artifact_manifest.get("constructors")
    if not isinstance(constructors, list) or not constructors or any(item.get("constructor") != "makepkg" for item in constructors):
        raise SystemExit(f"transaction did not use canonical makepkg exclusively: {transaction}")
    expected = {}
    for line in (transaction / "manifest.sha256").read_text(encoding="utf-8").splitlines():
        fields = line.split("  ", 1)
        if len(fields) != 2 or not re.fullmatch(r"[0-9a-f]{64}", fields[0]) or not package_re.fullmatch(fields[1]):
            raise SystemExit(f"invalid package checksum manifest: {transaction}")
        if fields[1] in expected:
            raise SystemExit(f"duplicate package in checksum manifest: {fields[1]}")
        expected[fields[1]] = fields[0]
    actual = {path.name for path in transaction.glob("*.apk") if path.is_file() and not path.is_symlink()}
    if set(expected) != actual or not actual:
        raise SystemExit(f"package set does not match checksum manifest: {transaction}")
    for name, digest in expected.items():
        value = hashlib.sha256((transaction / name).read_bytes()).hexdigest()
        if value != digest:
            raise SystemExit(f"package checksum mismatch: {transaction / name}")
PY

# Account declarations staged for publication: map staged APK filename to
# the makepkg-validated fragment declaration carried in the transaction
# artifact manifest (constructors[].artifacts[].accounts). The publish
# account gate reads this; the declarations themselves ship inside the
# packages as usr/share/saphira/accounts.d fragments.
staged_accounts=$workspace/staged-accounts.json
"$SAPHIRA_PYTHON" - "$staged_accounts" "${ready_transactions[@]}" <<'PY'
import json
import sys
from pathlib import Path

out_path = Path(sys.argv[1])
merged = {}
for raw in sys.argv[2:]:
    transaction = Path(raw)
    with (transaction / "artifact-manifest.json").open(encoding="utf-8") as stream:
        manifest = json.load(stream)
    for receipt in manifest.get("constructors", []):
        if receipt.get("constructor") != "makepkg":
            raise SystemExit(f"transaction did not use canonical makepkg exclusively: {transaction}")
        for artifact in receipt.get("artifacts", []):
            filename = Path(artifact["artifact"]).name
            name = artifact["name"]
            # Filenames match name-version.apk by construction (the
            # ownership gate enforces it); the version rides along here
            # so the account gate can collapse superseded declarations.
            if not filename.startswith(name + "-") or not filename.endswith(".apk"):
                raise SystemExit(f"staged filename does not match artifact name: {filename}")
            version = filename[len(name) + 1:-len(".apk")]
            accounts = artifact.get("accounts", {"users": [], "groups": [], "dirs": []})
            entry = {"name": name, "version": version, "accounts": accounts}
            if filename in merged and merged[filename] != entry:
                raise SystemExit(f"conflicting staged receipts for filename: {filename}")
            merged[filename] = entry
with out_path.open("w", encoding="utf-8") as stream:
    json.dump(merged, stream, sort_keys=True, separators=(",", ":"))
    stream.write("\n")
PY

# Automatic retirement of pure-rebuild transactions: when EVERY package in
# a transaction content-conflicts with the same-NVR published copy in some
# generation repository, nothing in it can ever publish (published NVRs
# are immutable; the published copy wins) and retiring it is safe. A
# transaction mixing conflicting rebuilds with publishable packages must
# stop loudly instead - the novel outputs must not be discarded alongside
# the rebuilds.
auto_retired=0
publishable_transactions=()
for transaction in "${ready_transactions[@]}"; do
	conflicts=0
	publishable=0
	conflicting_name=""
	for package in "$transaction"/*.apk; do
		name=${package##*/}
		published_apk=""
		for candidate_repo in "${repo_names[@]}"; do
			candidate=$SAPHIRA_REPO_DIR/$candidate_repo/$SAPHIRA_ARCH/$name
			if [ -e "$candidate" ]; then
				published_apk=$candidate
				break
			fi
		done
		if [ -z "$published_apk" ]; then
			publishable=$((publishable + 1))
			continue
		fi
		probe=$workspace/probe-${name}
		cp -- "$package" "$probe"
		"$SAPHIRA_APK" adbsign --allow-untrusted --sign-key "$sign_key" "$probe" >/dev/null 2>&1 ||
			{ rm -f -- "$probe"; die "incoming package cannot be re-signed for comparison: $package"; }
		if cmp -s -- "$probe" "$published_apk"; then
			publishable=$((publishable + 1))
		else
			conflicts=$((conflicts + 1))
			conflicting_name=$name
		fi
		rm -f -- "$probe"
	done
	if [ "$conflicts" -gt 0 ] && [ "$publishable" -eq 0 ]; then
		retired=${transaction}.superseded-conflict
		[ ! -e "$retired" ] || die "automatic retirement target already exists: $retired"
		mv -- "$transaction" "$retired"
		{
			printf 'Automatically retired by sign-apk-repo: every package in this transaction\n'
			printf 'is a rebuild of an NVR already published in a generation repository with\n'
			printf 'different bytes (first conflict: %s). Published NVRs are immutable and\n' "$conflicting_name"
			printf 'the published copy wins; nothing here could publish. Retained as evidence\n'
			printf 'under the visible lifecycle rules; restore with a rename if disputed.\n'
		} > "$retired/RETIRED-NOTE.txt"
		printf 'sign-apk-repo: auto-retired pure-rebuild transaction %s (every package conflicts with an already-published NVR; the published copy wins)\n' "${transaction##*/}"
		auto_retired=$((auto_retired + 1))
	elif [ "$conflicts" -gt 0 ]; then
		die "published filename is immutable and has different content: $conflicting_name (in transaction ${transaction##*/}; the transaction mixes publishable packages with conflicting rebuilds, so automatic retirement is not safe - retire the rebuild manually and re-run: mv '$transaction' '${transaction}.superseded-conflict')"
	else
		publishable_transactions+=("$transaction")
	fi
done
if [ "${#publishable_transactions[@]}" -gt 0 ]; then
	ready_transactions=("${publishable_transactions[@]}")
elif [ "$heal_mode" -eq 0 ]; then
	printf 'sign-apk-repo: nothing left to publish after automatic retirement (%s transaction(s) auto-retired)\n' "$auto_retired"
	trap - EXIT HUP INT TERM
	cleanup
	exit 0
fi

# Validation pass over every repo (no copies yet): per-repo published
# conflicts die here, cross-transaction conflicts are detected globally,
# and staged_sources accumulates the union of filenames needing
# publication anywhere. Copies and signatures happen exactly once below,
# outside the per-repo loop.
declare -A staged_sources=()
for repo_name in "${repo_names[@]}"; do
	repo_dir=$SAPHIRA_REPO_DIR/$repo_name/$SAPHIRA_ARCH
	for transaction in "${ready_transactions[@]}"; do
	for package in "$transaction"/*.apk; do
		name=${package##*/}
		if [ -e "$repo_dir/$name" ]; then
			if ! cmp -s "$package" "$repo_dir/$name"; then
				# Incoming staging APKs are UNSIGNED while the
				# published copy is signed, so raw-byte comparison
				# is wrong for a deterministic same-version rebuild.
				# Sign a scratch copy with the same key and compare
				# again; only a real content difference conflicts.
				probe=$(mktemp "$workspace/probe-XXXXXXXX.apk")
				cp -- "$package" "$probe"
				"$SAPHIRA_APK" adbsign --allow-untrusted --sign-key "$sign_key" "$probe"
				if ! cmp -s "$probe" "$repo_dir/$name"; then
					die "published filename is immutable and has different content: $name (in transaction ${transaction##*/}; the published copy wins - retire this transaction: mv '$transaction' '${transaction}.superseded-conflict' and re-run sign-apk-repo)"
				fi
				rm -f -- "$probe"
			fi
			continue
		fi
		if [ -n "${staged_sources[$name]-}" ]; then
			if ! cmp -s "$package" "${staged_sources[$name]}"; then
				die "ready transactions conflict for filename: $name (${transaction##*/} differs from an earlier staged transaction; keep the newer build and retire the other: mv '<stale transaction>' '<stale transaction>.superseded-conflict')"
			fi
			continue
		fi
		staged_sources[$name]=$package
	done
done
done

# Stage, sign and verify the union exactly once. Per-repo iterations
# below only publish the subset missing from that repository.
# House packaging policy: no r0 package ever reaches a live generation.
# SAPHIRA_REPO_NAMES lists oldest-first with the live repository last,
# and every production run publishes to ALL of them - so any staged r0
# in a multi-generation run would land live and dies here. Single-
# generation runs are archive surgery (or tests): historical r0
# artifacts stay in the archive generation only. resolvepkg and
# buildpkg-single refuse r0 upstream; this is the publishing boundary
# that makes hand-crafted transactions fail closed too. The other half
# of the policy is the live prune below: any r0 already published to
# the live view retires unconditionally there, so r0 can never linger
# in Hatched no matter how it arrived.
if [ "${#repo_names[@]}" -gt 1 ]; then
	for name in "${!staged_sources[@]}"; do
		case $name in
			*-r0.apk)
				die "r0 packages are forbidden in multi-generation publication (live view ${repo_names[${#repo_names[@]}-1]} would take it): $name (ship pkgrel>=1 - the initial publication of a package is r1)"
				;;
		esac
	done
fi
for name in "${!staged_sources[@]}"; do
	cp --reflink=auto -- "${staged_sources[$name]}" "$packages_dir/$name"
done
for package in "$packages_dir"/*.apk; do
	"$SAPHIRA_APK" adbsign --allow-untrusted --sign-key "$sign_key" "$package"
	"$SAPHIRA_APK" verify --keys-dir "$trust_dir" "$package"
done

publication_id=$(date -u +%Y%m%dT%H%M%SZ)-$$

# Repository metadata (SQLite) gate runner: one implementation, two modes.
# Fast mode (default) evaluates only the staged set against indexed
# repository.db rows (no per-APK re-dump, no full re-verify of immutable
# history). A missing database or schema mismatch REFUSES with an
# explicit migration pointer (exit 2) — bare signing never silently
# creates or migrates repository metadata. A stale fingerprint falls
# back to the full audit (exit 9), which reconciles the ledger before
# publishing. Only --full-audit reconstructs from the actual APKs, and
# even it never destroys or recreates eternal reservation tombstones
# from current-only state. Any other non-zero exit is a real gate
# refusal and stops the run.
# On success the staged set's validated file and account data lands in
# $staged_info for the publication transaction below; the database
# itself is updated exactly once, atomically, after the APKs and
# indexes are installed.
db_gate()
{
	local gate_mode=$1 db_file=$2 staged_info=$3 index_path=$4
	shift 4
	"$SAPHIRA_PYTHON" - "$repo_db_lib" "$SAPHIRA_APK" "$db_file" "$gate_mode" \
		"$staged_accounts" "$staged_list" "$staged_info" \
		"${SAPHIRA_ACCOUNTS_TSV:-/usr/share/saphira/accounts.tsv}" \
		"$repo_dir" "$index_path" "$trust_dir" "$identities" "$@" <<'PY'
import json
import os
import sys
import tempfile
from pathlib import Path

(lib_path, apk, db_file, mode, staged_accounts_path, staged_list_path,
 staged_info_path, tsv_path, repo_dir, index_path, trust_dir,
 identities_path, *packages) = sys.argv[1:]
sys.path.insert(0, os.path.dirname(lib_path))
import repo_db as rdb

# Host /tmp is never Saphira scratch (SAPHIRA_TMPDIR, exported by the
# sourced controller config, else the /build default).
_sign_tmp_base = os.environ.get("SAPHIRA_TMPDIR", "/build/tmp")
os.makedirs(_sign_tmp_base, exist_ok=True)

staged_files = {line.strip() for line in Path(staged_list_path).read_text().splitlines()
                if line.strip()}

try:
    if not os.path.exists(db_file):
        raise FileNotFoundError(db_file)
    conn = rdb.connect(db_file)
except Exception:
    print(f"sign-apk-repo: repository.db is missing or unreadable: {db_file}"
          " (run saphira-repo-migrate <repo>)", file=sys.stderr)
    raise SystemExit(2)
try:
    rdb.check_schema(conn)
except rdb.RepoDbError as exc:
    print(f"sign-apk-repo: {exc}", file=sys.stderr)
    raise SystemExit(2)

if mode == "full":
    print("sign-apk-repo: full audit: census of repository APKs ...")
    census_data = rdb.census(apk, repo_dir)
    carriers = rdb.fragment_carriers(census_data)
    with tempfile.TemporaryDirectory(prefix="sign-apk-repo-audit-", dir=_sign_tmp_base) as tmp:
        declarations = rdb.extract_declarations(apk, repo_dir, carriers, tmp)
    history_complete = rdb.get_meta(conn, "history_complete") == "1"
    notices = []
    try:
        rdb.sync_packages(conn, census_data, declarations, apk, rdb.utcnow())
        # Reservations rebuild is its own explicit transaction (same
        # autocommit atomicity reason as sync_packages): a kill between
        # the two phases leaves packages synced with a stale ledger,
        # which the next stale-fingerprint audit heals - never a mix.
        conn.execute("BEGIN IMMEDIATE")
        try:
            if history_complete:
                conn.execute("DELETE FROM reservations")
                for row in rdb.derive_ledger(apk, census_data, declarations, notices):
                    conn.execute(
                        "INSERT INTO reservations(kind, name, numeric_id, owning_package,"
                        " first_nvr, last_nvr, status, declaration_sha256)"
                        " VALUES (?, ?, ?, ?, ?, ?, ?, ?)", row)
            else:
                rdb.advance_reservations(conn, rdb.active_declarations(conn), False, notices)
        except BaseException:
            conn.execute("ROLLBACK")
            raise
        else:
            conn.execute("COMMIT")
    except rdb.RepoDbError as exc:
        print(f"sign-apk-repo: full audit refused: {exc}", file=sys.stderr)
        raise SystemExit(1)
    for notice in notices:
        print(f"sign-apk-repo: notice: {notice}")
    print(f"sign-apk-repo: full audit: {len(census_data)} APK identities scanned,"
          " ledger verified")
else:
    fresh, reason = rdb.freshness(conn, apk, repo_dir, index_path, trust_dir)
    if not fresh:
        print(f"sign-apk-repo: repository state stale ({reason}); full audit")
        raise SystemExit(9)
    print(f"sign-apk-repo: selective gate: repository state fresh ({reason})")

try:
    staged, notices = rdb.gate_staged(conn, apk, staged_accounts_path,
                                      staged_files, packages, tsv_path)
except rdb.RepoDbError as exc:
    print(f"sign-apk-repo: {exc}", file=sys.stderr)
    raise SystemExit(1)
for notice in notices:
    print(f"sign-apk-repo: notice: {notice}")

with open(staged_info_path, "w", encoding="utf-8") as stream:
    json.dump(staged, stream, sort_keys=True)
    stream.write("\n")
db_idents = {(r["name"], r["version"]) for r in conn.execute(
    "SELECT name, version FROM packages").fetchall()}
for filename, item in staged.items():
    db_idents.add((item["name"], item["version"]))
Path(identities_path).write_text(json.dumps(
    [{"name": n, "version": v} for n, v in sorted(db_idents)],
    separators=(",", ":")) + "\n", encoding="utf-8")

active = conn.execute(
    "SELECT COUNT(*) c FROM reservations WHERE status='ACTIVE'").fetchone()["c"]
print(f"sign-apk-repo: staged gate: {len(staged)} staged package(s) checked"
      f" against {len(db_idents) - len(staged)} repository APK identities"
      f" and {active} active Unix-identity reservations:"
      " no file collisions, no identity collisions")
PY
}

# Publication transaction: apply the staged set to repository.db
# atomically (BEGIN IMMEDIATE) after the APKs and indexes are installed.
# A crash between install and COMMIT surfaces as a stale fingerprint on
# the next run, which refuses and points at --full-audit to heal.
db_apply()
{
	local db_file=$1 staged_info=$2 retire_file=$3
	shift 3
	"$SAPHIRA_PYTHON" - "$repo_db_lib" "$SAPHIRA_APK" "$db_file" "$staged_info" \
		"$repo_dir" "$retire_file" "$@" <<'PY'
import json
import os
import sys

(lib_path, apk, db_file, staged_info_path, repo_dir, retire_path) = sys.argv[1:7]
sys.path.insert(0, os.path.dirname(lib_path))
import repo_db as rdb

try:
    conn = rdb.connect(db_file)
    rdb.check_schema(conn)
except rdb.RepoDbError as exc:
    print(f"sign-apk-repo: {exc}", file=sys.stderr)
    raise SystemExit(2)
with open(staged_info_path, encoding="utf-8") as stream:
    staged = json.load(stream)
with open(retire_path, encoding="utf-8") as stream:
    retired = sorted(line.strip() for line in stream if line.strip())
notices = []
conn.execute("BEGIN IMMEDIATE")
try:
    rdb.apply_staged(conn, apk, repo_dir, staged, rdb.utcnow(), notices)
    if retired:
        rdb.apply_retire(conn, apk, retired,
                         {item["name"] for item in staged.values()}, notices)
    rdb.set_meta(conn, "last_audit", rdb.utcnow())
    conn.commit()
except rdb.RepoDbError as exc:
    conn.rollback()
    print(f"sign-apk-repo: publication transaction failed: {exc}", file=sys.stderr)
    raise SystemExit(1)
for notice in notices:
    print(f"sign-apk-repo: notice: {notice}")
print(f"sign-apk-repo: repository.db transaction committed:"
      f" {len(staged)} staged package(s) applied"
      + (f", {len(retired)} retired package(s) removed" if retired else ""))
PY
}


for repo_name in "${repo_names[@]}"; do
	repo_dir=$SAPHIRA_REPO_DIR/$repo_name/$SAPHIRA_ARCH
	install_set=()
	for name in "${!staged_sources[@]}"; do
		[ -e "$repo_dir/$name" ] || install_set+=("$packages_dir/$name")
	done
identities=$workspace/package-identities.json
	staged_list=$workspace/staged-packages.txt
	: > "$staged_list"
	for staged_file in "${!staged_sources[@]}"; do
		printf '%s\n' "$staged_file" >> "$staged_list"
	done
	db_file=$repo_dir/repository.db
	staged_info=$workspace/$repo_name-staged.json
	# Fast path by default: evaluate only the staged set against indexed
	# repository.db rows (no per-APK re-dump, no full re-verify of
	# immutable history). --full-audit skips straight to the full audit.
	# Exit 9 from the gate means the fingerprint is stale and the run
	# falls back to the full audit, which reconciles. Exit 2 means the
	# database is missing or unusable: refuse with a migration pointer,
	# never a silent fallback. Any other non-zero exit is a real gate
	# refusal and stops the run.
	# Writer lock: the same repository.db.lock every sanctioned writer
	# takes (see repo_db.db_lock_path). mkdir is atomic; failure dies
	# loudly rather than queueing silently.
	db_lock_held=""
	if ! mkdir "$repo_dir/repository.db.lock" 2>/dev/null; then
		die "repository writer lock already held for $repo_name: $repo_dir/repository.db.lock"
	fi
	db_lock_held=$repo_dir
	staged_paths=()
	for name in "${!staged_sources[@]}"; do
		staged_paths+=("${staged_sources[$name]}")
	done
	gate_mode=full
	if [ "$force_full" -eq 0 ]; then
		gate_status=0
		db_gate fast "$db_file" "$staged_info" "$repo_dir/Packages.adb" "${staged_paths[@]}" || gate_status=$?
		if [ "$gate_status" -eq 0 ]; then
			gate_mode=fast
		elif [ "$gate_status" -ne 9 ]; then
			die "repository gate failed for $repo_name (see above)"
		fi
	fi
	if [ "$gate_mode" = full ]; then
		for package in "$repo_dir"/*.apk; do
			"$SAPHIRA_APK" verify --keys-dir "$trust_dir" "$package" >/dev/null
		done
		db_gate full "$db_file" "$staged_info" "$repo_dir/Packages.adb" "${staged_paths[@]}" \
			|| die "full audit failed for $repo_name (see above)"
	fi

# Hatched retention + r0 inadmissibility: the live generation keeps the
# newest SAPHIRA_RETAIN_GENERATIONS NVRs per name, and r0 never exists
# here at all. Prune order: (1) every published r0 retires
# unconditionally - explicit holds on r0 and live dependents needing an
# r0 fail closed instead; (2) normal retention over r1+ (latest keep
# generations, exact live dependency holds, explicit holds); (3) split
# siblings retire atomically in the same pass; (4) indexes/identities
# regenerate; (5) repository.db/claims update in the same transactional
# publication flow. Archive generations are never pruned
# (single-generation runs prune nothing: production always publishes to
# all generations, live last). Files go before index regen, rows go with
# the staged apply in one transaction - never bare rm.
live_generation=${repo_names[${#repo_names[@]}-1]}
retire_file=$workspace/$repo_name-retire.txt
: > "$retire_file"
# Heal mode skips retention: nothing new to make room for, and
# policy pruning never runs as a heal side effect (it applies on
# the next publish as usual).
if [ "$heal_mode" -eq 0 ] && [ "${#repo_names[@]}" -gt 1 ] && [ "$repo_name" = "$live_generation" ]; then
	case ${SAPHIRA_RETAIN_GENERATIONS:-2} in
		''|*[!0-9]*|0) die "invalid SAPHIRA_RETAIN_GENERATIONS: ${SAPHIRA_RETAIN_GENERATIONS:-2} (positive integer required)" ;;
	esac
	"$SAPHIRA_PYTHON" - "$repo_db_lib" "$SAPHIRA_APK" "$db_file" "$repo_dir/Packages.adb" \
		"${SAPHIRA_RETAIN_GENERATIONS:-2}" "$SAPHIRA_RETAIN_NVR" "$retire_file" "$identities" \
		"${staged_paths[@]}" <<'PY' || die "retention planning failed for $repo_name (see above)"
import json
import os
import sys

(lib_path, apk, db_file, index_path, keep, holds, retire_path,
 identities_path, *packages) = sys.argv[1:]
sys.path.insert(0, os.path.dirname(lib_path))
import repo_db as rdb

staged = {}
for raw in packages:
    dumped = rdb.dump_package(apk, raw)
    staged[(dumped["name"], dumped["version"])] = dumped.get("depends", [])
conn = rdb.connect_readonly(db_file)
try:
    index_map = rdb.index_depends(apk, index_path)
except rdb.RepoDbError as exc:
    # No live index yet (first publish to a fresh generation) or a
    # manually deleted one: dependency holds degrade to rank+holds only,
    # loudly. Rank-based retirement stays exact (db-driven); the run's
    # own index regen restores full precision afterwards.
    print(f"sign-apk-repo: retention: WARNING: {exc} - continuing with rank-based retirement only")
    index_map = {}
retired = {}
try:
    retired = rdb.compute_retire_set(conn, apk, staged, index_map, int(keep),
                                     holds.split() if holds.strip() else [])
except rdb.RepoDbError as exc:
    print(f"sign-apk-repo: retention refused: {exc}", file=sys.stderr)
    raise SystemExit(1)
conn.close()
with open(retire_path, "w", encoding="utf-8") as stream:
    for filename in sorted(retired):
        stream.write(filename + "\n")
if retired:
    with open(identities_path, encoding="utf-8") as stream:
        idents = json.load(stream)
    kept = [item for item in idents
            if f"{item['name']}-{item['version']}.apk" not in retired]
    with open(identities_path, "w", encoding="utf-8") as stream:
        json.dump(kept, stream, sort_keys=True)
        stream.write("\n")
    print("sign-apk-repo: retention: retired "
          + str(len(retired)) + " package(s): "
          + ", ".join(sorted(retired)))
else:
    print("sign-apk-repo: retention: nothing to retire")
PY
	while IFS= read -r filename || [ -n "$filename" ]; do
		[ -n "$filename" ] || continue
		[ -e "$repo_dir/$filename" ] || die "retire set references missing file: $filename (repository inconsistent - run --full-audit)"
		rm -f -- "$repo_dir/$filename"
	done < "$retire_file"
fi
all_packages=("$repo_dir"/*.apk)
[ "${#install_set[@]}" -eq 0 ] || all_packages+=("${install_set[@]}")
[ "${#all_packages[@]}" -gt 0 ] || die "publication set contains no APK files"

packages_adb=$workspace/$repo_name-Packages.adb
apkindex=$workspace/$repo_name-APKINDEX.tar.gz
repo_generate_index "$SAPHIRA_APK" "$packages_adb" "$apkindex" "$sign_key" "$trust_dir" \
	"${all_packages[@]}" || die "index generation failed for $repo_name"

"$SAPHIRA_PYTHON" - "$SAPHIRA_APK" "$identities" "$packages_adb" "$apkindex" <<'PY'
import json
import re
import subprocess
import sys

apk, identities_path, *indexes = sys.argv[1:]
with open(identities_path, encoding="utf-8") as stream:
    expected = {(item["name"], item["version"]) for item in json.load(stream)}
for index in indexes:
    dump = subprocess.run([apk, "adbdump", index], check=True, text=True, capture_output=True).stdout
    names = re.findall(r"^  - name: (\S+)$", dump, re.MULTILINE)
    versions = re.findall(r"^    version: (\S+)$", dump, re.MULTILINE)
    actual = set(zip(names, versions))
    if len(names) != len(versions) or len(actual) != len(names) or actual != expected:
        raise SystemExit(f"index APK identities/count do not match package set: {index}")
PY

for package in ${install_set[@]+"${install_set[@]}"}; do
	name=${package##*/}
	temporary=$repo_dir/$name.publishing-$publication_id
	[ ! -e "$repo_dir/$name" ] || die "package appeared concurrently: $name"
	install -m 644 -- "$package" "$temporary"
	mv -- "$temporary" "$repo_dir/$name"
	normalize_ownership "$repo_dir/$name"
done

for index_name in Packages.adb APKINDEX.tar.gz; do
	case $index_name in
		Packages.adb) source_index=$packages_adb ;;
		APKINDEX.tar.gz) source_index=$apkindex ;;
	esac
	temporary=$repo_dir/$index_name.publishing-$publication_id
	install -m 644 -- "$source_index" "$temporary"
	mv -f -- "$temporary" "$repo_dir/$index_name"
	normalize_ownership "$repo_dir/$index_name"
done
# Apply the staged set to repository.db atomically (BEGIN IMMEDIATE),
# last of all, so the database never runs ahead of the installed APKs
# and indexes. A crash before COMMIT surfaces as a stale fingerprint
# on the next run, which refuses and points at --full-audit to heal.
# The frozen ownership.json beside the database is migration evidence
# only and is never written here.
db_apply "$db_file" "$staged_info" "$retire_file" || die "repository.db transaction failed for $repo_name (see above)"
normalize_ownership "$repo_dir/repository.db"
rmdir -- "$repo_dir/repository.db.lock" 2>/dev/null || true
db_lock_held=""
chmod g+rws -- "$repo_dir" 2>/dev/null || true

printf 'sign-apk-repo: published and indexed %s verified APK files in %s\n' \
	"${#all_packages[@]}" "$repo_dir"
done

for transaction in "${ready_transactions[@]}"; do
	published=${transaction%-ready}-published
	[ ! -e "$published" ] || die "published transaction marker already exists: $published"
	mv -- "$transaction" "$published"
done

trap - EXIT HUP INT TERM
cleanup
printf 'sign-apk-repo: publication complete across %s generation repositories\n' "${#repo_names[@]}"
