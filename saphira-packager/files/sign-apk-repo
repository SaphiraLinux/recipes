import sys

apk, identities_path, *indexes = sys.argv[1:]
with open(identities_path, encoding="utf-8") as stream:
    expected = {(item["name"], item["version"]) for item in json.load(stream)}
for index in indexes:
    dump = subprocess.run([apk, "adbdump", index], check=True, text=True, capture_output=True).stdout
    names = re.findall(r"^  - name: (\S+)$", dump, re.MULTILINE)
    versions = re.findall(r"^    version: (\S+)$", dump, re.MULTILINE)
    actual = set(zip(names, versions))
    if len(names) != len(versions) or len(actual) != len(names) or actual != expected:
        raise SystemExit(f"index APK identities/count do not match package set: {index}")
PY

for package in ${install_set[@]+"${install_set[@]}"}; do
	name=${package##*/}
	_parch=${staged_archs[$name]-}
	[ -n "$_parch" ] || die "install set file has no recorded arch: $name"
	case $_parch in
		"$SAPHIRA_ARCH"|noarch) ;;
		*) die "refusing to place $name with unvalidated arch: $_parch" ;;
	esac
	_destdir=$repo_base/$_parch
	mkdir -p -- "$_destdir"
	temporary=$_destdir/$name.publishing-$publication_id
	[ ! -e "$_destdir/$name" ] || die "package appeared concurrently: $_destdir/$name"
	install -m 644 -- "$package" "$temporary"
	mv -- "$temporary" "$_destdir/$name"
	normalize_ownership "$_destdir/$name"
done

for index_name in Packages.adb APKINDEX.tar.gz; do
	case $index_name in
		Packages.adb) source_index=$packages_adb ;;
		APKINDEX.tar.gz) source_index=$apkindex ;;
	esac
	temporary=$repo_dir/$index_name.publishing-$publication_id
	install -m 644 -- "$source_index" "$temporary"
	mv -f -- "$temporary" "$repo_dir/$index_name"
	normalize_ownership "$repo_dir/$index_name"
done
# Apply the staged set to repository.db atomically (BEGIN IMMEDIATE),
# last of all, so the database never runs ahead of the installed APKs
# and indexes. A crash before COMMIT surfaces as a stale fingerprint
# on the next run, which refuses and points at --full-audit to heal.
# The frozen ownership.json beside the database is migration evidence
# only and is never written here.
db_apply "$db_file" "$staged_info" "$retire_file" || die "repository.db transaction failed for $repo_name (see above)"
normalize_ownership "$repo_dir/repository.db"
rmdir -- "$repo_dir/repository.db.lock" 2>/dev/null || true
db_lock_held=""
chmod g+rws -- "$repo_dir" 2>/dev/null || true
[ -d "$repo_base/noarch" ] && chmod g+rws -- "$repo_base/noarch" 2>/dev/null || true

printf 'sign-apk-repo: published and indexed %s verified APK files in %s (+ noarch split where present)\n' \
	"${#all_packages[@]}" "$repo_base"
done

for transaction in "${ready_transactions[@]}"; do
	published=${transaction%-ready}-published
	[ ! -e "$published" ] || die "published transaction marker already exists: $published"
	mv -- "$transaction" "$published"
	python3 - "$ownership_json" "$published" <<'PY'
import json, sys
from pathlib import Path
ownership, published_dir = json.load(open(sys.argv[1])), Path(sys.argv[2])
basename = published_dir.name[:-len("-published")] + "-ready"
record = ownership.get("transactions", {}).get(basename)
lines = ["Published by sign-apk-repo (authoritative-producer gate).",
         "Original manifests preserved in this directory."]
if record:
    for e in record.get("novel", []):
        lines.append(f"published authoritative: {e['filename']} sha256 {e['sha256']} producer {e['producer']}")
    for e in record.get("identical", []):
        lines.append(f"skipped already-published-identical: {e['filename']} sha256 {e['sha256']} producer {e['producer']}")
    for e in record.get("bundled", []):
        lines.append(f"skipped bundled build-input: {e['filename']} sha256 {e['sha256']} producer {e['producer']} (publish via its authoritative producer transaction)")
with open(published_dir / "PUBLICATION-REPORT.txt", "w", encoding="utf-8") as f:
    f.write("\n".join(lines) + "\n")
PY
done

trap - EXIT HUP INT TERM
cleanup
printf 'sign-apk-repo: publication complete across %s generation repositories\n' "${#repo_names[@]}"
if [ "${skipped_disabled:-0}" -gt 0 ]; then
	printf 'sign-apk-repo: %s staged transaction(s) from disabled recipes were skipped (see warnings above); retire them with the rename-and-note convention\n' "$skipped_disabled" >&2
fi
