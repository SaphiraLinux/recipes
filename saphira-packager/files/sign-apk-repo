#!/bin/bash

set -euo pipefail

. "${SAPHIRA_CONFIG_FILE:-/etc/saphira/package_builder.sh}"

# Shared index generation/signing (source tree and tests carry it next to
# this script; the installed packager places it in /usr/lib/saphira-packager).
lib_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$lib_dir/repo-index.sh" ]; then
	. "$lib_dir/repo-index.sh"
elif [ -f /usr/lib/saphira-packager/repo-index.sh ]; then
	. /usr/lib/saphira-packager/repo-index.sh
else
	printf 'sign-apk-repo: shared index helper repo-index.sh not found\n' >&2
	exit 1
fi

# Shared repository metadata library (SQLite, single-file). Same
# resolution rule as repo-index.sh: beside this script first (source
# tree and tests), installed location second.
repo_db_lib=$lib_dir/repo_db.py
[ -f "$repo_db_lib" ] || repo_db_lib=/usr/lib/saphira-packager/repo_db.py
[ -f "$repo_db_lib" ] || die "repository metadata library repo_db.py not found"

die()
{
	printf 'sign-apk-repo: %s\n' "$*" >&2
	exit 1
}

[ "$EUID" -eq 0 ] || die "must be run as root; use sudo explicitly"

# Ownership policy: published /out state belongs to the invoking user with
# the repository group, even when invoked through sudo. Repository
# directories are kept setgid so group inheritance holds between writes.
normalize_ownership()
{
	if [ -n "${SUDO_UID:-}" ]; then
		chown "${SUDO_UID}:${SAPHIRA_REPO_GROUP:-saphira-build}" "$@" 2>/dev/null || true
	fi
}

incoming_dir=$SAPHIRA_INCOMING_DIR/$SAPHIRA_ARCH
sign_key=$SAPHIRA_SIGN_KEY
trust_key=$SAPHIRA_TRUST_KEY
trust_dir=${trust_key%/*}

IFS=' ' read -ra repo_names <<< "$SAPHIRA_REPO_NAMES"
[ "${#repo_names[@]}" -gt 0 ] || die "SAPHIRA_REPO_NAMES is empty"
for repo_name in "${repo_names[@]}"; do
	case $repo_name in
		''|*[!A-Za-z0-9._-]*) die "invalid repository name: $repo_name" ;;
	esac
	repo_dir=$SAPHIRA_REPO_DIR/$repo_name/$SAPHIRA_ARCH
	[ -d "$repo_dir" ] || die "generation repository does not exist: $repo_dir (seed it or fix SAPHIRA_REPO_NAMES)"
done

[ -r "$sign_key" ] || die "cannot read signing key: $sign_key"
[ -r "$trust_key" ] || die "cannot read repository trust key: $trust_key"
mkdir -p "$incoming_dir" "$SAPHIRA_PACKAGE_TMP"

lock=$incoming_dir/sign-apk-repo.lock
mkdir "$lock" 2>/dev/null || die "publication lock already exists: $lock"
workspace=$(mktemp -d "$SAPHIRA_PACKAGE_TMP/sign-apk-repo-XXXXXXXX")
packages_dir=$workspace/packages
mkdir "$packages_dir"

cleanup()
{
	if [ -n "${db_lock_held-}" ]; then
		rmdir -- "$db_lock_held/repository.db.lock" 2>/dev/null || true
	fi
	rm -rf -- "$workspace"
	rmdir "$lock" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

shopt -s nullglob
ready_transactions=("$incoming_dir"/*-ready)

# Publication mode: full repository audit only on explicit request.
# Otherwise the indexed repository.db gates just the staged set (fast
# when the fingerprint is fresh; automatic full audit when stale). A
# missing or unusable database refuses with a migration pointer — bare
# signing never silently creates repository metadata.
# Positional arguments are target filters only; they never select
# the algorithm. No valid package target starts with `-`, so the
# exact-match flag below cannot collide with a filter.
force_full=0
heal_mode=0
if [ "${1:-}" = "--full-audit" ]; then
	force_full=1
	shift
fi

# Target filters only: when package names are given as arguments, only
# transactions whose target matches are published. This lets an operator
# unblock themselves without touching unrelated pending transactions.
# Without arguments, all ready transactions publish. Filters never
# select the gate algorithm; see --full-audit above.
filter_requested=0
if [ "$#" -gt 0 ]; then
	for pkg in "$@"; do
		case $pkg in
			''|*[!A-Za-z0-9._+-]*) die "invalid package name: $pkg" ;;
		esac
	done
	filter_requested=1
	selected=()
	for transaction in "${ready_transactions[@]}"; do
		[ -f "$transaction/target" ] || continue
		target=$(cat "$transaction/target")
		for pkg in "$@"; do
			if [ "$target" = "$pkg" ]; then
				selected+=("$transaction")
				break
			fi
		done
	done
	[ "${#selected[@]}" -gt 0 ] ||
		die "no ready transactions target the requested packages: $* (build one first: buildpkg $1)"
	ready_transactions=("${selected[@]}")
fi

# Disabled-producer guard: a transaction staged before its recipe was
# disabled (or whose recipe is gone) must never publish. A disabled
# duplicate staged before its recipe was retired rode the *-ready glob
# into the ownership gate and failed *every* run, blocking unrelated
# packages (python-pyparsing precedent); four same-name
# saphira-bpftool transactions did the same against the published
# bpftool. Disabled producers are skipped loudly so the run can
# proceed; missing recipes are unknown provenance and fail closed.
# Retire stale transactions with the rename-and-note convention
# instead of publishing them. The guard keys on plan.json, which
# every builder-produced transaction carries; older or hand-staged
# transactions without one keep the pre-existing validation path
# untouched.
skipped_disabled=0
skipped_transactions=()
if [ "${#ready_transactions[@]}" -gt 0 ]; then
	kept=()
	for transaction in "${ready_transactions[@]}"; do
		if [ ! -f "$transaction/plan.json" ]; then
			kept+=("$transaction")
			continue
		fi
		producer=$("$SAPHIRA_PYTHON" -c 'import json,sys; print(json.load(open(sys.argv[1])).get("target_producer","") or "")' "$transaction/plan.json" 2>/dev/null || true)
		if [ -z "$producer" ] && [ -f "$transaction/target" ]; then
			producer=$(cat "$transaction/target")
		fi
		case $producer in
			''|*[!A-Za-z0-9._+-]*)
				die "cannot determine producing recipe for staged transaction ${transaction##*/} (no usable plan.json target_producer or target file)"
				;;
		esac
		recipe_file=${SAPHIRA_RECIPE_ROOT:-/recipes}/$producer/recipe.sh
		if [ ! -f "$recipe_file" ]; then
			die "staged transaction ${transaction##*/} names missing recipe $producer (retire the transaction, never publish it)"
		fi
		if grep -q '^disabled=yes$' "$recipe_file"; then
			reason=$(grep '^disabled_reason=' "$recipe_file" | head -1)
		printf 'sign-apk-repo: skipping %s: producer recipe %s is disabled (%s); retire the transaction instead of publishing it\n' "${transaction##*/}" "$producer" "${reason#disabled_reason=}" >&2
		skipped_disabled=$((skipped_disabled + 1))
		skipped_transactions+=("$transaction")
		continue
		fi
		kept+=("$transaction")
	done
	ready_transactions=("${kept[@]}")
fi
if [ "${#ready_transactions[@]}" -eq 0 ]; then
	if [ "$force_full" -eq 0 ]; then
		if [ "$skipped_disabled" -gt 0 ]; then
			die "all $skipped_disabled staged transaction(s) are from disabled recipes (see warnings above); retire them, then re-run"
		fi
		die "no complete ready transactions in $incoming_dir"
	fi
	heal_mode=1
	printf 'sign-apk-repo: no staged transactions; --full-audit heals repository indexes from disk state (no publish, retention unchanged)\n'
fi

# Fast path (default): gate only the staged set against persisted
# ownership state (no per-APK re-dump, no full re-verify of immutable
# history). Exit 9 from the gate means state is missing or stale, and
# the run falls back to the full audit below, which refreshes it. Any
# other non-zero exit is a real gate refusal and stops the run.
# Only --full-audit rescans every historical APK.

"$SAPHIRA_PYTHON" - "${ready_transactions[@]}" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

package_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*\.apk$")
for raw in sys.argv[1:]:
    transaction = Path(raw)
    if transaction.is_symlink() or not transaction.is_dir() or not transaction.name.endswith("-ready"):
        raise SystemExit(f"invalid ready transaction: {transaction}")
    required = ("target", "manifest.sha256", "artifact-manifest.json", "package-seed.json")
    for name in required:
        path = transaction / name
        if path.is_symlink() or not path.is_file():
            raise SystemExit(f"ready transaction is incomplete: {path}")
    target = (transaction / "target").read_text(encoding="utf-8").strip()
    with (transaction / "artifact-manifest.json").open(encoding="utf-8") as stream:
        artifact_manifest = json.load(stream)
    with (transaction / "package-seed.json").open(encoding="utf-8") as stream:
        seed = json.load(stream)
    if artifact_manifest.get("schema") != "saphira-build-artifacts/v1" or artifact_manifest.get("target") != target:
        raise SystemExit(f"artifact manifest identity mismatch: {transaction}")
    if artifact_manifest.get("package_seed") != seed or seed.get("schema") != "saphira-package-seed/v1":
        raise SystemExit(f"package seed receipt mismatch: {transaction}")
    constructors = artifact_manifest.get("constructors")
    if not isinstance(constructors, list) or not constructors or any(item.get("constructor") != "makepkg" for item in constructors):
        raise SystemExit(f"transaction did not use canonical makepkg exclusively: {transaction}")
    expected = {}
    for line in (transaction / "manifest.sha256").read_text(encoding="utf-8").splitlines():
        fields = line.split("  ", 1)
        if len(fields) != 2 or not re.fullmatch(r"[0-9a-f]{64}", fields[0]) or not package_re.fullmatch(fields[1]):
            raise SystemExit(f"invalid package checksum manifest: {transaction}")
        if fields[1] in expected:
            raise SystemExit(f"duplicate package in checksum manifest: {fields[1]}")
        expected[fields[1]] = fields[0]
    actual = {path.name for path in transaction.glob("*.apk") if path.is_file() and not path.is_symlink()}
    if set(expected) != actual or not actual:
        raise SystemExit(f"package set does not match checksum manifest: {transaction}")
    for name, digest in expected.items():
        value = hashlib.sha256((transaction / name).read_bytes()).hexdigest()
        if value != digest:
            raise SystemExit(f"package checksum mismatch: {transaction / name}")
PY

# Account declarations staged for publication: map staged APK filename to
# the makepkg-validated fragment declaration carried in the transaction
# artifact manifest (constructors[].artifacts[].accounts). The publish
# account gate reads this; the declarations themselves ship inside the
# packages as usr/share/saphira/accounts.d fragments.
staged_accounts=$workspace/staged-accounts.json
"$SAPHIRA_PYTHON" - "$staged_accounts" "${ready_transactions[@]}" <<'PY'
import json
import sys
from pathlib import Path

out_path = Path(sys.argv[1])
merged = {}
for raw in sys.argv[2:]:
    transaction = Path(raw)
    with (transaction / "artifact-manifest.json").open(encoding="utf-8") as stream:
        manifest = json.load(stream)
    for receipt in manifest.get("constructors", []):
        if receipt.get("constructor") != "makepkg":
            raise SystemExit(f"transaction did not use canonical makepkg exclusively: {transaction}")
        for artifact in receipt.get("artifacts", []):
            filename = Path(artifact["artifact"]).name
            name = artifact["name"]
            # Filenames match name-version.apk by construction (the
            # ownership gate enforces it); the version rides along here
            # so the account gate can collapse superseded declarations.
            if not filename.startswith(name + "-") or not filename.endswith(".apk"):
                raise SystemExit(f"staged filename does not match artifact name: {filename}")
            version = filename[len(name) + 1:-len(".apk")]
            accounts = artifact.get("accounts", {"users": [], "groups": [], "dirs": []})
            fhs = artifact.get("fhs", {"dirs": [], "replaces": [], "removals": []})
            caps = artifact.get("caps", {"caps": []})
            entry = {"name": name, "version": version, "accounts": accounts, "fhs": fhs, "caps": caps}
            if filename in merged and merged[filename] != entry:
                raise SystemExit(f"conflicting staged receipts for filename: {filename}")
            merged[filename] = entry
with out_path.open("w", encoding="utf-8") as stream:
    json.dump(merged, stream, sort_keys=True, separators=(",", ":"))
    stream.write("\n")
PY

# Publisher snapshot: record staged transactions before any decision.
# buildpkg refuses to stage while sign-apk-repo.lock exists; revalidation
# below fails closed if the stage changed anyway (concurrent builder or
# manual move), before any repository or incoming mutation. Skipped
# disabled-producer transactions are pinned in the snapshot exactly like
# selected ones (they stay on disk untouched); only truly new,
# disappeared, or altered entries invalidate the run.
snapshot_file=$workspace/incoming-snapshot.txt
: > "$snapshot_file"
for transaction in "${ready_transactions[@]}" ${skipped_transactions[@]+"${skipped_transactions[@]}"}; do
	[ -f "$transaction/manifest.sha256" ] || die "ready transaction is incomplete: $transaction"
	manifest_hash=$(sha256sum "$transaction/manifest.sha256" | awk '{ print $1 }')
	printf '%s %s\n' "${transaction##*/}" "$manifest_hash" >> "$snapshot_file"
done
sort -o "$snapshot_file" "$snapshot_file"

revalidate_snapshot()
{
	revalidation_tmp=$workspace/incoming-snapshot-check.txt
	: > "$revalidation_tmp"
	for transaction in "$incoming_dir"/*-ready; do
		[ -e "$transaction" ] || continue
		[ -d "$transaction" ] || continue
		manifest_hash=""
		if [ -f "$transaction/manifest.sha256" ]; then
			manifest_hash=$(sha256sum "$transaction/manifest.sha256" | awk '{ print $1 }')
		fi
		printf '%s %s\n' "${transaction##*/}" "$manifest_hash" >> "$revalidation_tmp"
	done
	sort -o "$revalidation_tmp" "$revalidation_tmp"
	# Filtered runs (explicit package targets): only the selected set is
	# pinned; unrelated pending transactions are ignored. Unfiltered runs
	# pin the whole stage: any new ready appearing mid-run invalidates it.
	if [ "$filter_requested" -eq 1 ]; then
		while IFS= read -r line || [ -n "$line" ]; do
			[ -n "$line" ] || continue
			grep -qF -- "$line" "$revalidation_tmp" ||
				die "publisher snapshot invalidated during run: selected transaction changed or disappeared: ${line%% *} (concurrent builder rename? re-run sign-apk-repo)"
		done < "$snapshot_file"
	else
		if ! cmp -s -- "$snapshot_file" "$revalidation_tmp"; then
			die "publisher snapshot invalidated during run: incoming stage changed under lock (concurrent builder or manual move); no repository mutation performed - re-run sign-apk-repo"
		fi
	fi
	rm -f -- "$revalidation_tmp"
}

# Ownership gate (minimal): authoritative outputs are APKs produced by the
# transaction's own target recipe (producer == target); bundled dependency
# copies are build inputs and never publishable from this transaction.
# - Same NVR authoritatively claimed with different bytes -> FAIL CLOSED.
# - Published NVR immutable; pure authoritative rebuilds auto-retire.
# - Bundled present without closure-hashes -> uncertainty, FAIL CLOSED.
# - Bundled stale vs authoritative/published -> FAIL CLOSED with rebuild.
# - Missing dependency with no published/staged provider -> FAIL CLOSED.
ownership_json=$workspace/ownership.json
publishable_list=$workspace/publishable-transactions.txt
autorelire_list=$workspace/autoretire-transactions.txt
"$SAPHIRA_PYTHON" - "$ownership_json" "$publishable_list" "$autorelire_list" \
	"$SAPHIRA_APK" "$sign_key" "$SAPHIRA_REPO_DIR" "$SAPHIRA_ARCH" \
	"${repo_names[@]}" -- "${ready_transactions[@]}" <<'PY'
import hashlib
import json
import subprocess
import sys
from pathlib import Path

args = sys.argv[1:]
ownership_path = Path(args[0])
publishable_path = Path(args[1])
autorelire_path = Path(args[2])
apk_bin = args[3]
sign_key = args[4]
repo_root = Path(args[5])
arch = args[6]
sep = args.index("--")
repo_names = args[7:sep]
transactions = [Path(p) for p in args[sep+1:]]

def die(msg):
    print(f"sign-apk-repo: {msg}", file=sys.stderr)
    raise SystemExit(1)

def file_sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()

def signed_equal(staged, published):
    import tempfile, shutil
    with tempfile.NamedTemporaryFile(suffix=".apk", delete=False) as tmp:
        tmp_path = tmp.name
    try:
        shutil.copy2(staged, tmp_path)
        subprocess.run([apk_bin, "adbsign", "--allow-untrusted",
                        "--sign-key", sign_key, tmp_path],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        with open(tmp_path, "rb") as a, open(published, "rb") as b:
            return a.read() == b.read()
    finally:
        try:
            Path(tmp_path).unlink()
        except OSError:
            pass

def dump_depends(path):
    out = subprocess.run([apk_bin, "adbdump", str(path)],
                         check=True, text=True, capture_output=True).stdout
    depends = []
    section = None
    in_list = None
    for line in out.splitlines():
        if line and not line.startswith(" ") and line.endswith(":"):
            section = line[:-1]
            in_list = None
            continue
        if section == "info":
            if line.strip() == "depends:":
                in_list = "depends"
                continue
            if in_list == "depends":
                s = line.strip()
                if s.startswith("- "):
                    depends.append(s[2:].strip())
                    continue
                if line.startswith("  ") and not line.startswith("    "):
                    in_list = None
    return depends

txns = {}
auth_claims = {}
for txn in transactions:
    target = (txn / "target").read_text(encoding="utf-8").strip()
    manifest = json.loads((txn / "artifact-manifest.json").read_text(encoding="utf-8"))
    plan = json.loads((txn / "plan.json").read_text(encoding="utf-8")) if (txn / "plan.json").is_file() else None
    closure = json.loads((txn / "closure-hashes.json").read_text(encoding="utf-8")) if (txn / "closure-hashes.json").is_file() else None
    producers = [r.get("producer") for r in manifest.get("constructors", []) if r.get("producer")]
    has_artifacts = any(isinstance(r.get("artifacts"), list) and r.get("artifacts") for r in manifest.get("constructors", []))
    file_producer = {}
    if has_artifacts:
        for r in manifest.get("constructors", []):
            for art in r.get("artifacts", []) or []:
                file_producer[Path(art["artifact"]).name] = r.get("producer")
    else:
        for f in txn.glob("*.apk"):
            best = None
            for prod in producers:
                if f.name.startswith(prod + "-") and (best is None or len(prod) > len(best)):
                    best = prod
            file_producer[f.name] = best if best is not None else target
    staged_files = {}
    for line in (txn / "manifest.sha256").read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        digest, _, fname = line.partition("  ")
        if not digest or not fname:
            die(f"invalid package checksum manifest: {txn}")
        staged_files[fname] = digest
    authoritative = []
    bundled = []
    for fname, sha in staged_files.items():
        producer = file_producer.get(fname)
        if producer is None:
            die(f"staged file has no producer receipt: {txn}/{fname}")
        if file_sha256(txn / fname) != sha:
            die(f"package checksum mismatch: {txn}/{fname}")
        entry = {"filename": fname, "sha256": sha, "producer": producer}
        (authoritative if producer == target else bundled).append(entry)
    txns[str(txn)] = {"basename": txn.name, "path": str(txn), "target": target,
                      "authoritative": authoritative, "bundled": bundled,
                      "has_closure": closure is not None, "closure": closure}
    for e in authoritative:
        auth_claims.setdefault(e["filename"], []).append(
            {"transaction": str(txn), "basename": txn.name, "producer": e["producer"], "sha256": e["sha256"]})

for fname, claimants in sorted(auth_claims.items()):
    if len({c["sha256"] for c in claimants}) > 1:
        detail = ", ".join(f"{c['basename']} (producer {c['producer']} sha256 {c['sha256'][:12]})" for c in claimants)
        die(f"conflicting authoritative producers for {fname}: {detail} - refusing (no newest/timestamp winner; bump pkgrel or retire stale transactions manually)")

present = {}
for fname in auth_claims:
    hits = []
    for r in repo_names:
        in_repo = [repo_root / r / d / fname for d in (arch, "noarch")
                   if (repo_root / r / d / fname).is_file()]
        if len(in_repo) > 1:
            die(f"filename claimed in two arch directories of {r}: {fname} - repository inconsistent, run --full-audit")
        hits.extend(in_repo)
    present[fname] = hits

txn_conflicts, txn_novel, txn_identical = {}, {}, {}
for txn_path, info in txns.items():
    conflicts, novel, identical = [], [], []
    for e in info["authoritative"]:
        staged = Path(txn_path) / e["filename"]
        pubs = present.get(e["filename"], [])
        if not pubs:
            novel.append(e)
        elif any(not signed_equal(str(staged), str(p)) for p in pubs):
            conflicts.append(e)
        elif len(pubs) < len(repo_names):
            novel.append(e)
        else:
            identical.append(e)
    txn_conflicts[txn_path], txn_novel[txn_path], txn_identical[txn_path] = conflicts, novel, identical

auto_retire = [p for p, c in txn_conflicts.items() if c and not txn_novel[p] and not txns[p]["bundled"]]
for p, c in txn_conflicts.items():
    if c and txn_novel[p]:
        die(f"published filename is immutable and has different content: {', '.join(e['filename'] for e in c)} (in transaction {Path(p).name}; same producer version mixes conflicting rebuilds with novel splits - refusing partial publish; bump pkgrel or retire stale transaction)")

remaining = {p: i for p, i in txns.items() if p not in auto_retire}
for txn_path, info in remaining.items():
    if info["bundled"] and not info["has_closure"]:
        bnames = ", ".join(f"{e['filename']} (producer {e['producer']})" for e in info["bundled"])
        die(f"uncertain provenance: transaction {Path(txn_path).name} bundles dependency outputs without build-time closure hashes ({bnames}); cannot prove consumer freshness - refusing unsafe publication (rebuild with current builder to emit per-producer transactions with plan.json + closure-hashes.json, then re-run: buildpkg {info['target']})")
    if info["has_closure"]:
        for e in info["bundled"]:
            fname = e["filename"]
            current = [c for c in auth_claims.get(fname, []) if c["transaction"] in remaining]
            if current and e["sha256"] not in {c["sha256"] for c in current}:
                die(f"stale consumer: {Path(txn_path).name} bundles {fname} sha256 {e['sha256'][:12]} but authoritative {current[0]['basename']} carries different bytes; dependency was rebuilt - rebuild consumer (buildpkg {info['target']}) and re-run sign-apk-repo")
            elif not current:
                pubs = present.get(fname, [])
                if pubs and any(not signed_equal(str(Path(txn_path) / fname), str(p)) for p in pubs):
                    die(f"stale consumer: {Path(txn_path).name} bundles {fname} differing from published immutable NVR; published copy wins - rebuild consumer against current repository (buildpkg {info['target']})")
                elif not pubs:
                    die(f"unsatisfied closure: {Path(txn_path).name} requires bundled {fname} (producer {e['producer']}) with no authoritative transaction in stage and not published; rebuild with current builder to emit per-producer transactions (buildpkg {e['producer']} and buildpkg {info['target']})")

novel_idents, novel_depends, novel_archs = {}, {}, {}
for txn_path in remaining:
    for e in txn_novel[txn_path]:
        out = subprocess.run([apk_bin, "adbdump", str(Path(txn_path) / e["filename"])],
                             check=True, text=True, capture_output=True).stdout
        name = version = parch = None
        for line in out.splitlines():
            if line.startswith("  name: "):
                name = line.split(": ", 1)[1].strip()
            elif line.startswith("  version: "):
                version = line.split(": ", 1)[1].strip()
            elif line.startswith("  arch: "):
                parch = line.split(": ", 1)[1].strip()
        if name and version:
            novel_idents[e["filename"]] = (name, version)
            novel_depends[e["filename"]] = dump_depends(str(Path(txn_path) / e["filename"]))
            # Arch-split repository layout: apk fetches each package
            # from <repo>/<package-arch>/. Only the build arch and
            # noarch exist on Saphira; anything else fails closed here
            # rather than landing where no client will request it.
            if parch not in (arch, "noarch"):
                die(f"unsupported package arch: {e['filename']} reports arch '{parch}' (expected '{arch}' or 'noarch')")
            novel_archs[e["filename"]] = parch

pub_versions = {}
for repo in repo_names:
    for archdir in (arch, "noarch"):
        d = repo_root / repo / archdir
