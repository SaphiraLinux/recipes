    "SELECT COUNT(*) c FROM reservations WHERE status='ACTIVE'").fetchone()["c"]
print(f"sign-apk-repo: staged gate: {len(staged)} staged package(s) checked"
      f" against {len(db_idents) - len(staged)} repository APK identities"
      f" and {active} active Unix-identity reservations:"
