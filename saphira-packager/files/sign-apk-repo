            continue
        for p in d.glob("*.apk"):
            if p.name.endswith(".apk") and "-" in p.name:
                base = p.name[:-4]
                # name-version split: version starts at last '-' before digit? Use producer-agnostic: split on '-' with version pattern.
                import re
                m = re.match(r"^(.*)-([0-9][^-]*-r[0-9]+)$", base)
                if m:
