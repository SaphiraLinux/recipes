#%PAM-1.0
# Saphira Linux fallback (saphira-pambase): deny everything unknown.
# Any service without its own file fails closed and logs via pam_warn.
# This is the safe default; it intentionally differs from systemd's
# inert factory copy (factory other = include system-auth, a template
# that must never go live unmodified). Live /etc/pam.d/other here wins.

auth      required   pam_deny.so
auth      required   pam_warn.so
account   required   pam_deny.so
account   required   pam_warn.so
password  required   pam_deny.so
password  required   pam_warn.so
session   required   pam_deny.so
session   required   pam_warn.so
