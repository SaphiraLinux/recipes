# saphira-udpdist runtime identity: user udpdist UID 152,
# primary group udpdist GID 152.
#
# 152 is allocated in package-name order from 147, the first free ID above the
# highest claimed identity (146 openldap), clear of systemd block
# (127-131, 144, 145). It is NOT the 127 this fragment originally declared:
# 127 is systemd-network (systemd/recipe.sh pins -Dsystemd-network-uid=127),
# one package owns each declared identity, and saphira-udpdist has never been
# published, so the move costs no migration and needs no legacy sidecar.
# Home /var/empty is shared infrastructure, left untouched by design.
group udpdist 152
user udpdist 152 udpdist /var/empty /sbin/nologin
