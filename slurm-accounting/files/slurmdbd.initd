#!/sbin/openrc-run

description="Slurm accounting daemon"

# slurmdbd starts as root and assumes SlurmUser (slurm) itself, so it
# must NOT be given command_user. -D -s keeps it in the foreground
# under supervise-daemon (upstream runs `slurmdbd -D -s`, not
# --systemd; the .service file mirrors that).
command="/usr/sbin/slurmdbd"
command_args="-D -s"
supervisor="supervise-daemon"
# slurmdbd cannot run without the live configuration that
# saphira-cluster generates on the target.
required_files="/etc/slurm/slurmdbd.conf"

depend()
{
	need localmount
	use net logger dns
}

start_pre()
{
	checkpath -d -m 0755 -o slurm:slurm /var/log/slurm
}
