@@ -84,6 +84,45 @@
 
 strong_alias(callerid_get_own_netinfo, slurm_callerid_get_own_netinfo);
 
+/*
+ * musl libc omits the legacy BSD inet_nsap_addr() API. Slurm uses it
+ * here only to parse plain-hex /proc/net/tcp{,6} address fields into
+ * binary, ignoring its return value, so provide a static equivalent
+ * with identical behavior on that input domain (glibc's dotted-NSAP
+ * forms cannot occur: the sscanf above only captures [0-9A-Z]).
+ * Saphira/musl port patch.
+ */
+static unsigned int
+slurm_inet_nsap_addr(const char *cp, unsigned char *buf, int len)
+{
+	unsigned int bytes = 0;
+	int hi, lo;
+
+	while (*cp != '\0' && bytes < (unsigned int)len) {
+		if (*cp >= '0' && *cp <= '9')
+			hi = *cp - '0';
+		else if (*cp >= 'a' && *cp <= 'f')
+			hi = *cp - 'a' + 10;
+		else if (*cp >= 'A' && *cp <= 'F')
+			hi = *cp - 'A' + 10;
+		else
+			break;
+		cp++;
+		if (*cp >= '0' && *cp <= '9')
+			lo = *cp - '0';
+		else if (*cp >= 'a' && *cp <= 'f')
+			lo = *cp - 'a' + 10;
+		else if (*cp >= 'A' && *cp <= 'F')
+			lo = *cp - 'A' + 10;
+		else
+			break;
+		cp++;
+		buf[bytes++] = (unsigned char)((hi << 4) | lo);
+	}
+	return bytes;
+}
