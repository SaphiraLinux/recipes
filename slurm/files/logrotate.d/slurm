# Slurm daemons hold their log files open and offer no log-reopen
# signal (SIGHUP triggers a full reconfigure, not a reopen — verified
# in src/slurmdbd/slurmdbd.c), so rotation uses copytruncate, never
# postrotate.
# Single owner: the slurm package (covers slurmctld/slurmd/sackd logs;
# slurmdbd logs to the same directory when accounting is installed).
/var/log/slurm/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
}
