[Unit]
Description=Slurm auth and cred kiosk daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=slurm
Group=slurm
# sackd's configless fetch cache defaults to /run/slurm/conf;
# RUNTIME_DIRECTORY (honored only by sackd) points it at the Saphira
# runtime root instead. The directory converges via tmpfiles.d.
Environment=RUNTIME_DIRECTORY=/var/run/sackd
ExecStart=/usr/sbin/sackd --systemd
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
LimitNOFILE=131072
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
