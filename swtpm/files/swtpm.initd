#!/sbin/openrc-run

description="Software TPM 2.0 emulator daemon (qemu TPM backend)"

# swtpm needs two directories, not one: a TPM *state* directory holding
# the emulated TPM's persistent state, and a *control* directory holding
# the control socket libvirt connects to. Both are below.
#
# swtpm --daemon forks; omitting it keeps the emulator in the foreground
# under supervise-daemon.
#
# This package configures --with-tss-user=root --with-tss-group=root, so
# swtpm runs as root and must NOT be given a User= here.
swtpm=/usr/sbin/swtpm
: ${swtpm_state_dir:=/var/lib/swtpm-state}
: ${swtpm_ctrl_dir:=/run/swtpm}

depend()
{
	need localmount
	after bootmisc
}

start_pre()
{
	checkpath -d -m 0700 -o root:root "$swtpm_state_dir"
	checkpath -d -m 0755 -o root:root "$swtpm_ctrl_dir"
}
