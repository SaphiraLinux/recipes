[Unit]
Description=System logging daemon
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/run/syslog-ng /var/lib/syslog-ng
ExecStart=/usr/sbin/syslog-ng --foreground --cfgfile=/etc/syslog-ng/syslog-ng.conf --persist-file=/var/lib/syslog-ng/syslog-ng.persist --control=/var/run/syslog-ng/syslog-ng.ctl --pidfile=/var/run/syslog-ng/syslog-ng.pid
Restart=on-failure

[Install]
WantedBy=multi-user.target
