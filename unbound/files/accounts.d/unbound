# unbound service identity.
#
# The recipe configures --with-username=unbound, so unbound(8) drops from
# root to this user and chowns its own state. Until this fragment existed
# the identity was unowned: configure proved a service account the package
# never declared, which is the same class of gap as frr and lldpd having
# identities and no way to start, only quieter.
#
# ID 108: convergent with the base seed (which has carried
# unbound:108 since before this fragment existed, and every live
# installation - Egg included - runs unbound as 108). The 64 this
# fragment previously declared was never shipped in any published
# package, so no migration exists to record; claiming it anyway
# would collide with the seed at the publish gate (proven by the
# keystone/plugdev 164 refusal, same class).
user unbound 108 unbound /var/lib/unbound /sbin/nologin
group unbound 108
dir /var/lib/unbound 0755 unbound unbound
